# Phase 1A: every value here is read at RUNTIME (apps/web/lib/runtime-config.ts) — changing one needs a restart, never a
# rebuild. The pre-Phase-1 NEXT_PUBLIC_* names (NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_API_URL, …) are still accepted.

# This installation's id — must match the API's INSTALL_ID (namespaces the Next.js data-cache tags). Optional locally.
INSTALL_ID=
SITE_URL=http://localhost:3000
# Where the BROWSER calls the API.
PUBLIC_API_URL=http://localhost:4000
# optional — where the web SERVER calls the API (Docker: http://api:4000). Defaults to PUBLIC_API_URL.
API_INTERNAL_URL=
# optional — base for uploaded media. Default /uploads (same origin; served by nginx, or proxied to the API locally).
MEDIA_BASE_URL=

# optional — without it, /api/revalidate refuses every request and product changes fall back to the
# ~60s ISR window. Server-only. Must match the API's REVALIDATE_SECRET (apps/api/.env) exactly.
REVALIDATE_SECRET=

# optional — without it, the push-notification opt-in toggle stays hidden. The PUBLIC half of the API's VAPID pair
# (same value as the API's WEB_PUSH_PUBLIC_KEY). Generate a pair with `npx web-push generate-vapid-keys`
WEB_PUSH_PUBLIC_KEY=

# optional — without it, the Google sign-in button never renders. Same value as the API's
# GOOGLE_CLIENT_ID (apps/api/.env) — this is a public client ID, not a secret.
GOOGLE_CLIENT_ID=

# optional — Meta Pixel id. Leave blank in local dev so test browsing never reaches the real pixel;
# to try it locally, set it and use Events Manager -> Test Events.
META_PIXEL_ID=

# optional — TikTok Pixel id (TikTok Ads Manager -> Tools -> Events -> Web Events). Public, not a secret. Same rule as
# Meta: leave blank in local dev so test browsing never reaches the real pixel.
TIKTOK_PIXEL_ID=

# optional — Microsoft Clarity heatmaps (loads only after the shopper accepts tracking).
CLARITY_ID=
