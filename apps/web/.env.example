NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# optional — without it, the push-notification opt-in toggle stays hidden. Must match the API's
# WEB_PUSH_PUBLIC_KEY (apps/api/.env). Generate a pair with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# optional — without it, the Google sign-in button never renders. Same value as the API's
# GOOGLE_CLIENT_ID (apps/api/.env) — this is a public client ID, not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
