generator client {
  provider        = "prisma-client-js"
  // "native" for local dev (whatever the host is); the musl target is what the node:20-alpine
  // Docker image actually runs on, and its Alpine base ships OpenSSL 3.x, not the 1.1 the
  // default musl engine binary needs.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // Global `omit` (config/prisma.ts) keeps OrderItem.unitCostSnapshot out of every read unless selected explicitly —
  // recorded cost is internal and must never reach a customer response (docs/PHASE_6_AUDIT.md G6).
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  CLOTHING
  FRAGRANCE
  ACCESSORY
  WATCH
  SHOES
  COSMETICS
  ISLAMIC_PRODUCT
  HOME
  /// Legacy mirror for admin-created types: the real type is Product.typeId -> ProductTypeDef. The enum
  /// itself can't grow at runtime, which is exactly why types moved into a table.
  CUSTOM
}

/// Where a product is in its life. Only PUBLISHED products are on the storefront; `Product.isActive` is kept
/// equal to `status === PUBLISHED` (one service function writes both) because dozens of existing queries filter on it.
enum ProductStatus {
  DRAFT
  READY
  PUBLISHED
  UNPUBLISHED
}

/// How a curated product list relates to the product it is attached to.
enum ProductRelationKind {
  RELATED
  CROSS_SELL
  UPSELL
  FREQUENTLY_BOUGHT
  RECOMMENDED
}

enum AttributeDataType {
  TEXT
  TEXTAREA
  NUMBER
  MEASUREMENT
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE
  URL
  RICH_TEXT
}

/// Whether a template's products offer a size guide, and whether it starts switched on.
enum SizeGuideMode {
  NOT_APPLICABLE
  OFF_BY_DEFAULT
  ON_BY_DEFAULT
}

enum BrandTier {
  PREMIUM
  PLATINUM
  LUXURY
}

enum AdminRole {
  OWNER
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  /// Steadfast reported "partial_delivered" — the customer accepted only some of the parcel's
  /// items and returned the rest to the courier. Distinct from DELIVERED so an admin has to
  /// reconcile which items actually came back (see Order.partialDeliveryReconciledAt /
  /// OrderItem.returnedQuantity) before stock is restored — silently folding this into DELIVERED
  /// (the old behavior) left the returned units stuck as "sold" forever.
  PARTIALLY_DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum CourierLossReason {
  /// Order was cancelled (by Steadfast or an admin) after a consignment was already booked — the
  /// courier's pickup+return round trip is a sunk cost with nothing collected in exchange.
  CANCELLED_POST_BOOKING
  /// A PARTIALLY_DELIVERED order's reconciliation found at least one returned item.
  PARTIAL_RETURN
}

enum ReturnRequestType {
  RETURN
  EXCHANGE
}

enum PaymentMethod {
  COD
  SSLCOMMERZ
  EPS_PG
}

/// A projection of the order's payment ledger (Payment + Refund rows + store credit issued from the order) — written only
/// by domain/payments/payment-ledger.service.ts (docs/PAYMENT_LEDGER.md §4). PARTIALLY_REFUNDED: Phase 4. PARTIALLY_PAID
/// (some money received, some still due) and CREDITED (everything received moved to the customer's store balance):
/// docs/ORDER_ADJUSTMENTS.md §5.
enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  PARTIALLY_PAID
  CREDITED
}

/// SSLCOMMERZ/EPS_PG: gateway settlements. COD: cash the courier collected on delivery (D1). MANUAL: an
/// out-of-band payment staff recorded (bKash/bank/cash). STORE_CREDIT: the customer's store balance spent on the order
/// (its CustomerCreditEntry debit points back at the Payment) — a tender, not new cash. COD, MANUAL and STORE_CREDIT never
/// appear on a PaymentSession.
enum PaymentProvider {
  SSLCOMMERZ
  EPS_PG
  COD
  MANUAL
  STORE_CREDIT
}

/// ACTIVE -> SUCCEEDED/FAILED (a definitive, re-verified gateway answer) or CANCELLED (customer
/// backed out on the gateway's own page) or EXPIRED (set only by the reconciliation sweep — no
/// gateway signal ever arrived within the session's window; see payment-reconciliation-cron.ts).
/// FAILED and EXPIRED are deliberately distinct: FAILED means the gateway explicitly said no,
/// EXPIRED means we simply never heard back (the customer likely closed the tab).
enum PaymentSessionStatus {
  ACTIVE
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

/// A Payment row is only ever created once a PaymentSession reaches a definitive, re-verified
/// answer — CANCELLED/EXPIRED sessions never produce one, since no charge attempt ever reached the
/// gateway's ledger for those.
enum PaymentTxnStatus {
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  REQUESTED
  COMPLETED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum CouponScope {
  ALL_PRODUCTS
  SPECIFIC_PRODUCTS
  SPECIFIC_CATEGORIES
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Why a variant's stock changed. Every change is written by inventory.service.ts, the only stock writer
/// (docs/INVENTORY_INVARIANTS.md). Older rows keep their original reason — cancellations before Phase 1 are
/// ADJUSTMENT rows carrying an orderId.
enum StockMovementReason {
  ORDER
  RESTOCK
  ADJUSTMENT
  RETURN
  CANCELLATION
  IMPORT
  DAMAGED
  LOST
}

/// The two purchase-funnel steps that have no other trace anywhere in the schema — everything
/// else in the Landing→Repeat-Purchase journey (Section 3 BI) is derivable from PageView.path or
/// Order, but variant selection and guest add-to-cart are otherwise invisible server-side.
enum FunnelEventType {
  VARIANT_SELECTED
  ADD_TO_CART
  REMOVE_FROM_CART
}

enum BannerPlacement {
  HERO_CAROUSEL
  PROMO_STRIP
}

/// HERO/PERSONALIZED_LEAD/FLASH_SALE/CATEGORY_GRID/SMART_RECOMMENDATIONS carry no editable copy of
/// their own — they draw from Banner/FlashSale/Category or are purely behavioral — so their
/// HomepageSection row exists only to control position and visibility. PRODUCT_CAROUSEL and
/// PROMO_BANNER are the only repeatable types (multiple instances allowed); every other type is a
/// singleton enforced in homepage-section.service.ts, not by the schema.
enum HomepageSectionType {
  HERO
  TRUST_STRIP
  PERSONALIZED_LEAD
  PRODUCT_CAROUSEL
  FLASH_SALE
  CATEGORY_GRID
  BRAND_STORY
  VALUES_GRID
  SMART_RECOMMENDATIONS
  PROMO_BANNER
}

model AdminUser {
  id                     String                @id @default(cuid())
  name                   String
  email                  String                @unique
  passwordHash           String
  /// Google "sub" claim, set only when this admin has signed in with Google at least once. Google
  /// sign-in never creates an AdminUser on its own — it only links onto one that an OWNER already
  /// invited by matching email, so this stays null for accounts that have never used it.
  googleId               String?               @unique
  /// Least privilege by default (P0-02): an OWNER is only ever created by naming the role explicitly — the seed's first
  /// owner, an invite an OWNER issued with role OWNER, or an OWNER promoting someone.
  role                   AdminRole             @default(STAFF)
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  statusChanges          OrderStatusHistory[]
  reviewedReturnRequests ReturnRequest[]
  sentInvites            AdminInvite[]
  deletedOrders          Order[]               @relation("OrderDeletedBy")
  stockMovements         StockMovement[]
  refundsRequested       Refund[]              @relation("RefundRequestedBy")
  refundsCompleted       Refund[]              @relation("RefundCompletedBy")
  paymentsRecorded       Payment[]             @relation("PaymentRecordedBy")
  creditEntries          CustomerCreditEntry[]
  orderModifications     OrderModification[]
  paymentLinksCreated    PaymentLink[]         @relation("PaymentLinkCreatedBy")
  paymentLinksCancelled  PaymentLink[]         @relation("PaymentLinkCancelledBy")
}

/// A pending admin account — created by an OWNER via the in-panel "invite admin" flow instead of any
/// public registration route. No AdminUser row exists until the invite is accepted with a password.
model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        AdminRole
  tokenHash   String    @unique
  invitedById String
  invitedBy   AdminUser @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

/// DB-tracked refresh tokens (rather than bare stateless JWTs) so a session can actually be revoked —
/// on logout, on rotation (the old token is marked used/replaced), and via "log out of all devices".
model RefreshToken {
  id           String    @id @default(cuid())
  adminId      String
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([adminId])
}

/// Append-only record of admin mutations — who did what, to which entity, when.
model AuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([adminId])
  @@index([createdAt])
}

/// Anonymous, aggregate-only log of real storefront searches (not every debounced keystroke) —
/// powers "Popular Searches" and search-prediction completions.
model SearchLog {
  id          String   @id @default(cuid())
  query       String
  resultCount Int
  /// Attached after the fact by a best-effort correlation beacon (see attributeSearchSession in
  /// analytics.service.ts) fired once the search-results page has rendered — not set at write
  /// time, since listStorefrontProducts (where this row is created) never receives `req` and the
  /// search-results fetch is ISR-cached, so threading a per-session id into that request would
  /// fragment the cache. Null until (if ever) attributed; older rows stay null forever.
  sessionId   String?
  visitorId   String?
  /// The catalog suggestion already shown to the shopper for this exact zero-result search (see
  /// findDidYouMean in product.service.ts) — stored at write time so "misspelled searches" don't
  /// need to recompute a trigram lookup for every historical row on every admin page load.
  suggestion  String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([query])
  @@index([sessionId])
}

model Category {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  imageUrl          String?
  imageAltText      String?
  bannerImageUrl    String?
  sortOrder         Int                @default(0)
  isActive          Boolean            @default(true)
  isFeatured        Boolean            @default(false)
  seoTitle          String?
  seoDescription    String?
  parentId          String?
  parent            Category?          @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children          Category[]         @relation("CategoryToParent")
  products          Product[]
  /// Products whose home category is elsewhere but that are also listed here (e.g. a unisex item under Men and Women).
  listedProducts    ProductCategoryListing[]
  bundleAnchors     Bundle[]           @relation("BundleAnchor")
  bundleSuggestions BundleSuggestion[] @relation("BundleSuggestionCategory")
  couponCategories  CouponCategory[]
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([parentId])
  @@index([deletedAt])
}

/// Admin-defined attribute type (e.g. "Color", "Fabric", "Pattern") used to build variant matrices.
model Attribute {
  id        String           @id @default(cuid())
  name      String           @unique
  slug      String           @unique
  sortOrder Int              @default(0)
  values    AttributeValue[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model AttributeValue {
  id           String                  @id @default(cuid())
  attributeId  String
  attribute    Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value        String
  colorHex     String?
  sortOrder    Int                     @default(0)
  variantLinks VariantAttributeValue[]
  createdAt    DateTime                @default(now())

  @@unique([attributeId, value])
  @@index([attributeId])
}

model Product {
  id                String                  @id @default(cuid())
  name              String
  slug              String                  @unique
  description       String                  @default("")
  shortDescription  String?
  sortOrder         Int                     @default(0)
  categoryId        String
  category          Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Extra categories the product is also listed in on the storefront. `categoryId` stays its one home category
  /// (breadcrumb, coupons, bundles, reports); these only widen where it can be browsed.
  alsoListedIn      ProductCategoryListing[]
  /// Deprecated mirror of typeId's legacy enum value — kept so a rollback and any stale client keep working.
  productType       ProductType             @default(CLOTHING)
  /// Real product type (admin-managed). Nullable so rows written by older code still load; the service
  /// resolves `typeId ?? ProductTypeDef.key = productType`.
  typeId            String?
  type              ProductTypeDef?         @relation(fields: [typeId], references: [id], onDelete: Restrict)
  /// Now only holds what has no attribute definition: the product's own sizeGuide and any legacy key
  /// nobody has defined. Values for defined attributes live in ProductAttributeValue.
  attributes        Json?
  attributeValues   ProductAttributeValue[]
  brand             String?
  brandTier         BrandTier               @default(PREMIUM)
  basePrice         Decimal                 @db.Decimal(10, 2)
  compareAtPrice    Decimal?                @db.Decimal(10, 2)
  costPrice         Decimal?                @db.Decimal(10, 2)
  taxRate           Decimal?                @db.Decimal(5, 2)
  trackInventory    Boolean                 @default(true)
  /// Ships free: the canonical quote waives shipping when EVERY line of the cart is a free-delivery product (one normal
  /// product → the zone fee applies). Read only when pricing; each order line snapshots it (OrderItem.freeDeliverySnapshot)
  /// so changing it never touches an existing order (docs/ORDER_ADJUSTMENTS.md §2).
  freeDelivery      Boolean                 @default(false)
  lowStockThreshold Int                     @default(5)
  restockDate       DateTime?
  isActive          Boolean                 @default(true)
  /// Defaults to PUBLISHED so rows written by code that only knows `isActive` stay live.
  status            ProductStatus           @default(PUBLISHED)
  isFeatured        Boolean                 @default(false)
  seoTitle          String?
  seoDescription    String?
  focusKeyword      String?
  /// Admin-entered search tags (YouTube-style): extra words shoppers type that the name/description don't say —
  /// e.g. "ator", "আতর" on a perfume. Stored normalized (lowercase, Bangla vowel variants unified) so storefront
  /// search matches them exactly against its expanded terms. Never shown on the storefront.
  tags              String[]                @default([])
  ogTitle           String?
  ogDescription     String?
  ogImageUrl        String?
  /// Overrides the self-referencing canonical the product page emits (e.g. when this is a variant of another listing).
  canonicalUrl      String?
  /// Care steps: a preset (falls back to the template's), or this product's own list when `careOverride` is set.
  carePresetId      String?
  carePreset        CareGuidePreset?        @relation(fields: [carePresetId], references: [id], onDelete: SetNull)
  /// string[] — the product's own care steps; wins over the preset.
  careOverride      Json?
  materials         ProductMaterial[]
  /// Per-product page-section overrides (on/off, order, title, own text) — see PageSectionFields below.
  sections          ProductSection[]
  faqs              ProductFaq[]
  /// Curated lists this product owns ("related", "cross-sell", ...), and the reverse side.
  relations         ProductRelation[]       @relation("ProductRelations")
  relatedTo         ProductRelation[]       @relation("RelatedToProducts")
  deletedAt         DateTime?
  variants          ProductVariant[]
  images            ProductImage[]
  flashSaleItems    FlashSaleItem[]
  /// Storefront read model (Phase 3) — a projection, never authoritative (docs/STOREFRONT_READ_MODEL.md).
  readModel         ProductReadModel?
  couponProducts    CouponProduct[]
  wishlistItems     WishlistItem[]
  viewLogs          ProductViewLog[]
  reviews           ProductReview[]
  /// Denormalized from ProductReview (APPROVED only) so every product listing can show a rating
  /// without an aggregate join on every request — recomputed whenever a review is approved,
  /// rejected (after having been approved), or deleted.
  avgRating         Float                   @default(0)
  reviewCount       Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([categoryId, isActive])
  @@index([deletedAt])
  @@index([typeId, status])
  @@index([status])
  @@index([carePresetId])
  @@index([tags], type: Gin)
}

/// A store-wide synonym group the admin manages (Catalog → Search synonyms): any word in `terms` also searches for
/// every other one, on top of the built-in dictionary in packages/shared/src/search-synonyms.ts. Terms are stored
/// normalized (normalizeSearchKeyword). Inactive groups are kept but ignored by search.
model SearchSynonym {
  id        String   @id @default(cuid())
  terms     String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Anonymous, aggregate-only log of storefront product-page views — same spirit as SearchLog.
/// Powers "N people viewed today"; never tied to a session or customer.
model ProductViewLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

/// Anonymous, cookie-based pageview beacon — one row per route the visitor lands on. `sessionId`
/// is a random id the storefront generates client-side and keeps for the browser session; it's
/// never tied to a customer account. `referrer`/`utm*` are captured once, at the first pageview of
/// the session, and the client re-sends that same first-touch value on every later pageview in the
/// same session — so grouping by sessionId and taking any one row gives first-touch attribution
/// without a second query. Powers traffic sources, conversion rate, bounce rate, and campaign
/// performance; joined to Order.sessionId for revenue attribution.
model PageView {
  id             String   @id @default(cuid())
  sessionId      String
  /// Persistent (1yr cookie) visitor id, distinct from `sessionId` (a browser-session cookie
  /// cleared on close) — lets BI metrics recognize the same person across visits. Nullable since
  /// rows recorded before this column existed have no value here.
  visitorId      String?
  path           String
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  userAgent      String?
  /// Filled by a second "exit" beacon (navigator.sendBeacon) fired when the visitor leaves this
  /// page — null until then, and forever null for a row whose exit beacon never arrived (tab
  /// killed, browser crash, etc.), which is expected and excluded from engagement averages.
  durationMs     Int?
  scrollDepthPct Int?
  clickCount     Int?
  /// Derived server-side from whether a valid customer session cookie rode along with the beacon —
  /// never trusted from the request body. Defaults false (guest) since most pageviews are.
  isLoggedIn     Boolean  @default(false)
  /// Primary Accept-Language tag (e.g. "en-US"), read server-side from the request header.
  language       String?
  /// geoip-lite lookup off the request IP — offline/free, so accuracy (esp. city-level) is rough,
  /// particularly for mobile-carrier IPs common in this store's market. Null on a lookup miss
  /// (private/local IPs in dev, or an address geoip-lite's bundled database doesn't cover).
  countryCode    String?
  region         String?
  city           String?
  createdAt      DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@index([visitorId])
}

/// Discrete, multiple-per-session purchase-funnel events (Section 3 BI) that PageView can't
/// represent — a shopper picks several variants before adding one to cart, so this can't be a
/// one-row-per-page model. productId/variantId are bare ids with no FK relation, same reasoning as
/// OrderItem's snapshot fields: an analytics event must survive the referenced product being
/// deleted later, and doesn't need cascade behavior.
model FunnelEvent {
  id        String          @id @default(cuid())
  sessionId String
  visitorId String?
  type      FunnelEventType
  productId String?
  variantId String?
  path      String?
  createdAt DateTime        @default(now())

  @@index([sessionId, type])
  @@index([type, createdAt])
}

/// A one-way, server-side mirror of a logged-in customer's client-side (localStorage) cart —
/// exists purely so cart abandonment can be detected and recovered from; never read back into
/// the storefront UI. Guests have no Cart row (the server can't identify/email them).
model Cart {
  id             String     @id @default(cuid())
  customerId     String     @unique
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]
  reminderSentAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

/// A customer's subscription to be emailed when a specific out-of-stock variant is restocked.
model StockAlert {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@unique([customerId, variantId])
  @@index([variantId])
}

model ProductVariant {
  id              String                  @id @default(cuid())
  productId       String
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String                  @unique
  barcode         String?
  size            String
  sizeLabel       String?
  color           String
  colorHex        String?
  price           Decimal?                @db.Decimal(10, 2)
  /// "Was" price for this variant (shown struck through when above its selling price).
  compareAtPrice  Decimal?                @db.Decimal(10, 2)
  costPrice       Decimal?                @db.Decimal(10, 2)
  stock           Int                     @default(0)
  weight          Decimal?                @db.Decimal(6, 2)
  /// An inactive variant is hidden from the storefront and refused at checkout, but keeps its order and stock history.
  isActive        Boolean                 @default(true)
  /// The variant's primary image (swatch / cart thumbnail) — always the first of its `images` when it has any.
  imageId         String?
  image           ProductImage?           @relation("VariantImage", fields: [imageId], references: [id], onDelete: SetNull)
  /// The variant's own gallery, in display order.
  images          VariantImage[]
  sortOrder       Int                     @default(0)
  attributeValues VariantAttributeValue[]
  stockMovements  StockMovement[]
  cartItems       CartItem[]
  stockAlerts     StockAlert[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([productId, size, color])
  @@index([imageId])
}

/// Join row linking a variant to one selected value per admin-defined attribute (e.g. Fabric=Cotton). Size/color stay
/// denormalized on ProductVariant itself since the storefront filters directly on those columns; this table carries
/// the extra attributes (fabric, pattern, material, ...) plus a full record of every attribute chosen, including size/color.
model VariantAttributeValue {
  id               String         @id @default(cuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@index([variantId])
}

model ProductImage {
  id            String           @id @default(cuid())
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  url           String
  altText       String?
  caption       String?
  /// Pixel size of the stored "full" rendition, recorded at upload (null for images uploaded before this existed).
  width         Int?
  height        Int?
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  variantsUsing ProductVariant[] @relation("VariantImage")
  variantLinks  VariantImage[]

  @@index([productId])
}

/// One image in one variant's gallery. A product-level image can belong to several variants (e.g. all sizes of a colour).
model VariantImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imageId   String
  image     ProductImage   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)

  @@unique([variantId, imageId])
  @@index([imageId])
}

model Customer {
  id                       String                   @id @default(cuid())
  name                     String
  /// Nullable because a guest checkout with only a phone number (very common for COD orders) still
  /// creates a Customer row — see findOrCreateGuestCustomer in customer.service.ts. Postgres allows
  /// multiple NULLs under a unique constraint, so uniqueness among real emails still holds.
  email                    String?                  @unique
  /// Set once the email-verification link is clicked, or immediately for Google/phone-OTP signups
  /// (Google verifies email ownership itself; phone-OTP accounts skip email verification entirely).
  emailVerifiedAt          DateTime?
  phone                    String?
  /// Phase 11 (BD-11.1): set only when an OTP to exactly this `phone` succeeded — the phone is then the customer's
  /// login identifier. NULL = unverified contact data (may repeat across customers). Cleared whenever `phone` changes.
  /// A partial unique index (migration phase11_customer_identity) allows at most one customer per verified phone.
  phoneVerifiedAt          DateTime?
  passwordHash             String?
  /// Google "sub" claim — set for accounts created or linked via Google sign-in. Null for
  /// email/password-only or phone-OTP-only accounts.
  googleId                 String?                  @unique
  rewardPoints             Int                      @default(0)
  /// Bumped on password reset so every refresh token issued before the reset is rejected —
  /// refresh tokens are stateless JWTs, so this is what lets a reset actually revoke a stolen one.
  tokenVersion             Int                      @default(0)
  /// Explicit consent for SMS marketing sends (Campaign channel SMS) — separate from `phone` itself,
  /// since phone is collected for account/contact purposes and isn't consent on its own.
  smsMarketingOptIn        Boolean                  @default(false)
  /// Consent for email marketing sends (Campaign channel EMAIL). Defaults to true — unlike SMS,
  /// which is opt-in from zero, existing/new customers already expect order and account emails,
  /// and marketing email was already going out to everyone before this flag existed. Every
  /// marketing send carries a one-click unsubscribe link (see lib/token-hash.ts's signPayload)
  /// that flips this to false, so the opt-out is real even though the default is opt-in.
  emailMarketingOptIn      Boolean                  @default(true)
  /// Admin-only freeform notes (never shown to the customer) — same convention as Order.adminNotes.
  adminNotes               String?
  /// Manually set by an admin from the customer drawer — not derived from any order/payment data.
  isBlocked                Boolean                  @default(false)
  /// Manually flagged by an admin (e.g. repeated COD refusals) — informational only, doesn't block checkout.
  codRisk                  Boolean                  @default(false)
  /// Cached result of Steadfast's fraud_check API for this customer's phone — refreshed on demand
  /// via the "Check delivery score" bulk action on the admin order list (checkDeliveryScoresBulk in
  /// courier.service.ts), never on a schedule, since a phone's delivery history doesn't change fast
  /// enough to warrant polling the way courier status does. Null until the first check.
  deliveryTotalParcels     Int?
  deliverySuccessParcels   Int?
  deliveryCancelledParcels Int?
  /// deliveryTotalParcels is now the lower bound of Steadfast's volume range (exact counts are no longer
  /// published); the success/cancelled counts stay null for checks made after 2026-09-27.
  /// Percentage (0-100), Steadfast's delivery_ratio. Null when there's no delivery history yet — not
  /// the same as a bad score, so the UI must not treat null as 0%.
  deliverySuccessRate      Float?
  /// From Steadfast's /fraud_check/score endpoint (the count-based one went dark 2026-09-27): cancellation
  /// percentage, the parcel-volume bucket it reports instead of an exact count (e.g. "2", "25+"), and
  /// the number of fraud reports other merchants have filed against this phone.
  deliveryCancellationRate Float?
  deliveryVolumeRange      String?
  deliveryFraudReports     Int?
  deliveryScoreCheckedAt   DateTime?
  addresses                Address[]
  orders                   Order[]
  wishlistItems            WishlistItem[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  refreshTokens            CustomerRefreshToken[]
  claims                   CustomerClaim[]
  pointsLedger             RewardPointsEntry[]
  cart                     Cart?
  stockAlerts              StockAlert[]
  returnRequests           ReturnRequest[]
  reviews                  ProductReview[]
  campaignRecipients       CampaignRecipient[]
  pushSubscriptions        PushSubscription[]
  /// Store balance ledger (docs/ORDER_ADJUSTMENTS.md §4). The balance is Σ amount — never a stored number.
  creditEntries            CustomerCreditEntry[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([phone])
}

/// The customer store-balance ledger (docs/ORDER_ADJUSTMENTS.md §4) — append-only, written only by
/// domain/credit/customer-credit.service.ts (architecture guard). Positive = credit owed to the customer, held as store
/// balance (store-use only: never withdrawn as cash, never transferred, never expires); negative = balance spent. The
/// available balance is Σ amount, computed under the Customer row lock whenever it is spent, so it can never go negative or
/// be spent twice. Every row carries a server-derived idempotency key: a retried command finds its row instead of adding
/// another.
model CustomerCreditEntry {
  id               String             @id @default(cuid())
  customerId       String
  /// Restrict: a ledger outlives nothing it records — a customer with balance history can't be hard-deleted.
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type             CustomerCreditType
  /// Signed, major units of `currency`.
  amount           Decimal            @db.Decimal(10, 2)
  currency         String             @db.VarChar(3)
  reason           String
  /// The order whose money this credit came from (issuance) or that this balance paid for (ORDER_PAYMENT). Plain column
  /// (no FK, like StockMovement.orderId): the ledger outlives a permanently deleted order.
  orderId          String?
  /// What caused it: ORDER, ORDER_MODIFICATION, RETURN_REQUEST, PAYMENT_SESSION, … and that row's id.
  sourceType       String
  sourceId         String
  /// ORDER_PAYMENT: the STORE_CREDIT Payment this spend became (set once — when a gateway checkout's reserved balance is
  /// consumed by the order it paid for).
  paymentId        String?            @unique
  idempotencyKey   String             @unique
  createdByAdminId String?
  createdByAdmin   AdminUser?         @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([sourceType, sourceId])
}

/// + CANCELLATION (a paid order cancelled), ORDER_MODIFICATION (a change lowered the total below what was paid), RETURN
/// (approved return), EXCHANGE (exchange downgrade), REFUND_TO_CREDIT (staff moved a refund due to store balance),
/// ORDER_PAYMENT_RELEASED (a gateway checkout's reserved balance given back); − ORDER_PAYMENT (balance spent on an order).
enum CustomerCreditType {
  CANCELLATION
  ORDER_MODIFICATION
  RETURN
  EXCHANGE
  REFUND_TO_CREDIT
  ORDER_PAYMENT
  ORDER_PAYMENT_RELEASED
}

/// Append-only ledger backing Customer.rewardPoints — every earn/redeem/manual adjustment is a row,
/// so the running total is always explainable rather than a single mutable counter.
model RewardPointsEntry {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int
  reason     String
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/// Phase 11 (BD-11.3): a DB-tracked customer refresh session. One login = one family (`familyId`); every refresh rotates
/// to a new row in the same family with the same fixed `expiresAt` (7 days from login, never extended). Presenting a
/// rotated or revoked token outside the short concurrency grace window revokes the whole family (reuse detection).
model CustomerRefreshToken {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  familyId      String
  tokenHash     String    @unique
  /// Customer.tokenVersion when issued — a password reset / logout-everywhere bump invalidates older tokens too.
  tokenVersion  Int
  /// false = "remember me" unchecked: the rotated cookie stays a browser-session cookie.
  persistent    Boolean   @default(true)
  expiresAt     DateTime
  rotatedAt     DateTime?
  replacedById  String?
  revokedAt     DateTime?
  /// logout | logout_all | password_change | password_reset | reuse_detected
  revokedReason String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([customerId])
  @@index([familyId])
}

/// Phase 11 (BD-11.6 a): a pending claim of an existing passwordless customer record matched by email. Registration
/// stores the chosen password hash here and emails a link; only following that link (proof of the email) attaches the
/// credential to the existing record. Never moves any record between customers.
model CustomerClaim {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  passwordHash String
  name         String
  phone        String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([customerId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/// One row per outstanding phone-login code — `attempts` caps guesses at a 6-digit code (invalidated
/// after 5 wrong tries) independent of the per-IP rate limit on the request route itself.
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String?
  fullName    String
  phone       String
  division    String
  district    String
  area        String
  addressLine String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  // At most one isDefault=true row per customer is also enforced at the DB level by a raw partial
  // unique index (see migration add_address_one_default_per_customer) — Prisma's schema DSL can't
  // express a partial/conditional unique constraint, so it isn't declared here, but it exists.

  @@index([customerId])
}

model Coupon {
  id                String           @id @default(cuid())
  code              String           @unique
  type              CouponType
  /// Nullable because FREE_SHIPPING coupons have no amount/percentage of their own.
  value             Decimal?         @db.Decimal(10, 2)
  scope             CouponScope      @default(ALL_PRODUCTS)
  minOrderAmount    Decimal?         @db.Decimal(10, 2)
  maxDiscountAmount Decimal?         @db.Decimal(10, 2)
  /// Minimum combined quantity of eligible items (all items, if scope is ALL_PRODUCTS) required to redeem.
  minQuantity       Int?
  usageLimit        Int?
  usedCount         Int              @default(0)
  /// Caps how many times a single customer (guest or account) may redeem this coupon, counted
  /// against Order.customerId — every order, guest included, resolves to a real Customer row.
  perCustomerLimit  Int?
  /// Restricts redemption to a customer's very first order.
  firstOrderOnly    Boolean          @default(false)
  /// Optional scheduled activation, paired with expiresAt for a redemption window.
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean          @default(true)
  /// Admin-only internal note — never shown to customers.
  description       String?
  products          CouponProduct[]
  categories        CouponCategory[]
  orders            Order[]
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([deletedAt])
}

/// Links a coupon to one of the specific products it discounts, when scope is SPECIFIC_PRODUCTS.
model CouponProduct {
  id        String  @id @default(cuid())
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([productId])
}

/// Links a coupon to one of the specific categories it discounts, when scope is SPECIFIC_CATEGORIES.
model CouponCategory {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([categoryId])
}

/// A category-driven cross-sell rule: buying from `anchorCategory` (e.g. Panjabi) unlocks a
/// discount once enough of the suggested accessory categories (Pajama, Ator, Cap, Tasbih, ...)
/// are also in the cart. Suggestions are categories, not specific products, so new products added
/// to those categories become suggestible without editing the bundle.
model Bundle {
  id                     String             @id @default(cuid())
  name                   String
  anchorCategoryId       String
  anchorCategory         Category           @relation("BundleAnchor", fields: [anchorCategoryId], references: [id], onDelete: Cascade)
  discountType           CouponType
  discountValue          Decimal            @db.Decimal(10, 2)
  /// How many distinct suggested categories must also be in the cart before the discount applies.
  minSuggestedCategories Int                @default(1)
  isActive               Boolean            @default(true)
  sortOrder              Int                @default(0)
  suggestions            BundleSuggestion[]
  orders                 Order[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([anchorCategoryId, isActive])
}

model BundleSuggestion {
  id         String   @id @default(cuid())
  bundleId   String
  bundle     Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation("BundleSuggestionCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@unique([bundleId, categoryId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)
  /// The storefront session (see PageView.sessionId) that placed this order, if the checkout
  /// beacon fired — links revenue back to conversion rate/traffic-source/campaign analytics.
  /// Never tied to a customer account; just the anonymous client-generated session id.
  sessionId     String?

  customerName        String
  customerEmail       String?
  customerPhone       String
  shippingDivision    String
  shippingDistrict    String
  shippingArea        String
  shippingAddressLine String

  subtotal    Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  shippingFee Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  /// Signed manual nudge to the total an admin applies during the confirmation call — negative for
  /// a goodwill/negotiated discount, positive for a surcharge (e.g. a remote-area delivery add-on) —
  /// separate from `discount` (coupon/bundle, set at checkout and never hand-edited). Folded into
  /// `total` by adjustOrderPrice in order.service.ts; blocked once a courier is booked, since
  /// Steadfast's COD amount is fixed at that point.
  priceAdjustment Decimal @default(0) @db.Decimal(10, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  bundleId       String?
  bundle         Bundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  bundleDiscount Decimal @default(0) @db.Decimal(10, 2)

  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  returnRequests         ReturnRequest[]
  /// Reverse side of ReturnRequest.exchangeOrderId — an approved EXCHANGE request creates a new,
  /// separate Order (the replacement shipment) and links back here; at most one element in
  /// practice (one exchange request produces one exchange order), kept as an array only because
  /// Prisma requires a matching relation field on both sides.
  exchangeReturnRequests ReturnRequest[]      @relation("ReturnRequestExchangeOrder")
  courierLossEvents      CourierLossEvent[]
  modifications          OrderModification[]
  paymentLinks           PaymentLink[]
  notes                  String?
  adminNotes             String?
  trackingNumber         String?
  carrier                String?
  /// @deprecated superseded by PaymentSession.gatewayTransactionRef/providerTransactionId — kept
  /// only until the follow-up migration that drops it (see PaymentSession's doc comment); nothing
  /// reads or writes these two fields any more once payment.service.ts's cutover lands.
  paymentSessionKey      String?
  /// @deprecated superseded by Payment.providerTransactionId.
  paymentTransactionId   String?
  paymentSessions        PaymentSession[]
  payments               Payment[]
  refunds                Refund[]

  /// Steadfast's internal id for the booked consignment — the key used to poll status and to
  /// match incoming webhooks back to this order. Null until "Book with Steadfast" is used.
  courierConsignmentId    String?
  /// Raw delivery_status string from Steadfast (e.g. "in_review", "delivered", "cancelled"),
  /// shown to the admin as-is; see mapSteadfastStatusToOrderStatus for how it affects `status`.
  courierStatus           String?
  courierBookedAt         DateTime?
  /// Phase 9 (D-4): booking claim — set atomically (conditional update) before the Steadfast call so two concurrent
  /// bookings can't both reach the provider; cleared when the booking is saved or definitely failed, KEPT when the
  /// outcome is unknown (timeout / 5xx) until an operator checks Steadfast or the 10-min lease lapses.
  courierBookingStartedAt DateTime?
  /// Steadfast's own trackable URL (https://steadfast.com.bd/tl/{opaque-token}) — only present in
  /// the create_order/bulk-order response body, not derivable from tracking_code and not returned
  /// by status_by_cid, so bookings made before this field existed will have it null forever.
  courierTrackingLink     String?
  /// Last time `courierStatus` was confirmed against Steadfast's API (webhook, cron sweep, or a
  /// manual/bulk sync) — null until the first successful sync. Drives the admin UI's "last synced"
  /// label and the staleness check in getOrderByIdWithAutoSync.
  courierStatusSyncedAt   DateTime?
  /// Message from the most recent failed sync attempt; cleared on the next successful one. Lets the
  /// admin UI show "sync failed" instead of silently displaying a possibly-stale courierStatus.
  courierSyncError        String?

  // ── Pricing snapshot (Phase 2, docs/PRICING_INVARIANTS.md §8). Immutable historical facts written once at order
  // creation by the canonical pricing pipeline; never recomputed from current products, promotions or settings.
  // NULL on orders placed before Phase 2 where the fact can't be reconstructed reliably (never invented).
  /// Version of the pricing pipeline that priced this order (PRICING_VERSION); null = before Phase 2.
  pricingVersion    Int?
  /// Σ (list price − flash price) × units — what flash sales took off. Null before Phase 2.
  flashDiscount     Decimal?  @db.Decimal(10, 2)
  /// The coupon's part of `discount` (the rest is `bundleDiscount`). Backfilled from discount − bundleDiscount.
  couponDiscount    Decimal?  @db.Decimal(10, 2)
  /// True when `shippingFee` was not charged (free-shipping coupon or free-over threshold). Backfilled from the
  /// order's own snapshot arithmetic; adjustOrderPrice reads this instead of the live coupon.
  shippingWaived    Boolean?
  /// Key of the ShippingZone that priced shipping. Null before Phase 2.
  shippingZoneKey   String?
  /// Tax snapshot (D3): the mode, rates and amounts in force when the order was placed. Null before Phase 2.
  taxMode           TaxMode?
  taxRate           Decimal?  @db.Decimal(5, 2)
  shippingTaxRate   Decimal?  @db.Decimal(5, 2)
  /// Net of VAT (merchandise after discounts + shipping charged).
  taxableAmount     Decimal?  @db.Decimal(10, 2)
  /// Total VAT (merchandise + shipping). Included in `total` when taxMode = INCLUSIVE, added to it when EXCLUSIVE.
  taxAmount         Decimal?  @db.Decimal(10, 2)
  shippingTaxAmount Decimal?  @db.Decimal(10, 2)
  /// D7: when a pre-shipment cancellation released this order's coupon usage (Coupon.usedCount − 1). Null = the
  /// order still counts as a redemption.
  couponReleasedAt  DateTime?
  /// Idempotency-Key the order was created with — a repeat request with the same key returns this order.
  idempotencyKey    String?   @unique
  /// Bumped every time a modification changes the order's contents, address or total. A payment link or a modification
  /// waiting for payment records the revision it was priced against and is refused once the order moved on — a stale
  /// link can never collect the wrong amount (docs/ORDER_ADJUSTMENTS.md §11).
  revision          Int       @default(0)

  /// Set once an admin has reconciled a PARTIALLY_DELIVERED order — picked which items actually
  /// came back (OrderItem.returnedQuantity) and had them restocked. Status stays
  /// PARTIALLY_DELIVERED permanently after this (it never gets rewritten to DELIVERED, since the
  /// exact amount collected on a partial delivery isn't known — see reconcilePartialDelivery in
  /// order.service.ts); this timestamp is what the admin UI uses to know reconciliation is done.
  partialDeliveryReconciledAt DateTime?

  /// When set, this order is "on hold" pending a follow-up phone call (no-answer/undecided outcome
  /// of the pre-shipping confirmation call) — `status` stays PENDING throughout; this is a separate
  /// callback-queue signal, not a status. Cleared automatically by updateOrderStatus the moment the
  /// order moves off PENDING, and set/refreshed by the "Hold — call back later" admin action.
  followUpAt   DateTime?
  /// Lifetime count of "Hold — call back later" placements on this order — a rough measure of how
  /// many confirmation-call attempts it has taken. Never reset or decremented, and doesn't gate any
  /// auto-cancel behavior.
  callAttempts Int       @default(0)

  /// Soft delete — an OWNER-only admin action (see deleteOrder in order.service.ts). Restocks the
  /// order's items and hides it from every default query, but never physically removes the row
  /// (financial/audit record). restoreOrder clears both fields but deliberately does not re-decrement
  /// stock, since that inventory may already have been resold in the meantime.
  deletedAt        DateTime?
  deletedByAdminId String?
  deletedByAdmin   AdminUser? @relation("OrderDeletedBy", fields: [deletedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt, status])
  @@index([sessionId])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([deletedAt])
  @@index([courierConsignmentId])
  @@index([followUpAt])
}

/// Append-only timeline of status transitions for an order — powers the admin timeline view.
model OrderStatusHistory {
  id               String      @id @default(cuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           OrderStatus
  note             String?
  changedByAdminId String?
  changedByAdmin   AdminUser?  @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())

  @@index([orderId])
}

/// A customer-initiated return request on a delivered order, reviewed by an admin. Approving one
/// reuses the existing order-status machinery (transitions the order to RETURNED) rather than
/// tracking a parallel status of its own — there's no payment-gateway refund API integrated, so
/// "refund status" is just the order's existing status/paymentStatus shown alongside this record.
model ReturnRequest {
  id                     String              @id @default(cuid())
  orderId                String
  order                  Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId             String
  customer               Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason                 String
  note                   String?
  /// RETURN (default) is the original refund/restock flow. EXCHANGE is a same-order size/color
  /// swap: the fields below are only populated (and only required by the Zod schema) when this is
  /// EXCHANGE — see reviewReturnRequest in return-request.service.ts for how approval branches.
  type                   ReturnRequestType   @default(RETURN)
  // EXCHANGE only, from here down. orderItemId/requestedVariantId are plain id columns with no FK
  // relation (same "no FK guarantee it still exists" reasoning as OrderItem.variantId) — the
  // Snapshot fields alongside them keep the request displayable even if the variant/product is
  // later deleted.
  orderItemId            String?
  originalSizeSnapshot   String?
  originalColorSnapshot  String?
  requestedVariantId     String?
  requestedSizeSnapshot  String?
  requestedColorSnapshot String?
  /// The free replacement Order created when an EXCHANGE request is approved — see
  /// createExchangeOrder in return-request.service.ts. Null until approved (or always, for RETURN).
  exchangeOrderId        String?
  exchangeOrder          Order?              @relation("ReturnRequestExchangeOrder", fields: [exchangeOrderId], references: [id], onDelete: SetNull)
  // At most one PENDING request per order is also enforced at the DB level by a raw partial unique
  // index (see migrations/..._return_request_one_pending_per_order) — Prisma's schema DSL can't
  // express a partial/conditional unique constraint, so it isn't declared here, but it exists.
  status                 ReturnRequestStatus @default(PENDING)
  /// Item-level return recorded by staff (docs/ORDER_ADJUSTMENTS.md §8, §11): [{ orderItemId, quantity, restocked,
  /// writtenOff, value }] — which lines came back, how many units, how many went back on the shelf, and each line's
  /// allocated value. Null for whole-order returns and exchanges.
  lines                  Json?
  /// STORE_CREDIT | REFUND | NONE — what the customer got back for this request, and how much.
  compensation           String?
  compensationAmount     Decimal?            @db.Decimal(10, 2)
  /// Idempotency-Key of the staff request that recorded an item-level return — a repeat returns this row.
  idempotencyKey         String?             @unique
  adminNote              String?
  reviewedAt             DateTime?
  reviewedByAdminId      String?
  reviewedByAdmin        AdminUser?          @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
}

/// One row per payment attempt. An order can have several over time (a failed/cancelled/expired
/// attempt followed by a retry) — this is what makes retryPayment (order.service.ts) possible at
/// all, unlike the single paymentSessionKey field this supersedes. `gatewayTransactionRef` is OUR
/// id for the attempt (a fresh cuid, NEVER the orderNumber), sent to the gateway as tran_id
/// (SSLCommerz) / merchantTransactionId (EPS) and carried back on every callback — callbacks now
/// look up a session by this ref, not by orderNumber, since an orderNumber can map to several.
/// `providerTransactionId` is the gateway's OWN id for the session (SSLCommerz sessionkey / EPS's
/// InitializeEPS TransactionId) — informational only, never used as a lookup key.
///
/// At most one ACTIVE session per order is enforced at the DB level by a raw partial unique index
/// (see migrations/..._add_payment_sessions) — Prisma's schema DSL can't express a partial/
/// conditional unique constraint, so it isn't declared here, but it exists. Same pattern as
/// ReturnRequest's one-PENDING-per-order index above. Doesn't constrain orderId: NULL sessions
/// (a storefront checkout that hasn't settled into an Order yet, see checkoutPayload) — Postgres
/// never treats two NULLs as a collision, so several such attempts can be ACTIVE at once; the
/// constraint only bites once a session is actually tied to a real order.
model PaymentSession {
  id                    String               @id @default(cuid())
  /// Null until settlement for a storefront digital-payment checkout — see checkoutPayload.
  /// Always set immediately for a session started against an order that already exists
  /// (retryPayment, admin-created orders).
  orderId               String?
  order                 Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  status                PaymentSessionStatus @default(ACTIVE)
  gatewayTransactionRef String               @unique
  providerTransactionId String?
  gatewayUrl            String?
  /// A snapshot of the CheckoutInput (plus the resolved customerId) taken when a storefront
  /// digital-payment checkout starts this session with no Order yet — settlePaymentSession uses
  /// it to materialize the real Order only once the gateway confirms success. Null for a session
  /// started against an order that already exists (retryPayment, admin-created orders).
  checkoutPayload       Json?
  /// Idempotency-Key of the checkout that started this session — a repeat returns this session's gateway URL.
  idempotencyKey        String?              @unique
  /// What the gateway was asked to collect for this attempt (the balance due, a modification's difference, a link's
  /// amount — never the browser's number). Settlement verifies the gateway's amount against THIS, so a session started
  /// before the order changed still settles exactly what it charged. Null = sessions from before this column: the order
  /// total (or the checkout payload's) is the expected amount, as before.
  amount                Decimal?             @db.Decimal(10, 2)
  paymentLinkId         String?
  paymentLink           PaymentLink?         @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)
  /// A modification waiting for its price difference: a verified success applies it in the settlement's transaction.
  orderModificationId   String?
  orderModification     OrderModification?   @relation(fields: [orderModificationId], references: [id], onDelete: SetNull)
  /// 48h out from creation — the same lookback bound the EPS reconciliation sweep already used
  /// before this table existed. The sweep flips any still-ACTIVE session past this to EXPIRED so it
  /// stops being polled and stops blocking a retry.
  expiresAt             DateTime
  payment               Payment?
  events                PaymentEvent[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([orderId])
  @@index([status, provider, createdAt])
  @@index([paymentLinkId])
}

/// The settlement record for one PaymentSession — created only once the gateway has given a
/// definitive, re-verified answer (see PaymentTxnStatus). At most one per session
/// (`paymentSessionId` unique): a session settles exactly once. `verifiedAmount` always comes from
/// the gateway's own re-verify response, never a client-supplied value — the same anti-replay
/// guarantee the old direct Order.total comparison provided. `rawResponse` is a full JSON snapshot
/// of the verify/validate call, kept as an audit trail independent of whatever fields above project
/// out of it.
model Payment {
  id                    String           @id @default(cuid())
  /// Null for a FAILED settlement of a storefront digital-payment checkout — no Order is ever
  /// created for a failed/cancelled attempt, so this row (not an Order) is the payment log.
  orderId               String?
  order                 Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Null for a settlement with no gateway session — COD collected on delivery, or a MANUAL payment (Phase 4).
  paymentSessionId      String?          @unique
  paymentSession        PaymentSession?  @relation(fields: [paymentSessionId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  status                PaymentTxnStatus
  amount                Decimal          @db.Decimal(10, 2)
  verifiedAmount        Decimal?         @db.Decimal(10, 2)
  /// SSLCommerz bank_tran_id (falls back to val_id) / EPS EpsTransactionId.
  providerTransactionId String?
  rawResponse           Json?
  /// Free-text context: how a manual payment was made ("bKash 01…"), or why a backfilled row exists.
  note                  String?
  recordedByAdminId     String?
  recordedByAdmin       AdminUser?       @relation("PaymentRecordedBy", fields: [recordedByAdminId], references: [id], onDelete: SetNull)
  /// Idempotency-Key of the admin request that recorded a manual payment — a repeat returns this row.
  idempotencyKey        String?          @unique
  /// True for rows the Phase 4 backfill inserted from an order's own recorded status (docs/PAYMENT_LEDGER.md §11).
  backfilled            Boolean          @default(false)
  settledAt             DateTime         @default(now())
  refunds               Refund[]
  createdAt             DateTime         @default(now())

  @@index([orderId])
}

/// Append-only timeline of one payment attempt (INITIATED, VERIFIED_SUCCESS, VERIFIED_FAILED,
/// CANCELLED, EXPIRED, ...) — same template as OrderStatusHistory (no updatedAt, one index on the
/// parent FK), but scoped to a PaymentSession rather than an Order, since one order's full payment
/// history can now span several attempts.
model PaymentEvent {
  id               String         @id @default(cuid())
  paymentSessionId String
  paymentSession   PaymentSession @relation(fields: [paymentSessionId], references: [id], onDelete: Cascade)
  type             String
  note             String?
  rawResponse      Json?
  createdAt        DateTime       @default(now())

  @@index([paymentSessionId])
}

/// A manual, out-of-band refund record — neither SSLCommerz nor EPS expose a refund API (see the
/// comment above ReturnRequest), so an admin transfers money back themselves (bKash/bank/cash) and
/// logs it here. This table is the record of what happened, not a trigger. REQUESTED = owed (a D6
/// exchange downgrade), COMPLETED = paid out; the only mutation is REQUESTED → COMPLETED. Written only by
/// domain/payments/payment-ledger.service.ts, which derives Order.paymentStatus from these rows and the
/// Payment rows (docs/PAYMENT_LEDGER.md).
model Refund {
  id                 String       @id @default(cuid())
  orderId            String
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId          String?
  payment            Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount             Decimal      @db.Decimal(10, 2)
  reason             String?
  /// How the money was actually sent back — "bKash", "Bank transfer", "Cash", ... — free text, no
  /// enum, since the set of real-world methods isn't fixed and this is informational only.
  method             String?
  status             RefundStatus @default(REQUESTED)
  requestedByAdminId String?
  requestedByAdmin   AdminUser?   @relation("RefundRequestedBy", fields: [requestedByAdminId], references: [id], onDelete: SetNull)
  completedByAdminId String?
  completedByAdmin   AdminUser?   @relation("RefundCompletedBy", fields: [completedByAdminId], references: [id], onDelete: SetNull)
  /// Idempotency-Key of the admin request that recorded this refund — a repeat returns this row.
  idempotencyKey     String?      @unique
  completedAt        DateTime?
  createdAt          DateTime     @default(now())

  @@index([orderId])
}

/// One change to an order's contents/address after it was placed (docs/ORDER_ADJUSTMENTS.md §3) — the audit record of
/// what the order looked like before, what it became, and what that did to the money. APPLIED changes are history;
/// AWAITING_PAYMENT holds a priced plan that takes effect only when its difference is paid (applied inside the payment's
/// settlement transaction); SUPERSEDED/CANCELLED/EXPIRED plans never touched the order.
model OrderModification {
  id              String                  @id @default(cuid())
  orderId         String
  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 … per order.
  sequence        Int
  status          OrderModificationStatus
  initiatedBy     OrderEditorType
  customerId      String?
  adminId         String?
  admin           AdminUser?              @relation(fields: [adminId], references: [id], onDelete: SetNull)
  reason          String?
  /// The order revision the plan was priced against; applying needs the order still at it.
  baseRevision    Int
  /// { items, totals, address } before the change.
  before          Json
  /// The priced plan: line snapshots, totals, coupon outcome, address.
  plan            Json
  previousTotal   Decimal                 @db.Decimal(10, 2)
  newTotal        Decimal                 @db.Decimal(10, 2)
  /// What had to be paid before an online-paid order's change could take effect.
  amountDue       Decimal                 @default(0) @db.Decimal(10, 2)
  /// What went to the customer's store balance when it was applied.
  amountCredited  Decimal                 @default(0) @db.Decimal(10, 2)
  idempotencyKey  String?                 @unique
  expiresAt       DateTime?
  appliedAt       DateTime?
  statusReason    String?
  paymentSessions PaymentSession[]
  paymentLinks    PaymentLink[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([orderId, sequence])
  @@index([orderId, status])
}

enum OrderModificationStatus {
  APPLIED
  AWAITING_PAYMENT
  SUPERSEDED
  CANCELLED
  EXPIRED
}

enum OrderEditorType {
  CUSTOMER
  ADMIN
}

/// A secure, shareable request for the customer to pay what is due on an order (docs/ORDER_ADJUSTMENTS.md §11). The link
/// is a capability: a 256-bit random token, stored only as a SHA-256 hash (lookup) and AES-GCM ciphertext (so staff can
/// copy or re-send it). It never creates a Payment — only a verified gateway settlement does, through the payment ledger.
/// At most one ACTIVE link per order (raw partial unique index). The link is tied to the order revision and amount it was
/// generated for; once the order changes it can no longer be paid.
model PaymentLink {
  id                  String             @id @default(cuid())
  tokenHash           String             @unique
  tokenCiphertext     String
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purpose             PaymentLinkPurpose
  orderModificationId String?
  orderModification   OrderModification? @relation(fields: [orderModificationId], references: [id], onDelete: SetNull)
  amount              Decimal            @db.Decimal(10, 2)
  currency            String             @db.VarChar(3)
  orderRevision       Int
  status              PaymentLinkStatus  @default(ACTIVE)
  statusReason        String?
  expiresAt           DateTime
  usedAt              DateTime?
  cancelledAt         DateTime?
  createdByAdminId    String?
  createdByAdmin      AdminUser?         @relation("PaymentLinkCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  cancelledByAdminId  String?
  cancelledByAdmin    AdminUser?         @relation("PaymentLinkCancelledBy", fields: [cancelledByAdminId], references: [id], onDelete: SetNull)
  paymentSessions     PaymentSession[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([orderId, status])
}

enum PaymentLinkStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum PaymentLinkPurpose {
  ORDER_BALANCE
  MODIFICATION
}

/// A customer-submitted star rating + write-up for a product. Starts PENDING and only counts
/// toward Product.avgRating/reviewCount once an admin approves it — unmoderated reviews never
/// reach the storefront. `customerName` is a display-name snapshot (survives a later name change);
/// `isVerifiedPurchase` is computed once at submission from real DELIVERED-order history.
model ProductReview {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName       String
  rating             Int
  title              String?
  body               String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // One review per customer per product — resubmitting means editing, not stacking duplicates.
  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([status])
}

model OrderItem {
  id                      String   @id @default(cuid())
  orderId                 String
  order                   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId               String
  productNameSnapshot     String
  skuSnapshot             String
  sizeSnapshot            String
  colorSnapshot           String
  priceSnapshot           Decimal  @db.Decimal(10, 2)
  quantity                Int
  /// How many units of this line were reconciled as "came back to us" on a PARTIALLY_DELIVERED
  /// order (see Order.partialDeliveryReconciledAt) — 0 means either not yet reconciled or the
  /// customer kept the full quantity. Set once by reconcilePartialDelivery in order.service.ts,
  /// which also restocks exactly this many units via a matching StockMovement.
  returnedQuantity        Int      @default(0)
  /// How many units of this line have been put back into stock by any path — cancellation, return,
  /// partial-delivery reconciliation, exchange, or moving the order to Trash. Releasing stock for a line
  /// never exceeds `quantity - restockedQuantity`, which is what makes every restock path idempotent
  /// (docs/INVENTORY_INVARIANTS.md). Only inventory.service.ts writes it.
  restockedQuantity       Int      @default(0)
  /// Pricing snapshot (Phase 2). A line has ONE unit price: a cart line that is partly flash-priced (D4 stockLimit)
  /// is stored as two OrderItem rows. Null before Phase 2.
  /// The regular (pre-flash) unit price: the variant's own price, else the product base price.
  listPriceSnapshot       Decimal? @db.Decimal(10, 2)
  /// The flash sale that priced these units (snapshot ids, no FK — history outlives the sale). Null = regular price.
  flashSaleId             String?
  flashSaleItemId         String?
  /// This line's share of the order's bundle / coupon discount (proportional allocation, sums to the order amount).
  bundleDiscountAllocated Decimal? @db.Decimal(10, 2)
  couponDiscountAllocated Decimal? @db.Decimal(10, 2)
  /// Historical facts (Phase 6, docs/PHASE_6_AUDIT.md) — captured once, in the transaction that writes this line
  /// (order creation or exchange-replacement creation), never updated. No FKs: history outlives the catalog.
  /// Per-unit cost in MINOR units of the store currency (StoreSetting.currency, locked once orders exist):
  /// variant.costPrice ?? product.costPrice at order time. NULL = unknown (no cost configured, or before Phase 6) —
  /// never 0 by default. Omitted from every Prisma read unless selected (config/prisma.ts).
  unitCostSnapshot        Int?
  /// The variant's product (backfilled for older lines from ProductVariant.productId — a variant never changes product).
  productIdSnapshot       String?
  /// The product's category and its name at order time. NULL = not recorded (line predates Phase 6); every product has
  /// a category, so a recorded line always has categoryIdSnapshot.
  categoryIdSnapshot      String?
  categoryNameSnapshot    String?
  /// Product.brand at order time (free text; no brand id exists). NULL with categoryIdSnapshot set = unbranded.
  brandSnapshot           String?
  /// Product.freeDelivery when this line was priced. NULL = before the flag existed (treated as false). A modification
  /// keeps a kept line's own value, so a product's later change never reaches this order.
  freeDeliverySnapshot    Boolean?

  @@index([orderId])
  @@index([flashSaleItemId])
}

model StockMovement {
  id        String              @id @default(cuid())
  variantId String
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Int
  reason    StockMovementReason
  orderId   String?
  adminId   String?
  admin     AdminUser?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime            @default(now())

  @@index([variantId])
  @@index([reason])
}

/// A ledger entry for money the store loses to courier round-trips it can't recover — logged
/// automatically by updateOrderStatus (CANCELLED after a consignment was booked) and
/// reconcilePartialDelivery (a partial-delivery return) in order.service.ts. `amount` is an
/// admin-configured estimate (StoreSetting.courierReturnFeeDhaka/OutsideDhaka, zone-matched to
/// the order's shippingDivision) rather than a real figure from Steadfast — their API exposes no
/// per-order fee, only a merchant wallet balance (see lib/steadfast.ts).
model CourierLossEvent {
  id        String            @id @default(cuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal           @db.Decimal(10, 2)
  reason    CourierLossReason
  createdAt DateTime          @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model FlashSale {
  id             String          @id @default(cuid())
  name           String
  startsAt       DateTime
  endsAt         DateTime
  /// The admin's switch. A disabled sale is never live, whatever its window; the scheduler never changes this.
  enabled        Boolean         @default(true)
  /// Derived cache of "live right now" = enabled && startsAt <= now <= endsAt, written only by
  /// flash-sale.service.ts (on every admin write, and by the scheduler each minute). Never set it by hand.
  isActive       Boolean         @default(false)
  bannerImageUrl String?
  items          FlashSaleItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model FlashSaleItem {
  id            String     @id @default(cuid())
  flashSaleId   String
  flashSale     FlashSale  @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountType  CouponType
  discountValue Decimal    @db.Decimal(10, 2)
  stockLimit    Int?
  createdAt     DateTime   @default(now())

  @@unique([flashSaleId, productId])
  @@index([productId])
}

model Banner {
  id             String          @id @default(cuid())
  placement      BannerPlacement @default(HERO_CAROUSEL)
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  title          String?
  subtitle       String?
  /// Image alt text, independent of `title` — a banner can be purely visual (no title/subtitle
  /// copy shown on top of it) yet still needs a real description for accessibility/image search;
  /// falls back to `title` on the frontend when left blank.
  altText        String?
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([placement, isActive])
}

/// Ordered list of blocks rendered on the storefront homepage — lets the admin builder reorder,
/// toggle, and configure sections without a code change. `config` shape depends on `type`; validated
/// in packages/shared/src/schemas/homepage-section.ts, not by Prisma. See HomepageSectionType for
/// which types are singletons vs repeatable.
model HomepageSection {
  id        String              @id @default(cuid())
  type      HomepageSectionType
  sortOrder Int                 @default(0)
  isActive  Boolean             @default(true)
  config    Json                @default("{}")
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([isActive, sortOrder])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Submitted from the storefront's floating contact widget. Public/anonymous like
// NewsletterSubscriber (no customer/order relation) — readAt follows the same "null = unread"
// convention as Notification instead of a status enum.
model Feedback {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
}

model WishlistItem {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Product's basePrice at the moment it was wishlisted — the baseline a real price drop is measured against.
  priceAtAdd Decimal?  @db.Decimal(10, 2)
  /// Set once a price-drop email has been sent for this entry, so it's never re-sent for the same drop.
  alertedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

/// System-generated admin alerts (new order, low stock, ...) shown via the bell icon in the admin
/// topbar — distinct from the per-action toasts, which are immediate feedback on the action you just took.
model Notification {
  id        String    @id @default(cuid())
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
}

/// Single-row store configuration — always read/written via id "singleton". Fields not yet wired
/// into a live consumer are documented at the call site, not silently unused.
model StoreSetting {
  id                           String   @id @default("singleton")
  storeName                    String   @default("Store")
  tagline                      String?
  logoUrl                      String?
  logoOnDarkUrl                String?
  faviconUrl                   String?
  currency                     String   @default("BDT")
  /// IANA timezone of the store's business day (metrics, "today", reports) — docs/METRICS_REGISTRY.md §1. Phase 5.
  timezone                     String   @default("Asia/Dhaka")
  contactEmail                 String?
  contactPhone                 String?
  shippingFeeDhaka             Decimal  @default(60) @db.Decimal(10, 2)
  shippingFeeOutsideDhaka      Decimal  @default(120) @db.Decimal(10, 2)
  /// Estimated round-trip courier fee lost on a post-booking cancellation or partial-delivery
  /// return, zone-matched the same way as shippingFeeDhaka/OutsideDhaka above — Steadfast's API
  /// never exposes a real per-order fee (see lib/steadfast.ts), so this is an admin-entered
  /// estimate (their actual return-fee rate) used only to total up CourierLossEvent rows for the
  /// dashboard's "courier cancellation loss" figure, not billed or charged anywhere.
  courierReturnFeeDhaka        Decimal  @default(60) @db.Decimal(10, 2)
  courierReturnFeeOutsideDhaka Decimal  @default(120) @db.Decimal(10, 2)
  taxEnabled                   Boolean  @default(false)
  defaultTaxRate               Decimal? @db.Decimal(5, 2)
  rewardPointsPerCurrency      Decimal  @default(0) @db.Decimal(10, 4)
  /// Prefill text appended to the active WHATSAPP SocialLink's URL as a `text` query param — the
  /// number/enable-state itself stays sourced from SocialLink (see comment above SocialLink) so
  /// there's exactly one place admins manage the WhatsApp destination.
  whatsappMessage              String?
  whatsappLabel                String   @default("WhatsApp")
  callEnabled                  Boolean  @default(false)
  callLabel                    String   @default("Call Us")
  /// Live Chat: Tawk.to. Kept DB-driven (unlike the old NEXT_PUBLIC_TAWKTO_* env vars) so it can be
  /// toggled without a rebuild; see apps/web/components/storefront/live-chat-widget.tsx.
  liveChatEnabled              Boolean  @default(false)
  liveChatLabel                String   @default("Live Chat")
  tawkPropertyId               String?
  tawkWidgetId                 String?
  /// A single combined "we accept" graphic (all payment logos already laid out in one image) as an
  /// alternative to managing individual PaymentMethodOption rows — when set, the footer/checkout
  /// show this instead of the per-method list, since some admins would rather upload one banner
  /// than add each logo separately.
  paymentMethodsImageUrl       String?
  /// Per-method checkout toggles — lets the store owner turn Cash on Delivery or the online gateway
  /// off entirely (e.g. during a COD abuse spike, or while SSLCommerz credentials are being rotated)
  /// without touching code. Both default on; enforced both in the checkout UI and server-side in
  /// order.service.ts so a stale page can't submit a disabled method.
  codEnabled                   Boolean  @default(true)
  onlinePaymentEnabled         Boolean  @default(true)
  /// Gates the EPS-PG checkout option, kept separate from onlinePaymentEnabled (which gates
  /// SSLCommerz) so either gateway can be toggled independently — e.g. turning EPS off while its
  /// credentials are being rotated without touching SSLCommerz or COD. Defaults off since it stays
  /// unusable until EPS sandbox/live credentials are entered via the EPS_* env vars.
  epsPaymentEnabled            Boolean  @default(false)
  /// The content= value Google Search Console gives you for the HTML-tag verification method —
  /// pasted here and rendered as a <meta name="google-site-verification"> tag on every page,
  /// rather than requiring a file upload or DNS change to prove domain ownership.
  googleSiteVerification       String?
  /// Phase 12 (D-1/D-2): the rest of the store's identity, owned here like name/logo/contact (Phase 7 — StoreSetting is
  /// the identity owner; there is deliberately no separate StoreProfile). All optional; the storefront renders each
  /// only when set. Domain/URLs stay deployment configuration (env), never here (D-3).
  legalName                    String?
  addressLine                  String?
  addressCity                  String?
  addressRegion                String?
  addressPostalCode            String?
  /// ISO 3166-1 alpha-2 (e.g. "BD").
  addressCountry               String?
  /// Governing-law jurisdiction named on the Terms page (e.g. "Bangladesh").
  legalJurisdiction            String?
  supportHours                 String?
  /// Store policy (Phase 5) — read through @clothing-brand/shared store-policy.ts by the product page, the Shipping &
  /// Returns page, the FAQ and the Product structured data. Null = the store makes no such claim.
  /// Days a customer has to return or exchange an item (null: no return window is stated).
  returnWindowDays             Int?
  /// What a returned item must be, as a sentence subject: "Unworn items in original condition with tags attached".
  returnConditions             String?
  /// Business days between an order and its dispatch.
  handlingDaysMin              Int?
  handlingDaysMax              Int?
  updatedAt                    DateTime @updatedAt
}

/// Admin-only SMS notification config — kept separate from StoreSetting because settingsRouter's
/// GET / is public (the storefront reads it directly) and adminAlertPhones must never be exposed
/// through that endpoint. Same lazy-create singleton pattern as StoreSetting.
model SmsNotificationSetting {
  id                                   String   @id @default("singleton")
  /// Comma-separated local "01XXXXXXXXX" numbers — a shop owner may want alerts on more than one
  /// phone, so this stays one column rather than a related table (same simplicity level as other
  /// single-purpose fields on StoreSetting).
  adminAlertPhones                     String   @default("")
  adminOrderAlertEnabled               Boolean  @default(true)
  customerOrderPlacedEnabled           Boolean  @default(true)
  customerOrderConfirmedEnabled        Boolean  @default(true)
  customerOrderShippedEnabled          Boolean  @default(true)
  customerOrderDeliveredEnabled        Boolean  @default(true)
  customerOrderCancelledEnabled        Boolean  @default(true)
  /// Separate from the SMS toggles above (this one gates an email, not an SMS) but kept on this
  /// same admin-only settings row rather than the public StoreSetting — same non-public reasoning
  /// as adminAlertPhones. Fires from settlePaymentSession's success branch (payment.service.ts),
  /// gated on both this flag and Order.customerEmail being present.
  customerPaymentConfirmedEmailEnabled Boolean  @default(true)
  /// Admin-editable message text, with {customerName}/{orderNumber}/{total}/{storeName}
  /// placeholders — null means "use the built-in default" (packages/shared/src/sms-templates.ts),
  /// not "send nothing" (that's what the matching *Enabled toggle above is for).
  customerOrderPlacedTemplate          String?
  customerOrderConfirmedTemplate       String?
  customerOrderShippedTemplate         String?
  customerOrderDeliveredTemplate       String?
  customerOrderCancelledTemplate       String?
  updatedAt                            DateTime @updatedAt
}

/// Reusable marketing SMS templates (Welcome, Eid Offer, ...) an admin picks from when messaging a
/// customer individually or in bulk (see customer.service.ts's sendAdHocSmsToCustomer /
/// sendBulkSmsToCustomers). Uses {{variable}} placeholders (packages/shared/src/customer-sms-templates.ts)
/// — a different vocabulary/syntax from SmsNotificationSetting's {placeholder} order-touchpoint
/// templates above, since these are customer-level (name/spend/last order), not order-level.
model SmsTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Admin-managed payment method badges (bKash, Nagad, Visa, ...) shown in the footer and at
/// checkout. Logo images are uploaded via processPaymentMethodLogo, same pattern as
/// Category.imageUrl / StoreSetting.logoUrl (plain URL string, no separate media table). Named
/// "...Option" (not just "PaymentMethod") since that name is already taken by the COD/SSLCOMMERZ
/// enum used on Order.paymentMethod.
model PaymentMethodOption {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TIKTOK
  LINKEDIN
  X
  WHATSAPP
  OTHER
}

/// Admin-managed social links shown as icons in the storefront footer — replaces the old fixed
/// facebookUrl/instagramUrl/whatsappNumber columns on StoreSetting so any number of platforms
/// (including a free-form OTHER entry) can be added, reordered, or removed without a migration.
model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  url       String
  /// Display label — required when platform is OTHER (no built-in icon/name to fall back to).
  label     String?
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([isActive, sortOrder])
}

/// Admin-managed URL redirect (e.g. after a product/category slug change) — exact-path match only,
/// no wildcard/regex rules. Enforced in apps/web/middleware.ts against the public /active endpoint.
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

enum CampaignChannel {
  EMAIL
  SMS
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

/// A saved audience filter (e.g. "no order in 30 days", "has ordered at least once") that a
/// Campaign targets. `filter` is interpreted by the campaign service rather than modeled as
/// columns, so new filter types don't require a migration.
model Segment {
  id        String     @id @default(cuid())
  name      String
  filter    Json
  campaigns Campaign[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// A one-off or scheduled send (email/SMS/push) to a Segment. Delivery to each recipient is
/// tracked as its own CampaignRecipient row rather than a single campaign-level status, so a
/// partial failure is visible per-customer and retryable without resending to everyone.
model Campaign {
  id          String              @id @default(cuid())
  name        String
  channel     CampaignChannel
  status      CampaignStatus      @default(DRAFT)
  subject     String?
  body        String
  segmentId   String?
  segment     Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  CampaignRecipient[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, scheduledAt])
}

model CampaignRecipient {
  id           String                  @id @default(cuid())
  campaignId   String
  campaign     Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status       CampaignRecipientStatus @default(PENDING)
  sentAt       DateTime?
  error        String?
  /// The actual per-recipient text sent, after {{variable}} substitution (see
  /// customer-sms-templates.ts) — null for real Campaign sends, whose body has no per-customer
  /// variables yet. Falls back to campaign.body when absent (see getCustomerDetailAdmin's smsHistory).
  renderedBody String?
  createdAt    DateTime                @default(now())

  @@unique([campaignId, customerId])
  @@index([customerId])
}

/// A customer's registered browser for Web Push. `p256dh`/`auth` are the subscription's
/// encryption keys, as returned by PushManager.subscribe() in the browser.
model PushSubscription {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

enum TaxMode {
  INCLUSIVE
  EXCLUSIVE
}

/// The centralised tax configuration (D3, D10) — the one authority the tax engine reads. Singleton "singleton".
/// StoreSetting.taxEnabled/defaultTaxRate are legacy mirrors kept in sync by settings.service (dual-write) until the
/// contract phase; nothing prices from them.
model TaxSetting {
  id              String   @id @default("singleton")
  enabled         Boolean  @default(false)
  mode            TaxMode  @default(INCLUSIVE)
  /// Store VAT rate in percent.
  defaultRate     Decimal? @db.Decimal(5, 2)
  /// D10: shipping carries VAT (inclusive by default, at the store rate unless shippingRate is set).
  shippingTaxable Boolean  @default(true)
  shippingRate    Decimal? @db.Decimal(5, 2)
  updatedAt       DateTime @updatedAt
}

enum ShippingZoneMatchField {
  POSTCODE
  DISTRICT
  DIVISION
}

/// A delivery zone (Phase 2 — replaces the hard-coded "Dhaka district vs. elsewhere" rule). Resolution: the matching
/// active zone with the highest priority, then the most specific match rule; else the default zone.
model ShippingZone {
  id        String              @id @default(cuid())
  key       String              @unique
  name      String
  priority  Int                 @default(0)
  isDefault Boolean             @default(false)
  isActive  Boolean             @default(true)
  matches   ShippingZoneMatch[]
  rate      ShippingRate?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model ShippingZoneMatch {
  id     String                 @id @default(cuid())
  zoneId String
  zone   ShippingZone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  field  ShippingZoneMatchField
  value  String

  @@unique([zoneId, field, value])
  @@index([field, value])
}

/// The authoritative shipping fee of a zone. StoreSetting.shippingFeeDhaka/OutsideDhaka are legacy mirrors of the two
/// seeded zones, dual-written by settings.service until the contract phase.
model ShippingRate {
  id             String       @id @default(cuid())
  zoneId         String       @unique
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  fee            Decimal      @db.Decimal(10, 2)
  /// Free shipping when merchandise after discounts reaches this amount; null = never.
  freeOverAmount Decimal?     @db.Decimal(10, 2)
  updatedAt      DateTime     @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog configuration: product types, templates, attribute definitions, presets.
// Everything below is admin-editable data — adding a product type needs no code change.
// (`Attribute`/`AttributeValue` above are the *variant option* system — Color, Fabric — and are unrelated.)
// ─────────────────────────────────────────────────────────────────────────────

/// A kind of product ("Panjabi", "Watch"). Identity and grouping only — the fields, size guide and variant
/// dimensions come from its template, so several types can share one.
model ProductTypeDef {
  id          String           @id @default(cuid())
  /// Stable machine key. System types use their legacy enum value ("CLOTHING"); admin-created ones a slug.
  key         String           @unique
  name        String
  description String?
  /// Optional family ("Apparel" -> "Panjabi"); purely organisational.
  parentId    String?
  parent      ProductTypeDef?  @relation("ProductTypeFamily", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductTypeDef[] @relation("ProductTypeFamily")
  templateId  String
  template    ProductTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// Value mirrored into Product.productType (CUSTOM for admin-created types).
  legacyType  ProductType      @default(CUSTOM)
  /// Seeded from the original hard-coded list. Can be edited or archived, never deleted.
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  /// Short code used by the SKU generator's {TYPE} token ("PNJ"). Falls back to the first letters of the name.
  skuCode     String?
  products    Product[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([templateId])
  @@index([parentId])
}

/// The reusable bundle of configuration a type points at: which attributes it collects, how variants are
/// dimensioned, and which size guide it uses.
model ProductTemplate {
  id                String              @id @default(cuid())
  name              String              @unique
  description       String?
  /// At most two entries — [{ targetField: "size" | "color", label, options[] }]. They map onto the
  /// denormalised ProductVariant.size / .color columns that carts, orders and storefront filters read.
  variantDimensions Json                @default("[]")
  sizeGuideMode     SizeGuideMode       @default(NOT_APPLICABLE)
  sizeGuidePresetId String?
  sizeGuidePreset   SizeGuidePreset?    @relation(fields: [sizeGuidePresetId], references: [id], onDelete: SetNull)
  /// Default care steps for products of this template (a product can pick another preset or write its own).
  carePresetId      String?
  carePreset        CareGuidePreset?    @relation(fields: [carePresetId], references: [id], onDelete: SetNull)
  /// Completeness check keys that must pass before a product of this template can be READY/PUBLISHED, on top of
  /// the always-required basics (see COMPLETENESS_CHECKS in packages/shared).
  requiredChecks    String[]            @default([])
  isArchived        Boolean             @default(false)
  attributes        TemplateAttribute[]
  sections          TemplateSection[]
  types             ProductTypeDef[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([sizeGuidePresetId])
  @@index([carePresetId])
}

/// A reusable product field ("Embroidery Type", "Movement").
model AttributeDefinition {
  id          String                      @id @default(cuid())
  /// The key values are stored and served under (`attributes.embroideryType`). Immutable once created.
  key         String                      @unique
  label       String
  dataType    AttributeDataType
  /// Shown next to MEASUREMENT / NUMBER values ("cm", "ATM").
  unit        String?
  placeholder String?
  helpText    String?
  isArchived  Boolean                     @default(false)
  options     AttributeDefinitionOption[]
  templates   TemplateAttribute[]
  values      ProductAttributeValue[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
}

model AttributeDefinitionOption {
  id           String              @id @default(cuid())
  definitionId String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String
  sortOrder    Int                 @default(0)

  @@unique([definitionId, value])
}

/// A named block of specification rows on the product page ("Watch Details"). Reusable across templates.
model SpecGroup {
  id        String              @id @default(cuid())
  name      String              @unique
  sortOrder Int                 @default(0)
  items     TemplateAttribute[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

/// Puts an attribute definition on a template, with its per-template settings.
model TemplateAttribute {
  id               String              @id @default(cuid())
  templateId       String
  template         ProductTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  definitionId     String
  definition       AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  required         Boolean             @default(false)
  sortOrder        Int                 @default(0)
  specGroupId      String?
  specGroup        SpecGroup?          @relation(fields: [specGroupId], references: [id], onDelete: SetNull)
  /// Overrides the definition's placeholder for this template only ("Genuine Leather" vs "100% Cotton").
  placeholder      String?
  showOnStorefront Boolean             @default(true)

  @@unique([templateId, definitionId])
  @@index([definitionId])
  @@index([specGroupId])
}

/// One product's value for one attribute. Typed columns (not a JSON blob) so values can be filtered,
/// faceted and validated against the definition.
model ProductAttributeValue {
  id           String              @id @default(cuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  /// TEXT, TEXTAREA, RICH_TEXT, URL and the chosen SELECT option.
  valueText    String?
  /// NUMBER and MEASUREMENT (the unit comes from the definition).
  valueNumber  Decimal?            @db.Decimal(14, 4)
  valueBoolean Boolean?
  valueDate    DateTime?
  /// MULTI_SELECT: string[].
  valueJson    Json?
  updatedAt    DateTime            @updatedAt

  @@unique([productId, definitionId])
  @@index([definitionId, valueText])
}

/// A reusable size chart. Columns and rows are JSON because their shape genuinely differs per product
/// kind (cap: head circumference; shoe: EU/UK/US + foot length; apparel: chest/waist/length).
model SizeGuidePreset {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  /// e.g. "inch", "cm (foot length)".
  unit        String?
  /// string[] — column headings.
  columns     Json
  /// string[][] — every row has exactly columns.length cells (enforced on write).
  rows        Json
  notes       String?
  isArchived  Boolean           @default(false)
  templates   ProductTemplate[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// Reusable care instructions ("Cotton care"). `steps` is a string[] because a care guide is an ordered list of
/// lines and is only ever read and written whole.
model CareGuidePreset {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  steps       Json
  isArchived  Boolean           @default(false)
  templates   ProductTemplate[]
  products    Product[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// A named material ("Premium Cotton", "Genuine Leather"). Relational so products can be found by material.
model Material {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  isArchived  Boolean           @default(false)
  products    ProductMaterial[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// One line of a product's composition: a catalog material or a product-specific custom name, optionally
/// with a percentage ("80% Cotton"). A CHECK constraint (see the migration) requires one of the two names.
/// "Also show in" — a product listed in a category other than its home one (Product.categoryId). Storefront browsing,
/// facets and category stock counts match either; everything that needs one answer (breadcrumb, coupon/bundle scope,
/// order snapshots, reports) keeps using the home category.
model ProductCategoryListing {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductMaterial {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  customName String?
  percentage Decimal?  @db.Decimal(5, 2)
  sortOrder  Int       @default(0)

  @@index([productId])
  @@index([materialId])
}

/// Catalog-wide settings, one row ("singleton"), created on first read like StoreSetting.
model CatalogSetting {
  id         String   @id @default("singleton")
  /// The {PREFIX} token of the SKU pattern.
  skuPrefix  String   @default("SKU")
  /// Tokens: {PREFIX} {TYPE} {COLOR} {SIZE} {SEQ:n} (n = zero-padded digits). Validated on write.
  skuPattern String   @default("{PREFIX}-{TYPE}-{COLOR}-{SIZE}-{SEQ:3}")
  updatedAt  DateTime @updatedAt
}

/// Atomic per-scope counters behind the SKU generator's {SEQ} token (scope = the product type's SKU code).
model SkuCounter {
  scope String @id
  next  Int    @default(1)
}

// ─────────────────────────────────────────────────────────────────────────────
// Product-page sections. The set of sections is a code registry (each has a renderer); these tables only hold the
// admin's choices. Every field is nullable so a row can override just one thing (say, the title) and inherit the
// rest: resolution is product -> template -> global -> the registry default, field by field. Three tables rather than
// one polymorphic one so a deleted product/template takes its rows with it (real foreign keys).
// ─────────────────────────────────────────────────────────────────────────────

/// Store-wide defaults ("Shipping & Returns" text, which sections are on, their order).
model GlobalSection {
  sectionKey String   @id
  enabled    Boolean?
  sortOrder  Int?
  title      String?
  /// Text or HTML for text-type sections (shipping, returns, warranty), one-per-line for list-type ones, a URL for video.
  content    String?  @db.Text
  updatedAt  DateTime @updatedAt
}

/// Overrides for every product of a template.
model TemplateSection {
  id         String          @id @default(cuid())
  templateId String
  template   ProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionKey String
  enabled    Boolean?
  sortOrder  Int?
  title      String?
  content    String?         @db.Text
  updatedAt  DateTime        @updatedAt

  @@unique([templateId, sectionKey])
}

/// Overrides for one product — and the home of that product's own text (highlights, what's included, video URL, warranty).
model ProductSection {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sectionKey String
  enabled    Boolean?
  sortOrder  Int?
  title      String?
  content    String?  @db.Text
  updatedAt  DateTime @updatedAt

  @@unique([productId, sectionKey])
}

model ProductFaq {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

/// A hand-picked product shown in one of a product's recommendation lists. When a list has none, the storefront
/// falls back to the existing algorithm for that list, so an untouched product looks exactly as before.
model ProductRelation {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedId String
  related   Product             @relation("RelatedToProducts", fields: [relatedId], references: [id], onDelete: Cascade)
  kind      ProductRelationKind
  sortOrder Int                 @default(0)

  @@unique([productId, relatedId, kind])
  @@index([productId, kind, sortOrder])
  @@index([relatedId])
}

/// Storefront read model (Phase 3, docs/STOREFRONT_READ_MODEL.md). A PROJECTION of the canonical pricing engine's
/// display price (`priceProductsForDisplay` → `resolveUnitPrice`, the same function every quote uses), kept only so
/// SQL can sort, filter and pick price-neighbours. Never authoritative: prices shown or charged are always computed
/// live; this row is only ever written by domain/storefront/read-model.service.ts and can be rebuilt from scratch at
/// any time. Staleness is detectable from the columns below (see the guard in read-model.service.ts).
model ProductReadModel {
  productId        String    @id
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Lowest current selling price over the product's active variants (= ProductPricing.from).
  minSellingPrice  Decimal   @db.Decimal(10, 2)
  /// Highest current selling price over the active variants (= ProductPricing.to).
  maxSellingPrice  Decimal   @db.Decimal(10, 2)
  /// List price of the variant that sets minSellingPrice (= ProductPricing.listFrom).
  listPriceOfMin   Decimal   @db.Decimal(10, 2)
  hasLiveFlashSale Boolean
  currency         String
  /// PRICING_VERSION the row was computed with — a mismatch marks it stale.
  pricingVersion   Int
  /// md5 fingerprint of every input that decides the selling price (base/compare-at price, each variant's price,
  /// compare-at and active flag, each flash-sale item's terms and its sale's switch and window), computed by the same
  /// SQL the freshness guard uses. Content-based on purpose: no clock (updatedAt is written in two timezones by
  /// different code paths), and a deleted variant or flash item changes it too.
  sourceHash       String
  /// Next instant the price can change on the clock alone (a flash sale starting or ending); null = none scheduled.
  validUntil       DateTime?
  /// A live flash offer with a stock limit prices this product: quota can change with any order, so the row is
  /// recomputed on every guarded read (D4).
  volatile         Boolean   @default(false)
  computedAt       DateTime

  @@index([minSellingPrice])
  @@index([validUntil])
  @@index([volatile])
}

/// Phase 8 (docs/PHASE_8_AUDIT.md) — delivery state of one outbox row.
enum OutboxStatus {
  PENDING
  ENQUEUED
  PROCESSING
  PROCESSED
  FAILED
}

/// Transactional outbox (Phase 8): the durable INTENT to perform one external side effect, written in the same
/// transaction as the business change it follows — never business truth itself. One row per (consumer, eventKey), so a
/// producer can't record the same intent twice. Written only by domain/outbox/outbox.ts; delivered by the dispatcher
/// (→ BullMQ) and the worker (domain/outbox/processor.ts), at least once, to idempotent consumers.
model OutboxEvent {
  id            String       @id @default(cuid())
  /// Versioned business event the intent follows, e.g. "order.placed.v1" (the version governs the payload shape).
  eventType     String
  /// The single consumer that performs the side effect, e.g. "customer-order-sms".
  consumer      String
  /// Business idempotency key, e.g. "order:<id>:placed" — unique per consumer.
  eventKey      String
  aggregateType String
  aggregateId   String
  /// Minimal, versioned, secret-free payload (ids + what the consumer can't re-read later).
  payload       Json
  status        OutboxStatus @default(PENDING)
  /// Processing attempts made (dispatch/enqueue attempts don't count).
  attempts      Int          @default(0)
  /// Not before this instant (retry backoff).
  availableAt   DateTime     @default(now())
  /// Lease of whoever holds the row right now (dispatcher claim, or worker while PROCESSING).
  claimedUntil  DateTime?
  enqueuedAt    DateTime?
  processedAt   DateTime?
  lastError     String?
  /// Phase 11: the correlation ID of the request that recorded this intent (observability only — never business data).
  correlationId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([consumer, eventKey])
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}
