generator client {
  provider        = "prisma-client-js"
  // "native" for local dev (whatever the host is); the musl target is what the node:20-alpine
  // Docker image actually runs on, and its Alpine base ships OpenSSL 3.x, not the 1.1 the
  // default musl engine binary needs.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  // Global `omit` (config/prisma.ts) keeps OrderItem.unitCostSnapshot out of every read unless selected explicitly —
  // recorded cost is internal and must never reach a customer response (docs/PHASE_6_AUDIT.md G6).
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  CLOTHING
  FRAGRANCE
  ACCESSORY
  WATCH
  SHOES
  COSMETICS
  ISLAMIC_PRODUCT
  HOME
  /// Legacy mirror for admin-created types: the real type is Product.typeId -> ProductTypeDef. The enum
  /// itself can't grow at runtime, which is exactly why types moved into a table.
  CUSTOM
}

/// Where a product is in its life. Only PUBLISHED products are on the storefront; `Product.isActive` is kept
/// equal to `status === PUBLISHED` (one service function writes both) because dozens of existing queries filter on it.
enum ProductKind {
  FINISHED
  MATERIAL
}

enum ProductStatus {
  DRAFT
  READY
  PUBLISHED
  UNPUBLISHED
}

/// How a curated product list relates to the product it is attached to.
enum ProductRelationKind {
  RELATED
  CROSS_SELL
  UPSELL
  FREQUENTLY_BOUGHT
  RECOMMENDED
}

enum AttributeDataType {
  TEXT
  TEXTAREA
  NUMBER
  MEASUREMENT
  BOOLEAN
  SELECT
  MULTI_SELECT
  DATE
  URL
  RICH_TEXT
}

/// Whether a template's products offer a size guide, and whether it starts switched on.
enum SizeGuideMode {
  NOT_APPLICABLE
  OFF_BY_DEFAULT
  ON_BY_DEFAULT
}

enum BrandTier {
  PREMIUM
  PLATINUM
  LUXURY
}

enum AdminRole {
  OWNER
  STAFF
  /// Financial Core Phase 3 (docs/FINANCE_PHASE_3.md §11): finance-only roles — no commerce access.
  FINANCE_ADMIN
  ACCOUNTANT
  FINANCE_VIEWER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  /// Steadfast reported "partial_delivered" — the customer accepted only some of the parcel's
  /// items and returned the rest to the courier. Distinct from DELIVERED so an admin has to
  /// reconcile which items actually came back (see Order.partialDeliveryReconciledAt /
  /// OrderItem.returnedQuantity) before stock is restored — silently folding this into DELIVERED
  /// (the old behavior) left the returned units stuck as "sold" forever.
  PARTIALLY_DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum CourierLossReason {
  /// Order was cancelled (by Steadfast or an admin) after a consignment was already booked — the
  /// courier's pickup+return round trip is a sunk cost with nothing collected in exchange.
  CANCELLED_POST_BOOKING
  /// A PARTIALLY_DELIVERED order's reconciliation found at least one returned item.
  PARTIAL_RETURN
}

enum ReturnRequestType {
  RETURN
  EXCHANGE
}

enum PaymentMethod {
  COD
  SSLCOMMERZ
  EPS_PG
}

/// A projection of the order's payment ledger (Payment + Refund rows + store credit issued from the order) — written only
/// by domain/payments/payment-ledger.service.ts (docs/PAYMENT_LEDGER.md §4). PARTIALLY_REFUNDED: Phase 4. PARTIALLY_PAID
/// (some money received, some still due) and CREDITED (everything received moved to the customer's store balance):
/// docs/ORDER_ADJUSTMENTS.md §5.
enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  PARTIALLY_PAID
  CREDITED
}

/// SSLCOMMERZ/EPS_PG: gateway settlements. COD: cash the courier collected on delivery (D1). MANUAL: an
/// out-of-band payment staff recorded (bKash/bank/cash). STORE_CREDIT: the customer's store balance spent on the order
/// (its CustomerCreditEntry debit points back at the Payment) — a tender, not new cash. COD, MANUAL and STORE_CREDIT never
/// appear on a PaymentSession.
enum PaymentProvider {
  SSLCOMMERZ
  EPS_PG
  COD
  MANUAL
  STORE_CREDIT
}

/// ORDER: money for the order. RETURN_CHARGE: what a customer who refused the parcel paid toward the courier's charge
/// (docs/PAYMENT_LEDGER.md §5a) — courier cost recovered, never order money and never owed back.
enum PaymentPurpose {
  ORDER
  RETURN_CHARGE
}

/// ACTIVE -> SUCCEEDED/FAILED (a definitive, re-verified gateway answer) or CANCELLED (customer
/// backed out on the gateway's own page) or EXPIRED (set only by the reconciliation sweep — no
/// gateway signal ever arrived within the session's window; see payment-reconciliation-cron.ts).
/// FAILED and EXPIRED are deliberately distinct: FAILED means the gateway explicitly said no,
/// EXPIRED means we simply never heard back (the customer likely closed the tab).
enum PaymentSessionStatus {
  ACTIVE
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

/// A Payment row is only ever created once a PaymentSession reaches a definitive, re-verified
/// answer — CANCELLED/EXPIRED sessions never produce one, since no charge attempt ever reached the
/// gateway's ledger for those.
enum PaymentTxnStatus {
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  REQUESTED
  COMPLETED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum CouponScope {
  ALL_PRODUCTS
  SPECIFIC_PRODUCTS
  SPECIFIC_CATEGORIES
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Why a variant's stock changed. Every change is written by inventory.service.ts, the only stock writer
/// (docs/INVENTORY_INVARIANTS.md). Older rows keep their original reason — cancellations before Phase 1 are
/// ADJUSTMENT rows carrying an orderId.
/// Phase 4B: the origin of an order line's recorded unit cost (docs/FINANCE_PHASE_4.md §9).
enum OrderLineCostSource {
  INVENTORY
  INVENTORY_PROVISIONAL
  CATALOG
  NONE
}

enum StockMovementReason {
  ORDER
  RESTOCK
  ADJUSTMENT
  RETURN
  CANCELLATION
  IMPORT
  DAMAGED
  LOST
  /// Phase 4 (docs/FINANCE_PHASE_4.md §4): goods received from a supplier on a goods receipt, and goods sent back to one.
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  /// Manufacturing (docs/MANUFACTURING.md §6): material issued to a production order, and unused material returned from it.
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
  /// Accepted finished goods received from a production order (docs/MANUFACTURING.md §8).
  PRODUCTION_RECEIPT
  /// Owner's books (docs/FINANCE_OWNER_BOOKS.md §6.2): packaging material used for a parcel (negative), or put back
  /// when the parcel never left (positive).
  PACKAGING_USE
}

/// The two purchase-funnel steps that have no other trace anywhere in the schema — everything
/// else in the Landing→Repeat-Purchase journey (Section 3 BI) is derivable from PageView.path or
/// Order, but variant selection and guest add-to-cart are otherwise invisible server-side.
enum FunnelEventType {
  VARIANT_SELECTED
  ADD_TO_CART
  REMOVE_FROM_CART
}

enum BannerPlacement {
  HERO_CAROUSEL
  PROMO_STRIP
}

/// HERO/PERSONALIZED_LEAD/FLASH_SALE/CATEGORY_GRID/SMART_RECOMMENDATIONS carry no editable copy of
/// their own — they draw from Banner/FlashSale/Category or are purely behavioral — so their
/// HomepageSection row exists only to control position and visibility. PRODUCT_CAROUSEL and
/// PROMO_BANNER are the only repeatable types (multiple instances allowed); every other type is a
/// singleton enforced in homepage-section.service.ts, not by the schema.
enum HomepageSectionType {
  HERO
  TRUST_STRIP
  PERSONALIZED_LEAD
  PRODUCT_CAROUSEL
  FLASH_SALE
  CATEGORY_GRID
  BRAND_STORY
  VALUES_GRID
  SMART_RECOMMENDATIONS
  PROMO_BANNER
  RICH_TEXT
  TESTIMONIALS
  NEWSLETTER
  IMAGE_GALLERY
}

model AdminUser {
  id                     String                @id @default(cuid())
  name                   String
  email                  String                @unique
  passwordHash           String
  /// Google "sub" claim, set only when this admin has signed in with Google at least once. Google
  /// sign-in never creates an AdminUser on its own — it only links onto one that an OWNER already
  /// invited by matching email, so this stays null for accounts that have never used it.
  googleId               String?               @unique
  /// Least privilege by default (P0-02): an OWNER is only ever created by naming the role explicitly — the seed's first
  /// owner, an invite an OWNER issued with role OWNER, or an OWNER promoting someone.
  role                   AdminRole             @default(STAFF)
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  statusChanges          OrderStatusHistory[]
  reviewedReturnRequests ReturnRequest[]
  sentInvites            AdminInvite[]
  deletedOrders          Order[]               @relation("OrderDeletedBy")
  stockMovements         StockMovement[]
  refundsRequested       Refund[]              @relation("RefundRequestedBy")
  refundsCompleted       Refund[]              @relation("RefundCompletedBy")
  paymentsRecorded       Payment[]             @relation("PaymentRecordedBy")
  creditEntries          CustomerCreditEntry[]
  orderModifications     OrderModification[]
  paymentLinksCreated    PaymentLink[]         @relation("PaymentLinkCreatedBy")
  paymentLinksCancelled  PaymentLink[]         @relation("PaymentLinkCancelledBy")
  notificationReads      NotificationRead[]
  savedViews             SavedView[]
  aiProposals            AiProposal[]
  conversationReplies    ConversationMessage[]
  assignedConversations  Conversation[]        @relation("ConversationAssignee")
  custodyAccounts        FinancialAccount[]    @relation("FinancialAccountCustodian")
}

/// A pending admin account — created by an OWNER via the in-panel "invite admin" flow instead of any
/// public registration route. No AdminUser row exists until the invite is accepted with a password.
model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  name        String
  role        AdminRole
  tokenHash   String    @unique
  invitedById String
  invitedBy   AdminUser @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

/// DB-tracked refresh tokens (rather than bare stateless JWTs) so a session can actually be revoked —
/// on logout, on rotation (the old token is marked used/replaced), and via "log out of all devices".
model RefreshToken {
  id           String    @id @default(cuid())
  adminId      String
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([adminId])
}

/// Append-only record of admin mutations — who did what, to which entity, when.
model AuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([adminId])
  @@index([createdAt])
}

/// Anonymous, aggregate-only log of real storefront searches (not every debounced keystroke) —
/// powers "Popular Searches" and search-prediction completions.
model SearchLog {
  id          String   @id @default(cuid())
  query       String
  resultCount Int
  /// Attached after the fact by a best-effort correlation beacon (see attributeSearchSession in
  /// analytics.service.ts) fired once the search-results page has rendered — not set at write
  /// time, since listStorefrontProducts (where this row is created) never receives `req` and the
  /// search-results fetch is ISR-cached, so threading a per-session id into that request would
  /// fragment the cache. Null until (if ever) attributed; older rows stay null forever.
  sessionId   String?
  visitorId   String?
  /// The catalog suggestion already shown to the shopper for this exact zero-result search (see
  /// findDidYouMean in product.service.ts) — stored at write time so "misspelled searches" don't
  /// need to recompute a trigram lookup for every historical row on every admin page load.
  suggestion  String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([query])
  @@index([sessionId])
}

model Category {
  id                 String                   @id @default(cuid())
  name               String
  slug               String                   @unique
  /// Portrait (4:5) photo: half-width category tiles.
  imageUrl           String?
  imageAltText       String?
  /// Optional wide (16:10) photo for wide category tiles; they fall back to imageUrl.
  wideImageUrl       String?
  bannerImageUrl     String?
  sortOrder          Int                      @default(0)
  isActive           Boolean                  @default(true)
  isFeatured         Boolean                  @default(false)
  seoTitle           String?
  seoDescription     String?
  parentId           String?
  parent             Category?                @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children           Category[]               @relation("CategoryToParent")
  products           Product[]
  /// Products whose home category is elsewhere but that are also listed here (e.g. a unisex item under Men and Women).
  listedProducts     ProductCategoryListing[]
  bundleAnchors      Bundle[]                 @relation("BundleAnchor")
  bundleSuggestions  BundleSuggestion[]       @relation("BundleSuggestionCategory")
  couponCategories   CouponCategory[]
  /// CourierNoteRule ids every product in this category (and its sub-categories) carries — no FK; ids of deleted
  /// rules are removed when the rule is deleted and ignored if any slip through.
  courierNoteRuleIds String[]                 @default([])
  deletedAt          DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([parentId])
  @@index([deletedAt])
}

/// Admin-defined attribute type (e.g. "Color", "Fabric", "Pattern") used to build variant matrices.
model Attribute {
  id        String           @id @default(cuid())
  name      String           @unique
  slug      String           @unique
  sortOrder Int              @default(0)
  values    AttributeValue[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model AttributeValue {
  id           String                  @id @default(cuid())
  attributeId  String
  attribute    Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value        String
  colorHex     String?
  sortOrder    Int                     @default(0)
  variantLinks VariantAttributeValue[]
  createdAt    DateTime                @default(now())

  @@unique([attributeId, value])
  @@index([attributeId])
}

model Product {
  id                 String                   @id @default(cuid())
  name               String
  slug               String                   @unique
  description        String                   @default("")
  shortDescription   String?
  sortOrder          Int                      @default(0)
  categoryId         String
  category           Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Extra categories the product is also listed in on the storefront. `categoryId` stays its one home category
  /// (breadcrumb, coupons, bundles, reports); these only widen where it can be browsed.
  alsoListedIn       ProductCategoryListing[]
  /// Deprecated mirror of typeId's legacy enum value — kept so a rollback and any stale client keep working.
  productType        ProductType              @default(CLOTHING)
  /// Real product type (admin-managed). Nullable so rows written by older code still load; the service
  /// resolves `typeId ?? ProductTypeDef.key = productType`.
  typeId             String?
  type               ProductTypeDef?          @relation(fields: [typeId], references: [id], onDelete: Restrict)
  /// Now only holds what has no attribute definition: the product's own sizeGuide and any legacy key
  /// nobody has defined. Values for defined attributes live in ProductAttributeValue.
  attributes         Json?
  attributeValues    ProductAttributeValue[]
  brand              String?
  brandTier          BrandTier                @default(PREMIUM)
  basePrice          Decimal                  @db.Decimal(10, 2)
  compareAtPrice     Decimal?                 @db.Decimal(10, 2)
  costPrice          Decimal?                 @db.Decimal(10, 2)
  taxRate            Decimal?                 @db.Decimal(5, 2)
  trackInventory     Boolean                  @default(true)
  /// Manufacturing (docs/MANUFACTURING.md): FINISHED goods are sold; MATERIAL items (fabric, thread, labels, packaging) are
  /// stock-tracked inputs that are never sold — the database keeps them unpublished and inactive.
  kind               ProductKind              @default(FINISHED)
  /// The unit every stock quantity of a material is counted in (cm, g, pcs, …) — stock stays a whole number of it.
  stockUnit          String?
  /// Ships free: the canonical quote waives shipping when EVERY line of the cart is a free-delivery product (one normal
  /// product → the zone fee applies). Read only when pricing; each order line snapshots it (OrderItem.freeDeliverySnapshot)
  /// so changing it never touches an existing order (docs/ORDER_ADJUSTMENTS.md §2).
  freeDelivery       Boolean                  @default(false)
  /// Shown and sold as sold out whatever its stock (a parcel on its way back, stock held for another channel…). Stock
  /// itself is untouched; storefront and checkout treat every variant as having none (shared withMarkedSoldOut).
  markedSoldOut      Boolean                  @default(false)
  /// CourierNoteRule ids ticked on this product ("perfume — don't open", "fragile") — on top of its category's. No FK, same
  /// as Category.courierNoteRuleIds. Read when a courier is booked (modules/courier/courier-note.ts).
  courierNoteRuleIds String[]                 @default([])
  lowStockThreshold  Int                      @default(5)
  restockDate        DateTime?
  isActive           Boolean                  @default(true)
  /// Defaults to PUBLISHED so rows written by code that only knows `isActive` stay live.
  status             ProductStatus            @default(PUBLISHED)
  isFeatured         Boolean                  @default(false)
  seoTitle           String?
  seoDescription     String?
  focusKeyword       String?
  /// Admin-entered search tags (YouTube-style): extra words shoppers type that the name/description don't say —
  /// e.g. "ator", "আতর" on a perfume. Stored normalized (lowercase, Bangla vowel variants unified) so storefront
  /// search matches them exactly against its expanded terms. Never shown on the storefront.
  tags               String[]                 @default([])
  ogTitle            String?
  ogDescription      String?
  ogImageUrl         String?
  /// Overrides the self-referencing canonical the product page emits (e.g. when this is a variant of another listing).
  canonicalUrl       String?
  /// Care steps: a preset (falls back to the template's), or this product's own list when `careOverride` is set.
  carePresetId       String?
  carePreset         CareGuidePreset?         @relation(fields: [carePresetId], references: [id], onDelete: SetNull)
  /// string[] — the product's own care steps; wins over the preset.
  careOverride       Json?
  materials          ProductMaterial[]
  /// Per-product page-section overrides (on/off, order, title, own text) — see PageSectionFields below.
  sections           ProductSection[]
  faqs               ProductFaq[]
  /// Curated lists this product owns ("related", "cross-sell", ...), and the reverse side.
  relations          ProductRelation[]        @relation("ProductRelations")
  relatedTo          ProductRelation[]        @relation("RelatedToProducts")
  deletedAt          DateTime?
  billsOfMaterials   BillOfMaterials[]
  productionOrders   ProductionOrder[]
  variants           ProductVariant[]
  images             ProductImage[]
  flashSaleItems     FlashSaleItem[]
  /// Storefront read model (Phase 3) — a projection, never authoritative (docs/STOREFRONT_READ_MODEL.md).
  readModel          ProductReadModel?
  couponProducts     CouponProduct[]
  wishlistItems      WishlistItem[]
  viewLogs           ProductViewLog[]
  reviews            ProductReview[]
  /// Denormalized from ProductReview (APPROVED only) so every product listing can show a rating
  /// without an aggregate join on every request — recomputed whenever a review is approved,
  /// rejected (after having been approved), or deleted.
  avgRating          Float                    @default(0)
  reviewCount        Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([categoryId, isActive])
  @@index([deletedAt])
  @@index([typeId, status])
  @@index([status])
  @@index([carePresetId])
  @@index([tags], type: Gin)
}

/// A store-wide synonym group the admin manages (Catalog → Search synonyms): any word in `terms` also searches for
/// every other one, on top of the built-in dictionary in packages/shared/src/search-synonyms.ts. Terms are stored
/// normalized (normalizeSearchKeyword). Inactive groups are kept but ignored by search.
model SearchSynonym {
  id        String   @id @default(cuid())
  terms     String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Anonymous, aggregate-only log of storefront product-page views — same spirit as SearchLog.
/// Powers "N people viewed today"; never tied to a session or customer.
model ProductViewLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

/// Anonymous, cookie-based pageview beacon — one row per route the visitor lands on. `sessionId`
/// is a random id the storefront generates client-side and keeps for the browser session; it's
/// never tied to a customer account. `referrer`/`utm*` are captured once, at the first pageview of
/// the session, and the client re-sends that same first-touch value on every later pageview in the
/// same session — so grouping by sessionId and taking any one row gives first-touch attribution
/// without a second query. Powers traffic sources, conversion rate, bounce rate, and campaign
/// performance; joined to Order.sessionId for revenue attribution.
model PageView {
  id             String   @id @default(cuid())
  sessionId      String
  /// Persistent (1yr cookie) visitor id, distinct from `sessionId` (a browser-session cookie
  /// cleared on close) — lets BI metrics recognize the same person across visits. Nullable since
  /// rows recorded before this column existed have no value here.
  visitorId      String?
  path           String
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  userAgent      String?
  /// Filled by a second "exit" beacon (navigator.sendBeacon) fired when the visitor leaves this
  /// page — null until then, and forever null for a row whose exit beacon never arrived (tab
  /// killed, browser crash, etc.), which is expected and excluded from engagement averages.
  durationMs     Int?
  scrollDepthPct Int?
  clickCount     Int?
  /// Derived server-side from whether a valid customer session cookie rode along with the beacon —
  /// never trusted from the request body. Defaults false (guest) since most pageviews are.
  isLoggedIn     Boolean  @default(false)
  /// Primary Accept-Language tag (e.g. "en-US"), read server-side from the request header.
  language       String?
  /// geoip-lite lookup off the request IP — offline/free, so accuracy (esp. city-level) is rough,
  /// particularly for mobile-carrier IPs common in this store's market. Null on a lookup miss
  /// (private/local IPs in dev, or an address geoip-lite's bundled database doesn't cover).
  countryCode    String?
  region         String?
  city           String?
  createdAt      DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@index([visitorId])
}

/// Discrete, multiple-per-session purchase-funnel events (Section 3 BI) that PageView can't
/// represent — a shopper picks several variants before adding one to cart, so this can't be a
/// one-row-per-page model. productId/variantId are bare ids with no FK relation, same reasoning as
/// OrderItem's snapshot fields: an analytics event must survive the referenced product being
/// deleted later, and doesn't need cascade behavior.
model FunnelEvent {
  id        String          @id @default(cuid())
  sessionId String
  visitorId String?
  type      FunnelEventType
  productId String?
  variantId String?
  path      String?
  createdAt DateTime        @default(now())

  @@index([sessionId, type])
  @@index([type, createdAt])
}

/// A one-way, server-side mirror of a logged-in customer's client-side (localStorage) cart —
/// exists purely so cart abandonment can be detected and recovered from; never read back into
/// the storefront UI. Guests have no Cart row (the server can't identify/email them).
model Cart {
  id             String     @id @default(cuid())
  customerId     String     @unique
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]
  reminderSentAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

/// A customer's subscription to be emailed when a specific out-of-stock variant is restocked.
model StockAlert {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt  DateTime       @default(now())

  @@unique([customerId, variantId])
  @@index([variantId])
}

model ProductVariant {
  id                        String                     @id @default(cuid())
  productId                 String
  product                   Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                       String                     @unique
  barcode                   String?
  size                      String
  sizeLabel                 String?
  color                     String
  colorHex                  String?
  price                     Decimal?                   @db.Decimal(10, 2)
  /// "Was" price for this variant (shown struck through when above its selling price).
  compareAtPrice            Decimal?                   @db.Decimal(10, 2)
  costPrice                 Decimal?                   @db.Decimal(10, 2)
  stock                     Int                        @default(0)
  weight                    Decimal?                   @db.Decimal(6, 2)
  /// An inactive variant is hidden from the storefront and refused at checkout, but keeps its order and stock history.
  isActive                  Boolean                    @default(true)
  /// Ships free, overriding Product.freeDelivery for this variant (e.g. the 12ml free, the 6ml not). NULL = follow the product.
  freeDelivery              Boolean?
  /// This variant alone shown and sold as sold out whatever its stock (the 6ml, while the 12ml sells) — see Product.markedSoldOut.
  markedSoldOut             Boolean                    @default(false)
  /// The variant's primary image (swatch / cart thumbnail) — always the first of its `images` when it has any.
  imageId                   String?
  image                     ProductImage?              @relation("VariantImage", fields: [imageId], references: [id], onDelete: SetNull)
  /// The variant's own gallery, in display order.
  images                    VariantImage[]
  sortOrder                 Int                        @default(0)
  attributeValues           VariantAttributeValue[]
  stockMovements            StockMovement[]
  /// Phase 4C valuation cutover lines (a posted line protects the variant from deletion — line guard trigger).
  cutoverLines              InventoryCutoverLine[]
  /// Phase 4D purchasing documents — Restrict: a variant that was bought keeps its history.
  purchaseOrderLines        PurchaseOrderLine[]
  goodsReceiptLines         GoodsReceiptLine[]
  purchaseReturnLines       PurchaseReturnLine[]
  /// Manufacturing — Restrict: a variant used in a BOM or a production order keeps its history.
  bomMaterialLines          BillOfMaterialsLine[]      @relation("BomMaterial")
  stockCounts               StockCount[]
  materialRolls             MaterialRoll[]
  bomFinishedLines          BillOfMaterialsLine[]      @relation("BomFinishedVariant")
  productionLines           ProductionOrderLine[]
  productionMaterialLines   ProductionMaterialLine[]
  productionReceiptLines    ProductionReceiptLine[]
  productionSettlementLines ProductionSettlementLine[]
  /// Phase 4 inventory costing — Restrict: a variant with valuation history can't be hard-deleted (§27).
  valuationEntries          InventoryValuationEntry[]
  costState                 InventoryCostState?
  cartItems                 CartItem[]
  stockAlerts               StockAlert[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  supplierInvoiceLines      SupplierInvoiceLine[]
  /// Owner's books §6.2: packing rules that use this material.
  packingRules              PackingRule[]              @relation("PackingRuleMaterial")

  @@unique([productId, size, color])
  @@index([imageId])
}

/// Join row linking a variant to one selected value per admin-defined attribute (e.g. Fabric=Cotton). Size/color stay
/// denormalized on ProductVariant itself since the storefront filters directly on those columns; this table carries
/// the extra attributes (fabric, pattern, material, ...) plus a full record of every attribute chosen, including size/color.
model VariantAttributeValue {
  id               String         @id @default(cuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@index([variantId])
}

model ProductImage {
  id            String           @id @default(cuid())
  productId     String
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  url           String
  altText       String?
  caption       String?
  /// Pixel size of the stored "full" rendition, recorded at upload (null for images uploaded before this existed).
  width         Int?
  height        Int?
  sortOrder     Int              @default(0)
  createdAt     DateTime         @default(now())
  variantsUsing ProductVariant[] @relation("VariantImage")
  variantLinks  VariantImage[]

  @@index([productId])
}

/// One image in one variant's gallery. A product-level image can belong to several variants (e.g. all sizes of a colour).
model VariantImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imageId   String
  image     ProductImage   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)

  @@unique([variantId, imageId])
  @@index([imageId])
}

model Customer {
  id                       String                   @id @default(cuid())
  name                     String
  /// Nullable because a guest checkout with only a phone number (very common for COD orders) still
  /// creates a Customer row — see findOrCreateGuestCustomer in customer.service.ts. Postgres allows
  /// multiple NULLs under a unique constraint, so uniqueness among real emails still holds.
  email                    String?                  @unique
  /// Set once the email-verification link is clicked, or immediately for Google/phone-OTP signups
  /// (Google verifies email ownership itself; phone-OTP accounts skip email verification entirely).
  emailVerifiedAt          DateTime?
  phone                    String?
  /// Phase 11 (BD-11.1): set only when an OTP to exactly this `phone` succeeded — the phone is then the customer's
  /// login identifier. NULL = unverified contact data (may repeat across customers). Cleared whenever `phone` changes.
  /// A partial unique index (migration phase11_customer_identity) allows at most one customer per verified phone.
  phoneVerifiedAt          DateTime?
  passwordHash             String?
  /// Google "sub" claim — set for accounts created or linked via Google sign-in. Null for
  /// email/password-only or phone-OTP-only accounts.
  googleId                 String?                  @unique
  rewardPoints             Int                      @default(0)
  /// Bumped on password reset so every refresh token issued before the reset is rejected —
  /// refresh tokens are stateless JWTs, so this is what lets a reset actually revoke a stolen one.
  tokenVersion             Int                      @default(0)
  /// Explicit consent for SMS marketing sends (Campaign channel SMS) — separate from `phone` itself,
  /// since phone is collected for account/contact purposes and isn't consent on its own.
  smsMarketingOptIn        Boolean                  @default(false)
  /// Consent for email marketing sends (Campaign channel EMAIL). Defaults to true — unlike SMS,
  /// which is opt-in from zero, existing/new customers already expect order and account emails,
  /// and marketing email was already going out to everyone before this flag existed. Every
  /// marketing send carries a one-click unsubscribe link (see lib/token-hash.ts's signPayload)
  /// that flips this to false, so the opt-out is real even though the default is opt-in.
  emailMarketingOptIn      Boolean                  @default(true)
  /// Admin-only freeform notes (never shown to the customer) — same convention as Order.adminNotes.
  adminNotes               String?
  /// Manually set by an admin from the customer drawer — not derived from any order/payment data.
  isBlocked                Boolean                  @default(false)
  /// Manually flagged by an admin (e.g. repeated COD refusals) — informational only, doesn't block checkout.
  codRisk                  Boolean                  @default(false)
  /// Cached result of Steadfast's fraud_check API for this customer's phone — refreshed on demand
  /// via the "Check delivery score" bulk action on the admin order list (checkDeliveryScoresBulk in
  /// courier.service.ts), never on a schedule, since a phone's delivery history doesn't change fast
  /// enough to warrant polling the way courier status does. Null until the first check.
  deliveryTotalParcels     Int?
  deliverySuccessParcels   Int?
  deliveryCancelledParcels Int?
  /// deliveryTotalParcels is now the lower bound of Steadfast's volume range (exact counts are no longer
  /// published); the success/cancelled counts stay null for checks made after 2026-09-27.
  /// Percentage (0-100), Steadfast's delivery_ratio. Null when there's no delivery history yet — not
  /// the same as a bad score, so the UI must not treat null as 0%.
  deliverySuccessRate      Float?
  /// From Steadfast's /fraud_check/score endpoint (the count-based one went dark 2026-09-27): cancellation
  /// percentage, the parcel-volume bucket it reports instead of an exact count (e.g. "2", "25+"), and
  /// the number of fraud reports other merchants have filed against this phone.
  deliveryCancellationRate Float?
  deliveryVolumeRange      String?
  deliveryFraudReports     Int?
  deliveryScoreCheckedAt   DateTime?
  addresses                Address[]
  orders                   Order[]
  wishlistItems            WishlistItem[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  refreshTokens            CustomerRefreshToken[]
  claims                   CustomerClaim[]
  pointsLedger             RewardPointsEntry[]
  cart                     Cart?
  stockAlerts              StockAlert[]
  returnRequests           ReturnRequest[]
  reviews                  ProductReview[]
  campaignRecipients       CampaignRecipient[]
  pushSubscriptions        PushSubscription[]
  /// Store balance ledger (docs/ORDER_ADJUSTMENTS.md §4). The balance is Σ amount — never a stored number.
  creditEntries            CustomerCreditEntry[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  conversations            Conversation[]
  fact                     CustomerFact?

  @@index([phone])
  @@index([updatedAt])
}

/// Blueprint V2 PERF-01/02: the customer list's read model — one row per customer with the figures the list filters and
/// sorts on. Never a second formula: spend and order counts come from the metrics engine (customerMetricsFor), tags and
/// risk from the same functions the detail page uses. Kept current by syncCustomerFacts (customer-facts.service.ts),
/// which recomputes the customers whose rows, orders, payments, refunds, returns or exchange requests changed since the
/// last sync, plus any whose date-based tags (New, Inactive) are due to flip (tagsExpireAt). Safe to delete: it rebuilds.
model CustomerFact {
  customerId      String    @id
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// `customer_net_spend` — lifetime realised net sales (major units).
  netSpend        Decimal   @db.Decimal(14, 2)
  /// `customer_orders` — sale orders placed (lifetime).
  ordersPlaced    Int
  ordersRealised  Int
  /// Risk signals count every non-trashed order (a cancellation rate needs the cancelled ones).
  ordersAll       Int
  cancelledOrders Int
  holdOrders      Int
  lastOrderAt     DateTime?
  district        String?
  tags            String[]
  /// When a date-based tag next changes (New ends, Inactive begins); null when none will.
  tagsExpireAt    DateTime?
  refreshedAt     DateTime  @default(now())

  @@index([netSpend])
  @@index([ordersPlaced])
  @@index([lastOrderAt])
  @@index([district])
  @@index([tagsExpireAt])
}

/// Customers whose figures changed in a way timestamps can't show — an order purged or moved to another customer. Filled
/// by a trigger on "Order" (migration 20261011150000_customer_facts); the next sync recomputes and clears them.
model CustomerFactDirty {
  customerId String   @id
  markedAt   DateTime @default(now())
}

/// The customer-facts sync watermark (one row, id 1): changes after `syncedAt` minus a safety overlap are picked up next.
model CustomerFactSync {
  id       Int      @id @default(1)
  syncedAt DateTime
}

/// The customer store-balance ledger (docs/ORDER_ADJUSTMENTS.md §4) — append-only, written only by
/// domain/credit/customer-credit.service.ts (architecture guard). Positive = credit owed to the customer, held as store
/// balance (store-use only: never withdrawn as cash, never transferred, never expires); negative = balance spent. The
/// available balance is Σ amount, computed under the Customer row lock whenever it is spent, so it can never go negative or
/// be spent twice. Every row carries a server-derived idempotency key: a retried command finds its row instead of adding
/// another.
model CustomerCreditEntry {
  id               String             @id @default(cuid())
  customerId       String
  /// Restrict: a ledger outlives nothing it records — a customer with balance history can't be hard-deleted.
  customer         Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type             CustomerCreditType
  /// Signed, major units of `currency`.
  amount           Decimal            @db.Decimal(10, 2)
  currency         String             @db.VarChar(3)
  reason           String
  /// The order whose money this credit came from (issuance) or that this balance paid for (ORDER_PAYMENT). Plain column
  /// (no FK, like StockMovement.orderId): the ledger outlives a permanently deleted order.
  orderId          String?
  /// What caused it: ORDER, ORDER_MODIFICATION, RETURN_REQUEST, PAYMENT_SESSION, … and that row's id.
  sourceType       String
  sourceId         String
  /// ORDER_PAYMENT: the STORE_CREDIT Payment this spend became (set once — when a gateway checkout's reserved balance is
  /// consumed by the order it paid for).
  paymentId        String?            @unique
  idempotencyKey   String             @unique
  createdByAdminId String?
  createdByAdmin   AdminUser?         @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())

  @@index([customerId, createdAt])
  @@index([orderId])
  @@index([sourceType, sourceId])
}

/// + CANCELLATION (a paid order cancelled), ORDER_MODIFICATION (a change lowered the total below what was paid), RETURN
/// (approved return), EXCHANGE (exchange downgrade), REFUND_TO_CREDIT (staff moved a refund due to store balance),
/// ORDER_PAYMENT_RELEASED (a gateway checkout's reserved balance given back); − ORDER_PAYMENT (balance spent on an order).
enum CustomerCreditType {
  CANCELLATION
  ORDER_MODIFICATION
  RETURN
  EXCHANGE
  REFUND_TO_CREDIT
  ORDER_PAYMENT
  ORDER_PAYMENT_RELEASED
}

/// Append-only ledger backing Customer.rewardPoints — every earn/redeem/manual adjustment is a row,
/// so the running total is always explainable rather than a single mutable counter.
model RewardPointsEntry {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int
  reason     String
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/// Phase 11 (BD-11.3): a DB-tracked customer refresh session. One login = one family (`familyId`); every refresh rotates
/// to a new row in the same family with the same fixed `expiresAt` (7 days from login, never extended). Presenting a
/// rotated or revoked token outside the short concurrency grace window revokes the whole family (reuse detection).
model CustomerRefreshToken {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  familyId      String
  tokenHash     String    @unique
  /// Customer.tokenVersion when issued — a password reset / logout-everywhere bump invalidates older tokens too.
  tokenVersion  Int
  /// false = "remember me" unchecked: the rotated cookie stays a browser-session cookie.
  persistent    Boolean   @default(true)
  expiresAt     DateTime
  rotatedAt     DateTime?
  replacedById  String?
  revokedAt     DateTime?
  /// logout | logout_all | password_change | password_reset | reuse_detected
  revokedReason String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([customerId])
  @@index([familyId])
}

/// Phase 11 (BD-11.6 a): a pending claim of an existing passwordless customer record matched by email. Registration
/// stores the chosen password hash here and emails a link; only following that link (proof of the email) attaches the
/// credential to the existing record. Never moves any record between customers.
model CustomerClaim {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  passwordHash String
  name         String
  phone        String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([customerId])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/// One row per outstanding phone-login code — `attempts` caps guesses at a 6-digit code (invalidated
/// after 5 wrong tries) independent of the per-IP rate limit on the request route itself.
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String?
  fullName    String
  phone       String
  division    String
  district    String
  area        String
  addressLine String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  // At most one isDefault=true row per customer is also enforced at the DB level by a raw partial
  // unique index (see migration add_address_one_default_per_customer) — Prisma's schema DSL can't
  // express a partial/conditional unique constraint, so it isn't declared here, but it exists.

  @@index([customerId])
}

model Coupon {
  id                String           @id @default(cuid())
  code              String           @unique
  type              CouponType
  /// Nullable because FREE_SHIPPING coupons have no amount/percentage of their own.
  value             Decimal?         @db.Decimal(10, 2)
  scope             CouponScope      @default(ALL_PRODUCTS)
  minOrderAmount    Decimal?         @db.Decimal(10, 2)
  maxDiscountAmount Decimal?         @db.Decimal(10, 2)
  /// Minimum combined quantity of eligible items (all items, if scope is ALL_PRODUCTS) required to redeem.
  minQuantity       Int?
  usageLimit        Int?
  usedCount         Int              @default(0)
  /// Caps how many times a single customer (guest or account) may redeem this coupon, counted
  /// against Order.customerId — every order, guest included, resolves to a real Customer row.
  perCustomerLimit  Int?
  /// Restricts redemption to a customer's very first order.
  firstOrderOnly    Boolean          @default(false)
  /// Optional scheduled activation, paired with expiresAt for a redemption window.
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean          @default(true)
  /// Admin-only internal note — never shown to customers.
  description       String?
  products          CouponProduct[]
  categories        CouponCategory[]
  orders            Order[]
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([deletedAt])
}

/// Links a coupon to one of the specific products it discounts, when scope is SPECIFIC_PRODUCTS.
model CouponProduct {
  id        String  @id @default(cuid())
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([productId])
}

/// Links a coupon to one of the specific categories it discounts, when scope is SPECIFIC_CATEGORIES.
model CouponCategory {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, categoryId])
  @@index([categoryId])
}

/// A category-driven cross-sell rule: buying from `anchorCategory` (e.g. Panjabi) unlocks a
/// discount once enough of the suggested accessory categories (Pajama, Ator, Cap, Tasbih, ...)
/// are also in the cart. Suggestions are categories, not specific products, so new products added
/// to those categories become suggestible without editing the bundle.
model Bundle {
  id                     String             @id @default(cuid())
  name                   String
  anchorCategoryId       String
  anchorCategory         Category           @relation("BundleAnchor", fields: [anchorCategoryId], references: [id], onDelete: Cascade)
  discountType           CouponType
  discountValue          Decimal            @db.Decimal(10, 2)
  /// How many distinct suggested categories must also be in the cart before the discount applies.
  minSuggestedCategories Int                @default(1)
  isActive               Boolean            @default(true)
  sortOrder              Int                @default(0)
  suggestions            BundleSuggestion[]
  orders                 Order[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([anchorCategoryId, isActive])
}

model BundleSuggestion {
  id         String   @id @default(cuid())
  bundleId   String
  bundle     Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation("BundleSuggestionCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@unique([bundleId, categoryId])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)
  /// The storefront session (see PageView.sessionId) that placed this order, if the checkout
  /// beacon fired — links revenue back to conversion rate/traffic-source/campaign analytics.
  /// Never tied to a customer account; just the anonymous client-generated session id.
  sessionId     String?

  customerName        String
  customerEmail       String?
  customerPhone       String
  shippingDivision    String
  shippingDistrict    String
  shippingArea        String
  shippingAddressLine String

  subtotal    Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  shippingFee Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  /// Signed manual nudge to the total an admin applies during the confirmation call — negative for
  /// a goodwill/negotiated discount, positive for a surcharge (e.g. a remote-area delivery add-on) —
  /// separate from `discount` (coupon/bundle, set at checkout and never hand-edited). Folded into
  /// `total` by adjustOrderPrice in order.service.ts; blocked once a courier is booked, since
  /// Steadfast's COD amount is fixed at that point.
  priceAdjustment Decimal @default(0) @db.Decimal(10, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  bundleId       String?
  bundle         Bundle? @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  bundleDiscount Decimal @default(0) @db.Decimal(10, 2)

  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  returnRequests         ReturnRequest[]
  /// Reverse side of ReturnRequest.exchangeOrderId — an approved EXCHANGE request creates a new,
  /// separate Order (the replacement shipment) and links back here; at most one element in
  /// practice (one exchange request produces one exchange order), kept as an array only because
  /// Prisma requires a matching relation field on both sides.
  exchangeReturnRequests ReturnRequest[]      @relation("ReturnRequestExchangeOrder")
  courierLossEvents      CourierLossEvent[]
  modifications          OrderModification[]
  paymentLinks           PaymentLink[]
  notes                  String?
  adminNotes             String?
  /// Staff's own wording of the note the courier sees, replacing the one built from the courier-note rules. Null = use the
  /// rules (modules/courier/courier-note.ts). Frozen once a courier is booked.
  courierNote            String?
  /// Exactly what was sent to the courier as the parcel note at booking — the record of what the rider was told.
  courierNoteSent        String?
  trackingNumber         String?
  carrier                String?
  /// @deprecated superseded by PaymentSession.gatewayTransactionRef/providerTransactionId — kept
  /// only until the follow-up migration that drops it (see PaymentSession's doc comment); nothing
  /// reads or writes these two fields any more once payment.service.ts's cutover lands.
  paymentSessionKey      String?
  /// @deprecated superseded by Payment.providerTransactionId.
  paymentTransactionId   String?
  paymentSessions        PaymentSession[]
  payments               Payment[]
  refunds                Refund[]

  /// Steadfast's internal id for the booked consignment — the key used to poll status and to
  /// match incoming webhooks back to this order. Null until "Book with Steadfast" is used.
  courierConsignmentId    String?
  /// Raw delivery_status string from Steadfast (e.g. "in_review", "delivered", "cancelled"),
  /// shown to the admin as-is; see mapSteadfastStatusToOrderStatus for how it affects `status`.
  courierStatus           String?
  courierBookedAt         DateTime?
  /// Phase 9 (D-4): booking claim — set atomically (conditional update) before the Steadfast call so two concurrent
  /// bookings can't both reach the provider; cleared when the booking is saved or definitely failed, KEPT when the
  /// outcome is unknown (timeout / 5xx) until an operator checks Steadfast or the 10-min lease lapses.
  courierBookingStartedAt DateTime?
  /// Steadfast's own trackable URL (https://steadfast.com.bd/tl/{opaque-token}) — only present in
  /// the create_order/bulk-order response body, not derivable from tracking_code and not returned
  /// by status_by_cid, so bookings made before this field existed will have it null forever.
  courierTrackingLink     String?
  /// Last time `courierStatus` was confirmed against Steadfast's API (webhook, cron sweep, or a
  /// manual/bulk sync) — null until the first successful sync. Drives the admin UI's "last synced"
  /// label and the staleness check in getOrderByIdWithAutoSync.
  courierStatusSyncedAt   DateTime?
  /// Message from the most recent failed sync attempt; cleared on the next successful one. Lets the
  /// admin UI show "sync failed" instead of silently displaying a possibly-stale courierStatus.
  courierSyncError        String?
  /// What Steadfast reported the rider actually collected on a partial delivery (`cod_amount` of a `partial_delivered`
  /// webhook, accepted only when Steadfast's own status API also says partial_delivered). A refused parcel whose
  /// customer paid the delivery charge arrives this way. Courier evidence only — never order money by itself; see
  /// settleCourierCollected (docs/PAYMENT_LEDGER.md §5b).
  courierCollectedAmount  Decimal?  @db.Decimal(10, 2)
  courierCollectedAt      DateTime?

  // ── Pricing snapshot (Phase 2, docs/PRICING_INVARIANTS.md §8). Immutable historical facts written once at order
  // creation by the canonical pricing pipeline; never recomputed from current products, promotions or settings.
  // NULL on orders placed before Phase 2 where the fact can't be reconstructed reliably (never invented).
  /// Version of the pricing pipeline that priced this order (PRICING_VERSION); null = before Phase 2.
  pricingVersion    Int?
  /// Σ (list price − flash price) × units — what flash sales took off. Null before Phase 2.
  flashDiscount     Decimal?  @db.Decimal(10, 2)
  /// The coupon's part of `discount` (the rest is `bundleDiscount`). Backfilled from discount − bundleDiscount.
  couponDiscount    Decimal?  @db.Decimal(10, 2)
  /// True when `shippingFee` was not charged (free-shipping coupon or free-over threshold). Backfilled from the
  /// order's own snapshot arithmetic; adjustOrderPrice reads this instead of the live coupon.
  shippingWaived    Boolean?
  /// Key of the ShippingZone that priced shipping. Null before Phase 2.
  shippingZoneKey   String?
  /// Tax snapshot (D3): the mode, rates and amounts in force when the order was placed. Null before Phase 2.
  taxMode           TaxMode?
  taxRate           Decimal?  @db.Decimal(5, 2)
  shippingTaxRate   Decimal?  @db.Decimal(5, 2)
  /// Net of VAT (merchandise after discounts + shipping charged).
  taxableAmount     Decimal?  @db.Decimal(10, 2)
  /// Total VAT (merchandise + shipping). Included in `total` when taxMode = INCLUSIVE, added to it when EXCLUSIVE.
  taxAmount         Decimal?  @db.Decimal(10, 2)
  shippingTaxAmount Decimal?  @db.Decimal(10, 2)
  /// D7: when a pre-shipment cancellation released this order's coupon usage (Coupon.usedCount − 1). Null = the
  /// order still counts as a redemption.
  couponReleasedAt  DateTime?
  /// Idempotency-Key the order was created with — a repeat request with the same key returns this order.
  idempotencyKey    String?   @unique
  /// Bumped every time a modification changes the order's contents, address or total. A payment link or a modification
  /// waiting for payment records the revision it was priced against and is refused once the order moved on — a stale
  /// link can never collect the wrong amount (docs/ORDER_ADJUSTMENTS.md §11).
  revision          Int       @default(0)

  /// Set once an admin has reconciled a PARTIALLY_DELIVERED order — picked which items actually
  /// came back (OrderItem.returnedQuantity) and had them restocked. Status stays
  /// PARTIALLY_DELIVERED permanently after this (it never gets rewritten to DELIVERED, since the
  /// exact amount collected on a partial delivery isn't known — see reconcilePartialDelivery in
  /// order.service.ts); this timestamp is what the admin UI uses to know reconciliation is done.
  partialDeliveryReconciledAt DateTime?

  /// When set, this order is "on hold" pending a follow-up phone call (no-answer/undecided outcome
  /// of the pre-shipping confirmation call) — `status` stays PENDING throughout; this is a separate
  /// callback-queue signal, not a status. Cleared automatically by updateOrderStatus the moment the
  /// order moves off PENDING, and set/refreshed by the "Hold — call back later" admin action.
  followUpAt   DateTime?
  /// Lifetime count of "Hold — call back later" placements on this order — a rough measure of how
  /// many confirmation-call attempts it has taken. Never reset or decremented, and doesn't gate any
  /// auto-cancel behavior.
  callAttempts Int       @default(0)

  /// Soft delete — an OWNER-only admin action (see deleteOrder in order.service.ts). Restocks the
  /// order's items and hides it from every default query, but never physically removes the row
  /// (financial/audit record). restoreOrder clears both fields but deliberately does not re-decrement
  /// stock, since that inventory may already have been resold in the meantime.
  deletedAt        DateTime?
  deletedByAdminId String?
  deletedByAdmin   AdminUser? @relation("OrderDeletedBy", fields: [deletedByAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([createdAt, status])
  @@index([sessionId])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([deletedAt])
  @@index([courierConsignmentId])
  @@index([followUpAt])
  @@index([updatedAt])
}

/// Append-only timeline of status transitions for an order — powers the admin timeline view.
model OrderStatusHistory {
  id               String      @id @default(cuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           OrderStatus
  note             String?
  changedByAdminId String?
  changedByAdmin   AdminUser?  @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())

  @@index([orderId])
}

/// A customer-initiated return request on a delivered order, reviewed by an admin. Approving one
/// reuses the existing order-status machinery (transitions the order to RETURNED) rather than
/// tracking a parallel status of its own — there's no payment-gateway refund API integrated, so
/// "refund status" is just the order's existing status/paymentStatus shown alongside this record.
model ReturnRequest {
  id                     String              @id @default(cuid())
  orderId                String
  order                  Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId             String
  customer               Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reason                 String
  note                   String?
  /// RETURN (default) is the original refund/restock flow. EXCHANGE is a same-order size/color
  /// swap: the fields below are only populated (and only required by the Zod schema) when this is
  /// EXCHANGE — see reviewReturnRequest in return-request.service.ts for how approval branches.
  type                   ReturnRequestType   @default(RETURN)
  // EXCHANGE only, from here down. orderItemId/requestedVariantId are plain id columns with no FK
  // relation (same "no FK guarantee it still exists" reasoning as OrderItem.variantId) — the
  // Snapshot fields alongside them keep the request displayable even if the variant/product is
  // later deleted.
  orderItemId            String?
  originalSizeSnapshot   String?
  originalColorSnapshot  String?
  requestedVariantId     String?
  requestedSizeSnapshot  String?
  requestedColorSnapshot String?
  /// The free replacement Order created when an EXCHANGE request is approved — see
  /// createExchangeOrder in return-request.service.ts. Null until approved (or always, for RETURN).
  exchangeOrderId        String?
  exchangeOrder          Order?              @relation("ReturnRequestExchangeOrder", fields: [exchangeOrderId], references: [id], onDelete: SetNull)
  // At most one PENDING request per order is also enforced at the DB level by a raw partial unique
  // index (see migrations/..._return_request_one_pending_per_order) — Prisma's schema DSL can't
  // express a partial/conditional unique constraint, so it isn't declared here, but it exists.
  status                 ReturnRequestStatus @default(PENDING)
  /// Item-level return recorded by staff (docs/ORDER_ADJUSTMENTS.md §8, §11): [{ orderItemId, quantity, restocked,
  /// writtenOff, value }] — which lines came back, how many units, how many went back on the shelf, and each line's
  /// allocated value. Null for whole-order returns and exchanges.
  lines                  Json?
  /// STORE_CREDIT | REFUND | NONE — what the customer got back for this request, and how much.
  compensation           String?
  compensationAmount     Decimal?            @db.Decimal(10, 2)
  /// Idempotency-Key of the staff request that recorded an item-level return — a repeat returns this row.
  idempotencyKey         String?             @unique
  adminNote              String?
  reviewedAt             DateTime?
  reviewedByAdminId      String?
  reviewedByAdmin        AdminUser?          @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([updatedAt])
}

/// One row per payment attempt. An order can have several over time (a failed/cancelled/expired
/// attempt followed by a retry) — this is what makes retryPayment (order.service.ts) possible at
/// all, unlike the single paymentSessionKey field this supersedes. `gatewayTransactionRef` is OUR
/// id for the attempt (a fresh cuid, NEVER the orderNumber), sent to the gateway as tran_id
/// (SSLCommerz) / merchantTransactionId (EPS) and carried back on every callback — callbacks now
/// look up a session by this ref, not by orderNumber, since an orderNumber can map to several.
/// `providerTransactionId` is the gateway's OWN id for the session (SSLCommerz sessionkey / EPS's
/// InitializeEPS TransactionId) — informational only, never used as a lookup key.
///
/// At most one ACTIVE session per order is enforced at the DB level by a raw partial unique index
/// (see migrations/..._add_payment_sessions) — Prisma's schema DSL can't express a partial/
/// conditional unique constraint, so it isn't declared here, but it exists. Same pattern as
/// ReturnRequest's one-PENDING-per-order index above. Doesn't constrain orderId: NULL sessions
/// (a storefront checkout that hasn't settled into an Order yet, see checkoutPayload) — Postgres
/// never treats two NULLs as a collision, so several such attempts can be ACTIVE at once; the
/// constraint only bites once a session is actually tied to a real order.
model PaymentSession {
  id                    String               @id @default(cuid())
  /// Null until settlement for a storefront digital-payment checkout — see checkoutPayload.
  /// Always set immediately for a session started against an order that already exists
  /// (retryPayment, admin-created orders).
  orderId               String?
  order                 Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  status                PaymentSessionStatus @default(ACTIVE)
  gatewayTransactionRef String               @unique
  providerTransactionId String?
  gatewayUrl            String?
  /// A snapshot of the CheckoutInput (plus the resolved customerId) taken when a storefront
  /// digital-payment checkout starts this session with no Order yet — settlePaymentSession uses
  /// it to materialize the real Order only once the gateway confirms success. Null for a session
  /// started against an order that already exists (retryPayment, admin-created orders).
  checkoutPayload       Json?
  /// Idempotency-Key of the checkout that started this session — a repeat returns this session's gateway URL.
  idempotencyKey        String?              @unique
  /// What the gateway was asked to collect for this attempt (the balance due, a modification's difference, a link's
  /// amount — never the browser's number). Settlement verifies the gateway's amount against THIS, so a session started
  /// before the order changed still settles exactly what it charged. Null = sessions from before this column: the order
  /// total (or the checkout payload's) is the expected amount, as before.
  amount                Decimal?             @db.Decimal(10, 2)
  paymentLinkId         String?
  paymentLink           PaymentLink?         @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)
  /// A modification waiting for its price difference: a verified success applies it in the settlement's transaction.
  orderModificationId   String?
  orderModification     OrderModification?   @relation(fields: [orderModificationId], references: [id], onDelete: SetNull)
  /// 48h out from creation — the same lookback bound the EPS reconciliation sweep already used
  /// before this table existed. The sweep flips any still-ACTIVE session past this to EXPIRED so it
  /// stops being polled and stops blocking a retry.
  expiresAt             DateTime
  payment               Payment?
  events                PaymentEvent[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([orderId])
  @@index([status, provider, createdAt])
  @@index([paymentLinkId])
}

/// Every Steadfast webhook as it arrived (after the token check) — the courier's own record of what happened to a
/// parcel, kept for audit and to read fields our status API can't give (what was collected, the delivery charge).
/// Append-only. `idempotencyKey` = Steadfast's Idempotency-Key header (the same on every retry of one event).
model CourierWebhookEvent {
  id               String   @id @default(cuid())
  provider         String   @default("STEADFAST")
  idempotencyKey   String?  @unique
  /// delivery_status (also when the body has none) | tracking_update | anything else Steadfast sends, as sent.
  notificationType String
  consignmentId    String?
  /// The order the consignment belongs to, when one does (no FK: the log outlives a permanently deleted order).
  orderId          String?
  status           String?
  codAmount        Decimal? @db.Decimal(10, 2)
  deliveryCharge   Decimal? @db.Decimal(10, 2)
  trackingMessage  String?
  payload          Json
  /// What we did with it: APPLIED, DUPLICATE, NO_ORDER, NO_CONSIGNMENT, FAILED.
  outcome          String
  receivedAt       DateTime @default(now())

  @@index([consignmentId])
  @@index([orderId])
  @@index([receivedAt])
}

/// The settlement record for one PaymentSession — created only once the gateway has given a
/// definitive, re-verified answer (see PaymentTxnStatus). At most one per session
/// (`paymentSessionId` unique): a session settles exactly once. `verifiedAmount` always comes from
/// the gateway's own re-verify response, never a client-supplied value — the same anti-replay
/// guarantee the old direct Order.total comparison provided. `rawResponse` is a full JSON snapshot
/// of the verify/validate call, kept as an audit trail independent of whatever fields above project
/// out of it.
model Payment {
  id                    String           @id @default(cuid())
  /// Null for a FAILED settlement of a storefront digital-payment checkout — no Order is ever
  /// created for a failed/cancelled attempt, so this row (not an Order) is the payment log.
  orderId               String?
  order                 Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Null for a settlement with no gateway session — COD collected on delivery, or a MANUAL payment (Phase 4).
  paymentSessionId      String?          @unique
  paymentSession        PaymentSession?  @relation(fields: [paymentSessionId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  status                PaymentTxnStatus
  /// Staff may re-mark a COD / MANUAL row either way (reclassifyPayment); the order timeline keeps the trail.
  purpose               PaymentPurpose   @default(ORDER)
  amount                Decimal          @db.Decimal(10, 2)
  verifiedAmount        Decimal?         @db.Decimal(10, 2)
  /// SSLCommerz bank_tran_id (falls back to val_id) / EPS EpsTransactionId.
  providerTransactionId String?
  rawResponse           Json?
  /// Free-text context: how a manual payment was made ("bKash 01…"), or why a backfilled row exists.
  note                  String?
  recordedByAdminId     String?
  recordedByAdmin       AdminUser?       @relation("PaymentRecordedBy", fields: [recordedByAdminId], references: [id], onDelete: SetNull)
  /// Idempotency-Key of the admin request that recorded a manual payment — a repeat returns this row.
  idempotencyKey        String?          @unique
  /// True for rows the Phase 4 backfill inserted from an order's own recorded status (docs/PAYMENT_LEDGER.md §11).
  backfilled            Boolean          @default(false)
  settledAt             DateTime         @default(now())
  refunds               Refund[]
  createdAt             DateTime         @default(now())

  @@index([orderId])
  @@index([createdAt])
}

/// Append-only timeline of one payment attempt (INITIATED, VERIFIED_SUCCESS, VERIFIED_FAILED,
/// CANCELLED, EXPIRED, ...) — same template as OrderStatusHistory (no updatedAt, one index on the
/// parent FK), but scoped to a PaymentSession rather than an Order, since one order's full payment
/// history can now span several attempts.
model PaymentEvent {
  id               String         @id @default(cuid())
  paymentSessionId String
  paymentSession   PaymentSession @relation(fields: [paymentSessionId], references: [id], onDelete: Cascade)
  type             String
  note             String?
  rawResponse      Json?
  createdAt        DateTime       @default(now())

  @@index([paymentSessionId])
}

/// A manual, out-of-band refund record — neither SSLCommerz nor EPS expose a refund API (see the
/// comment above ReturnRequest), so an admin transfers money back themselves (bKash/bank/cash) and
/// logs it here. This table is the record of what happened, not a trigger. REQUESTED = owed (a D6
/// exchange downgrade), COMPLETED = paid out; the only mutation is REQUESTED → COMPLETED. Written only by
/// domain/payments/payment-ledger.service.ts, which derives Order.paymentStatus from these rows and the
/// Payment rows (docs/PAYMENT_LEDGER.md).
model Refund {
  id                 String       @id @default(cuid())
  orderId            String
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId          String?
  payment            Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount             Decimal      @db.Decimal(10, 2)
  reason             String?
  /// How the money was actually sent back — "bKash", "Bank transfer", "Cash", ... — free text, no
  /// enum, since the set of real-world methods isn't fixed and this is informational only.
  method             String?
  status             RefundStatus @default(REQUESTED)
  requestedByAdminId String?
  requestedByAdmin   AdminUser?   @relation("RefundRequestedBy", fields: [requestedByAdminId], references: [id], onDelete: SetNull)
  completedByAdminId String?
  completedByAdmin   AdminUser?   @relation("RefundCompletedBy", fields: [completedByAdminId], references: [id], onDelete: SetNull)
  /// Idempotency-Key of the admin request that recorded this refund — a repeat returns this row.
  idempotencyKey     String?      @unique
  completedAt        DateTime?
  createdAt          DateTime     @default(now())

  @@index([orderId])
  @@index([createdAt])
}

/// One change to an order's contents/address after it was placed (docs/ORDER_ADJUSTMENTS.md §3) — the audit record of
/// what the order looked like before, what it became, and what that did to the money. APPLIED changes are history;
/// AWAITING_PAYMENT holds a priced plan that takes effect only when its difference is paid (applied inside the payment's
/// settlement transaction); SUPERSEDED/CANCELLED/EXPIRED plans never touched the order.
model OrderModification {
  id              String                  @id @default(cuid())
  orderId         String
  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// 1, 2, 3 … per order.
  sequence        Int
  status          OrderModificationStatus
  initiatedBy     OrderEditorType
  customerId      String?
  adminId         String?
  admin           AdminUser?              @relation(fields: [adminId], references: [id], onDelete: SetNull)
  reason          String?
  /// The order revision the plan was priced against; applying needs the order still at it.
  baseRevision    Int
  /// { items, totals, address } before the change.
  before          Json
  /// The priced plan: line snapshots, totals, coupon outcome, address.
  plan            Json
  previousTotal   Decimal                 @db.Decimal(10, 2)
  newTotal        Decimal                 @db.Decimal(10, 2)
  /// What had to be paid before an online-paid order's change could take effect.
  amountDue       Decimal                 @default(0) @db.Decimal(10, 2)
  /// What went to the customer's store balance when it was applied.
  amountCredited  Decimal                 @default(0) @db.Decimal(10, 2)
  idempotencyKey  String?                 @unique
  expiresAt       DateTime?
  appliedAt       DateTime?
  statusReason    String?
  paymentSessions PaymentSession[]
  paymentLinks    PaymentLink[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([orderId, sequence])
  @@index([orderId, status])
}

enum OrderModificationStatus {
  APPLIED
  AWAITING_PAYMENT
  SUPERSEDED
  CANCELLED
  EXPIRED
}

enum OrderEditorType {
  CUSTOMER
  ADMIN
}

/// A secure, shareable request for the customer to pay what is due on an order (docs/ORDER_ADJUSTMENTS.md §11). The link
/// is a capability: a 256-bit random token, stored only as a SHA-256 hash (lookup) and AES-GCM ciphertext (so staff can
/// copy or re-send it). It never creates a Payment — only a verified gateway settlement does, through the payment ledger.
/// At most one ACTIVE link per order (raw partial unique index). The link is tied to the order revision and amount it was
/// generated for; once the order changes it can no longer be paid.
model PaymentLink {
  id                  String             @id @default(cuid())
  tokenHash           String             @unique
  tokenCiphertext     String
  orderId             String
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purpose             PaymentLinkPurpose
  orderModificationId String?
  orderModification   OrderModification? @relation(fields: [orderModificationId], references: [id], onDelete: SetNull)
  amount              Decimal            @db.Decimal(10, 2)
  currency            String             @db.VarChar(3)
  orderRevision       Int
  status              PaymentLinkStatus  @default(ACTIVE)
  statusReason        String?
  expiresAt           DateTime
  usedAt              DateTime?
  cancelledAt         DateTime?
  createdByAdminId    String?
  createdByAdmin      AdminUser?         @relation("PaymentLinkCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  cancelledByAdminId  String?
  cancelledByAdmin    AdminUser?         @relation("PaymentLinkCancelledBy", fields: [cancelledByAdminId], references: [id], onDelete: SetNull)
  paymentSessions     PaymentSession[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([orderId, status])
}

enum PaymentLinkStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum PaymentLinkPurpose {
  ORDER_BALANCE
  MODIFICATION
}

/// A customer-submitted star rating + write-up for a product. Starts PENDING and only counts
/// toward Product.avgRating/reviewCount once an admin approves it — unmoderated reviews never
/// reach the storefront. `customerName` is a display-name snapshot (survives a later name change);
/// `isVerifiedPurchase` is computed once at submission from real DELIVERED-order history.
model ProductReview {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId         String
  customer           Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName       String
  rating             Int
  title              String?
  body               String
  /// Customer photos (`/uploads/reviews/<uuid>.webp`, re-encoded on upload), shown once the review is approved.
  images             String[]     @default([])
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // One review per customer per product — resubmitting means editing, not stacking duplicates.
  @@unique([productId, customerId])
  @@index([productId, status])
  @@index([status])
}

model OrderItem {
  id                      String               @id @default(cuid())
  orderId                 String
  order                   Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId               String
  productNameSnapshot     String
  skuSnapshot             String
  sizeSnapshot            String
  colorSnapshot           String
  priceSnapshot           Decimal              @db.Decimal(10, 2)
  quantity                Int
  /// How many units of this line were reconciled as "came back to us" on a PARTIALLY_DELIVERED
  /// order (see Order.partialDeliveryReconciledAt) — 0 means either not yet reconciled or the
  /// customer kept the full quantity. Set once by reconcilePartialDelivery in order.service.ts,
  /// which also restocks exactly this many units via a matching StockMovement.
  returnedQuantity        Int                  @default(0)
  /// How many units of this line have been put back into stock by any path — cancellation, return,
  /// partial-delivery reconciliation, exchange, or moving the order to Trash. Releasing stock for a line
  /// never exceeds `quantity - restockedQuantity`, which is what makes every restock path idempotent
  /// (docs/INVENTORY_INVARIANTS.md). Only inventory.service.ts writes it.
  restockedQuantity       Int                  @default(0)
  /// Pricing snapshot (Phase 2). A line has ONE unit price: a cart line that is partly flash-priced (D4 stockLimit)
  /// is stored as two OrderItem rows. Null before Phase 2.
  /// The regular (pre-flash) unit price: the variant's own price, else the product base price.
  listPriceSnapshot       Decimal?             @db.Decimal(10, 2)
  /// The flash sale that priced these units (snapshot ids, no FK — history outlives the sale). Null = regular price.
  flashSaleId             String?
  flashSaleItemId         String?
  /// This line's share of the order's bundle / coupon discount (proportional allocation, sums to the order amount).
  bundleDiscountAllocated Decimal?             @db.Decimal(10, 2)
  couponDiscountAllocated Decimal?             @db.Decimal(10, 2)
  /// Historical facts (Phase 6, docs/PHASE_6_AUDIT.md) — captured once, in the transaction that writes this line
  /// (order creation or exchange-replacement creation), never updated. No FKs: history outlives the catalog.
  /// Per-unit cost in MINOR units of the store currency (StoreSetting.currency, locked once orders exist):
  /// variant.costPrice ?? product.costPrice at order time. NULL = unknown (no cost configured, or before Phase 6) —
  /// never 0 by default. Omitted from every Prisma read unless selected (config/prisma.ts).
  unitCostSnapshot        Int?
  /// Phase 4B (docs/FINANCE_PHASE_4.md §9): where `unitCostSnapshot` came from — INVENTORY (the moving average of valued
  /// stock at the stock exit), INVENTORY_PROVISIONAL (part of the line left stock that wasn't valued: the cost is a
  /// provisional one, trued up through 5150 later), CATALOG (the catalog cost: untracked products, or costing not active),
  /// NONE (no cost known). NULL = written before Phase 4B. Omitted from every read unless selected, like the cost itself.
  unitCostSource          OrderLineCostSource?
  /// The stock exit (ORDER movement) whose valuation entry carries exactly this line's unit cost — set for INVENTORY*
  /// and NONE-at-exit lines of costed variants; a database trigger proves the two costs are the same number.
  costMovementId          String?
  costMovement            StockMovement?       @relation("OrderItemCostMovement", fields: [costMovementId], references: [id], onDelete: Restrict)
  /// The variant's product (backfilled for older lines from ProductVariant.productId — a variant never changes product).
  productIdSnapshot       String?
  /// The product's category and its name at order time. NULL = not recorded (line predates Phase 6); every product has
  /// a category, so a recorded line always has categoryIdSnapshot.
  categoryIdSnapshot      String?
  categoryNameSnapshot    String?
  /// Product.brand at order time (free text; no brand id exists). NULL with categoryIdSnapshot set = unbranded.
  brandSnapshot           String?
  /// Product.freeDelivery when this line was priced. NULL = before the flag existed (treated as false). A modification
  /// keeps a kept line's own value, so a product's later change never reaches this order.
  freeDeliverySnapshot    Boolean?

  @@index([orderId])
  @@index([flashSaleItemId])
  @@index([costMovementId])
}

model StockMovement {
  id             String                   @id @default(cuid())
  variantId      String
  variant        ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change         Int
  reason         StockMovementReason
  orderId        String?
  adminId        String?
  admin          AdminUser?               @relation(fields: [adminId], references: [id], onDelete: SetNull)
  note           String?
  /// Phase 4: the document line that caused the movement (e.g. GoodsReceiptLine) — null for order and manual movements.
  sourceType     String?
  sourceId       String?
  createdAt      DateTime                 @default(now())
  valuationEntry InventoryValuationEntry?
  costedLines    OrderItem[]              @relation("OrderItemCostMovement")

  @@index([variantId])
  @@index([reason])
  @@index([createdAt])
  @@index([sourceType, sourceId])
}

/// A ledger entry for money the store loses to courier round-trips it can't recover — logged
/// automatically by updateOrderStatus (CANCELLED after a consignment was booked) and
/// reconcilePartialDelivery (a partial-delivery return) in order.service.ts. `amount` is an
/// admin-configured estimate (StoreSetting.courierReturnFeeDhaka/OutsideDhaka, zone-matched to
/// the order's shippingDivision) rather than a real figure from Steadfast — their API exposes no
/// per-order fee, only a merchant wallet balance (see lib/steadfast.ts).
model CourierLossEvent {
  id        String            @id @default(cuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Decimal           @db.Decimal(10, 2)
  reason    CourierLossReason
  createdAt DateTime          @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model FlashSale {
  id             String          @id @default(cuid())
  name           String
  startsAt       DateTime
  endsAt         DateTime
  /// The admin's switch. A disabled sale is never live, whatever its window; the scheduler never changes this.
  enabled        Boolean         @default(true)
  /// Derived cache of "live right now" = enabled && startsAt <= now <= endsAt, written only by
  /// flash-sale.service.ts (on every admin write, and by the scheduler each minute). Never set it by hand.
  isActive       Boolean         @default(false)
  bannerImageUrl String?
  items          FlashSaleItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model FlashSaleItem {
  id            String     @id @default(cuid())
  flashSaleId   String
  flashSale     FlashSale  @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountType  CouponType
  discountValue Decimal    @db.Decimal(10, 2)
  stockLimit    Int?
  createdAt     DateTime   @default(now())

  @@unique([flashSaleId, productId])
  @@index([productId])
}

model Banner {
  id             String          @id @default(cuid())
  placement      BannerPlacement @default(HERO_CAROUSEL)
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String?
  title          String?
  subtitle       String?
  /// Image alt text, independent of `title` — a banner can be purely visual (no title/subtitle
  /// copy shown on top of it) yet still needs a real description for accessibility/image search;
  /// falls back to `title` on the frontend when left blank.
  altText        String?
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([placement, isActive])
}

/// Ordered list of blocks rendered on the storefront homepage — lets the admin builder reorder,
/// toggle, and configure sections without a code change. `config` shape depends on `type`; validated
/// in packages/shared/src/schemas/homepage-section.ts, not by Prisma. See HomepageSectionType for
/// which types are singletons vs repeatable.
model HomepageSection {
  id        String              @id @default(cuid())
  type      HomepageSectionType
  sortOrder Int                 @default(0)
  isActive  Boolean             @default(true)
  config    Json                @default("{}")
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([isActive, sortOrder])
}

/// The Storefront Studio's working copy of the homepage: one document, edited and autosaved by the admin, applied to
/// HomepageSection rows on publish. `version` guards against two editors overwriting each other.
model HomepageDraft {
  id          String   @id @default("homepage")
  version     Int      @default(0)
  /// The working copy; null once it has been published or discarded (the row stays so `version` keeps counting).
  sections    Json?
  /// The site design being edited with it (theme, announcement bar, header, footer); null with `sections`.
  design      Json?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// A published homepage (the sections as they went live), for the Studio's history and one-click restore.
model HomepageRevision {
  id              String   @id @default(cuid())
  sections        Json
  /// The site design as it went live with these sections (null on revisions from before the design existed).
  design          Json?
  publishedById   String?
  publishedByName String?
  publishedAt     DateTime @default(now())

  @@index([publishedAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Submitted from the storefront's floating contact widget. Public/anonymous like
// NewsletterSubscriber (no customer/order relation) — readAt follows the same "null = unread"
// convention as Notification instead of a status enum.
model Feedback {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
}

enum ConversationChannel {
  WEB_FORM
  EMAIL
  SMS
  WHATSAPP
  MESSENGER
  INSTAGRAM
  /// A comment on a Facebook post or ad; a reply goes back as a comment (or as a private Messenger reply).
  FB_COMMENT
}

/// Who wrote a message. PHONE = staff replying outside the Inbox (WhatsApp app / Page inbox), seen as a webhook echo.
enum MessageAuthor {
  CUSTOMER
  STAFF
  AI
  PHONE
}

enum ConversationStatus {
  OPEN
  HANDLED
}

enum MessageDirection {
  IN
  OUT
}

/// Admin V2 Inbox R2 (DR-4): one thread with a customer, whatever channel it arrived on. The Inbox binds to this, never
/// to a provider. Website contact-form messages are channel WEB_FORM (Feedback rows were backfilled; new ones land here).
model Conversation {
  id            String                @id @default(cuid())
  channel       ConversationChannel
  subject       String
  contactName   String
  email         String?
  phone         String?
  customerId    String?
  customer      Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status        ConversationStatus    @default(OPEN)
  /// Who is handling it (Blueprint V2 Inbox "assignment"); null = nobody yet.
  assignedToId  String?
  assignedTo    AdminUser?            @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  /// The Feedback row this thread was backfilled from (provenance only).
  feedbackId    String?               @unique
  /// The thread's id at Meta: WhatsApp number (wa_id), Messenger PSID, Instagram IGSID, or the top-level comment id.
  externalThreadId String?
  /// The customer's last message — Meta's reply window counts from it (shared replyWindow()).
  lastInboundAt DateTime?
  /// FB_COMMENT: the post (or ad post) the comment is on.
  postId        String?
  messages      ConversationMessage[]
  draft         ConversationDraft?

  @@unique([channel, externalThreadId])
  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
  @@index([assignedToId])
}

/// One message in a conversation. An OUT message is sent by the `conversation-reply` outbox consumer (eventKey = this id);
/// its delivery state is that outbox row's status. The consumer writes back only `externalId` (Meta's id for what it
/// sent), so the webhook echo of our own send is recognised as a duplicate.
model ConversationMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  /// How it travelled: WEB_FORM for an incoming contact-form message; EMAIL or SMS for a reply.
  channel        ConversationChannel
  body           String
  adminId        String?
  admin          AdminUser?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  author         MessageAuthor       @default(CUSTOMER)
  /// Meta's message id (wamid / mid / comment id): a webhook delivered twice is stored once.
  externalId     String?             @unique
  /// A WhatsApp template reply (outside the 24-hour window): { name, language, params, named }. `body` holds its text.
  template       Json?
  /// Sent from the saved-answer library (no AI call) — counted as "answered without AI".
  savedAnswerId  String?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([savedAnswerId, createdAt])
}

enum SavedAnswerStatus {
  /// Learned from repeated replies; waits for a person to approve it.
  SUGGESTED
  /// Answers matching questions without the AI.
  APPROVED
  DISMISSED
}

/// The Inbox's answer library: a question customers keep asking and the reply that answers it. Learned from replies staff
/// (and the AI) send again and again; once approved it answers the same question — however it is typed — without an AI
/// call. `answer` may hold live placeholders ({delivery_charges}, {delivery_time}, {cod}, {website}, {store_name}, {name}).
model SavedAnswer {
  id           String            @id @default(cuid())
  status       SavedAnswerStatus @default(SUGGESTED)
  /// A representative question, shown as the answer's name.
  title        String
  answer       String
  /// Send on its own (still subject to the Inbox AI's auto-send switch and guards); otherwise a draft for staff.
  autoSend     Boolean           @default(false)
  /// Times it answered (sent automatically, or its draft was sent unchanged).
  hits         Int               @default(0)
  /// Times staff rewrote its draft before sending — enough of these pauses auto-send.
  corrections  Int               @default(0)
  lastHitAt    DateTime?
  /// Set when corrections paused auto-send by themselves.
  autoPausedAt DateTime?
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  examples     AnswerExample[]

  @@index([status])
}

/// One customer question and the reply that answered it (the material saved answers are learned from).
model AnswerExample {
  id            String        @id @default(cuid())
  question      String
  /// The question's canonical words (answers/text-match.ts normalizeQuestion), space-separated.
  normalized    String
  answer        String
  source        MessageAuthor
  /// The reply message this was learned from.
  messageId     String        @unique
  savedAnswerId String?
  savedAnswer   SavedAnswer?  @relation(fields: [savedAnswerId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@index([savedAnswerId])
  @@index([createdAt])
}

/// The AI's suggested reply to a conversation's latest message (one per conversation; a newer one replaces it).
/// Staff send it as-is or edit it; any reply removes it.
model ConversationDraft {
  id               String       @id @default(cuid())
  conversationId   String       @unique
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  body             String
  /// What the customer asked, as the AI classified it (price, stock, delivery_charge, order_status, how_to_order, other).
  intent           String
  basedOnMessageId String
  /// The draft came from a saved answer (not the AI) — staff rewriting it counts as a correction.
  savedAnswerId    String?
  createdAt        DateTime     @default(now())
}

model WishlistItem {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Product's basePrice at the moment it was wishlisted — the baseline a real price drop is measured against.
  priceAtAdd Decimal?  @db.Decimal(10, 2)
  /// Set once a price-drop email has been sent for this entry, so it's never re-sent for the same drop.
  alertedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

/// System-generated admin alerts (new order, low stock, ...) shown via the bell icon in the admin
/// topbar — distinct from the per-action toasts, which are immediate feedback on the action you just took.
model Notification {
  id        String             @id @default(cuid())
  type      String
  title     String
  body      String?
  link      String?
  /// Legacy store-wide read flag (before DR-15). Read state is per admin now (NotificationRead); kept so old rows and
  /// rollbacks stay meaningful, never written by the app.
  readAt    DateTime?
  createdAt DateTime           @default(now())
  reads     NotificationRead[]

  @@index([readAt, createdAt])
  @@index([createdAt])
}

enum AiProposalStatus {
  PENDING
  EXECUTED
  CANCELLED
  FAILED
}

/// Blueprint V2 §T / DR-23: a change the AI assistant prepared. It runs only when an admin with ai.execute confirms it,
/// within 10 minutes, and only if what it was previewed against hasn't changed (`previewHash`).
model AiProposal {
  id          String           @id @default(cuid())
  adminId     String
  tool        String
  input       Json
  title       String
  effects     Json
  previewHash String
  status      AiProposalStatus @default(PENDING)
  result      Json?
  expiresAt   DateTime
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())
  admin       AdminUser        @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
}

/// Admin V2 DR-18: a named filter set for one admin list (its URL query), kept per admin across devices; `shared`
/// shows it to the whole team.
model SavedView {
  id        String    @id @default(cuid())
  adminId   String
  listKey   String
  label     String
  query     String
  shared    Boolean   @default(false)
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([listKey, adminId])
  @@index([listKey, shared])
}

/// Admin V2 DR-15: who has read which notification — one admin reading it no longer clears it for the whole team.
model NotificationRead {
  notificationId String
  adminId        String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin          AdminUser    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([notificationId, adminId])
  @@index([adminId])
}

/// Single-row store configuration — always read/written via id "singleton". Fields not yet wired
/// into a live consumer are documented at the call site, not silently unused.
model StoreSetting {
  id                           String   @id @default("singleton")
  storeName                    String   @default("Store")
  tagline                      String?
  logoUrl                      String?
  logoOnDarkUrl                String?
  faviconUrl                   String?
  currency                     String   @default("BDT")
  /// IANA timezone of the store's business day (metrics, "today", reports) — docs/METRICS_REGISTRY.md §1. Phase 5.
  timezone                     String   @default("Asia/Dhaka")
  contactEmail                 String?
  contactPhone                 String?
  shippingFeeDhaka             Decimal  @default(60) @db.Decimal(10, 2)
  shippingFeeOutsideDhaka      Decimal  @default(120) @db.Decimal(10, 2)
  /// Estimated round-trip courier fee lost on a post-booking cancellation or partial-delivery
  /// return, zone-matched the same way as shippingFeeDhaka/OutsideDhaka above — Steadfast's API
  /// never exposes a real per-order fee (see lib/steadfast.ts), so this is an admin-entered
  /// estimate (their actual return-fee rate) used only to total up CourierLossEvent rows for the
  /// dashboard's "courier cancellation loss" figure, not billed or charged anywhere.
  courierReturnFeeDhaka        Decimal  @default(60) @db.Decimal(10, 2)
  courierReturnFeeOutsideDhaka Decimal  @default(120) @db.Decimal(10, 2)
  taxEnabled                   Boolean  @default(false)
  defaultTaxRate               Decimal? @db.Decimal(5, 2)
  rewardPointsPerCurrency      Decimal  @default(0) @db.Decimal(10, 4)
  /// Prefill text appended to the active WHATSAPP SocialLink's URL as a `text` query param — the
  /// number/enable-state itself stays sourced from SocialLink (see comment above SocialLink) so
  /// there's exactly one place admins manage the WhatsApp destination.
  whatsappMessage              String?
  whatsappLabel                String   @default("WhatsApp")
  callEnabled                  Boolean  @default(false)
  callLabel                    String   @default("Call Us")
  /// Live Chat: Tawk.to. Kept DB-driven (unlike the old NEXT_PUBLIC_TAWKTO_* env vars) so it can be
  /// toggled without a rebuild; see apps/web/components/storefront/live-chat-widget.tsx.
  liveChatEnabled              Boolean  @default(false)
  liveChatLabel                String   @default("Live Chat")
  tawkPropertyId               String?
  tawkWidgetId                 String?
  /// A single combined "we accept" graphic (all payment logos already laid out in one image) as an
  /// alternative to managing individual PaymentMethodOption rows — when set, the footer/checkout
  /// show this instead of the per-method list, since some admins would rather upload one banner
  /// than add each logo separately.
  paymentMethodsImageUrl       String?
  /// Per-method checkout toggles — lets the store owner turn Cash on Delivery or the online gateway
  /// off entirely (e.g. during a COD abuse spike, or while SSLCommerz credentials are being rotated)
  /// without touching code. Both default on; enforced both in the checkout UI and server-side in
  /// order.service.ts so a stale page can't submit a disabled method.
  codEnabled                   Boolean  @default(true)
  onlinePaymentEnabled         Boolean  @default(true)
  /// Gates the EPS-PG checkout option, kept separate from onlinePaymentEnabled (which gates
  /// SSLCommerz) so either gateway can be toggled independently — e.g. turning EPS off while its
  /// credentials are being rotated without touching SSLCommerz or COD. Defaults off since it stays
  /// unusable until EPS sandbox/live credentials are entered via the EPS_* env vars.
  epsPaymentEnabled            Boolean  @default(false)
  /// The content= value Google Search Console gives you for the HTML-tag verification method —
  /// pasted here and rendered as a <meta name="google-site-verification"> tag on every page,
  /// rather than requiring a file upload or DNS change to prove domain ownership.
  googleSiteVerification       String?
  /// Phase 12 (D-1/D-2): the rest of the store's identity, owned here like name/logo/contact (Phase 7 — StoreSetting is
  /// the identity owner; there is deliberately no separate StoreProfile). All optional; the storefront renders each
  /// only when set. Domain/URLs stay deployment configuration (env), never here (D-3).
  legalName                    String?
  addressLine                  String?
  addressCity                  String?
  addressRegion                String?
  addressPostalCode            String?
  /// ISO 3166-1 alpha-2 (e.g. "BD").
  addressCountry               String?
  /// Governing-law jurisdiction named on the Terms page (e.g. "Bangladesh").
  legalJurisdiction            String?
  supportHours                 String?
  /// Store policy (Phase 5) — read through @clothing-brand/shared store-policy.ts by the product page, the Shipping &
  /// Returns page, the FAQ and the Product structured data. Null = the store makes no such claim.
  /// Days a customer has to return or exchange an item (null: no return window is stated).
  returnWindowDays             Int?
  /// What a returned item must be, as a sentence subject: "Unworn items in original condition with tags attached".
  returnConditions             String?
  /// Business days between an order and its dispatch.
  handlingDaysMin              Int?
  handlingDaysMax              Int?
  // Store content (Phase 7): the default social-sharing image, the homepage's search title/description, newsletter copy.
  ogImageUrl                   String?
  seoTitle                     String?
  seoDescription               String?
  newsletterHeading            String?
  newsletterText               String?
  /// Storefront Studio → Site design, as published: theme choices, announcement bar, header and footer
  /// (packages/shared storefront-design.ts). Written only by the Studio's publish.
  storefrontDesign             Json?
  updatedAt                    DateTime @updatedAt
}

/// Admin-only SMS notification config — kept separate from StoreSetting because settingsRouter's
/// GET / is public (the storefront reads it directly) and adminAlertPhones must never be exposed
/// through that endpoint. Same lazy-create singleton pattern as StoreSetting.
model SmsNotificationSetting {
  id                                   String   @id @default("singleton")
  /// Comma-separated local "01XXXXXXXXX" numbers — a shop owner may want alerts on more than one
  /// phone, so this stays one column rather than a related table (same simplicity level as other
  /// single-purpose fields on StoreSetting).
  adminAlertPhones                     String   @default("")
  adminOrderAlertEnabled               Boolean  @default(true)
  customerOrderPlacedEnabled           Boolean  @default(true)
  customerOrderConfirmedEnabled        Boolean  @default(true)
  customerOrderShippedEnabled          Boolean  @default(true)
  customerOrderDeliveredEnabled        Boolean  @default(true)
  customerOrderCancelledEnabled        Boolean  @default(true)
  /// Separate from the SMS toggles above (this one gates an email, not an SMS) but kept on this
  /// same admin-only settings row rather than the public StoreSetting — same non-public reasoning
  /// as adminAlertPhones. Fires from settlePaymentSession's success branch (payment.service.ts),
  /// gated on both this flag and Order.customerEmail being present.
  customerPaymentConfirmedEmailEnabled Boolean  @default(true)
  /// Admin-editable message text, with {customerName}/{orderNumber}/{total}/{storeName}
  /// placeholders — null means "use the built-in default" (packages/shared/src/sms-templates.ts),
  /// not "send nothing" (that's what the matching *Enabled toggle above is for).
  customerOrderPlacedTemplate          String?
  customerOrderConfirmedTemplate       String?
  customerOrderShippedTemplate         String?
  customerOrderDeliveredTemplate       String?
  customerOrderCancelledTemplate       String?
  updatedAt                            DateTime @updatedAt
}

/// Reusable marketing SMS templates (Welcome, Eid Offer, ...) an admin picks from when messaging a
/// customer individually or in bulk (see customer.service.ts's sendAdHocSmsToCustomer /
/// sendBulkSmsToCustomers). Uses {{variable}} placeholders (packages/shared/src/customer-sms-templates.ts)
/// — a different vocabulary/syntax from SmsNotificationSetting's {placeholder} order-touchpoint
/// templates above, since these are customer-level (name/spend/last order), not order-level.
model SmsTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Admin-managed payment method badges (bKash, Nagad, Visa, ...) shown in the footer and at
/// checkout. Logo images are uploaded via processPaymentMethodLogo, same pattern as
/// Category.imageUrl / StoreSetting.logoUrl (plain URL string, no separate media table). Named
/// "...Option" (not just "PaymentMethod") since that name is already taken by the COD/SSLCOMMERZ
/// enum used on Order.paymentMethod.
model PaymentMethodOption {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TIKTOK
  LINKEDIN
  X
  WHATSAPP
  OTHER
}

/// Admin-managed social links shown as icons in the storefront footer — replaces the old fixed
/// facebookUrl/instagramUrl/whatsappNumber columns on StoreSetting so any number of platforms
/// (including a free-form OTHER entry) can be added, reordered, or removed without a migration.
model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  url       String
  /// Display label — required when platform is OTHER (no built-in icon/name to fall back to).
  label     String?
  sortOrder Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([isActive, sortOrder])
}

/// Admin-managed URL redirect (e.g. after a product/category slug change) — exact-path match only,
/// no wildcard/regex rules. Enforced in apps/web/middleware.ts against the public /active endpoint.
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

enum CampaignChannel {
  EMAIL
  SMS
  PUSH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
}

/// A saved audience filter (e.g. "no order in 30 days", "has ordered at least once") that a
/// Campaign targets. `filter` is interpreted by the campaign service rather than modeled as
/// columns, so new filter types don't require a migration.
model Segment {
  id        String     @id @default(cuid())
  name      String
  filter    Json
  campaigns Campaign[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// A one-off or scheduled send (email/SMS/push) to a Segment. Delivery to each recipient is
/// tracked as its own CampaignRecipient row rather than a single campaign-level status, so a
/// partial failure is visible per-customer and retryable without resending to everyone.
model Campaign {
  id          String              @id @default(cuid())
  name        String
  channel     CampaignChannel
  status      CampaignStatus      @default(DRAFT)
  subject     String?
  body        String
  segmentId   String?
  segment     Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  CampaignRecipient[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, scheduledAt])
}

model CampaignRecipient {
  id           String                  @id @default(cuid())
  campaignId   String
  campaign     Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status       CampaignRecipientStatus @default(PENDING)
  sentAt       DateTime?
  error        String?
  /// The actual per-recipient text sent, after {{variable}} substitution (see
  /// customer-sms-templates.ts) — null for real Campaign sends, whose body has no per-customer
  /// variables yet. Falls back to campaign.body when absent (see getCustomerDetailAdmin's smsHistory).
  renderedBody String?
  createdAt    DateTime                @default(now())

  @@unique([campaignId, customerId])
  @@index([customerId])
}

/// A customer's registered browser for Web Push. `p256dh`/`auth` are the subscription's
/// encryption keys, as returned by PushManager.subscribe() in the browser.
model PushSubscription {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

enum TaxMode {
  INCLUSIVE
  EXCLUSIVE
}

/// The centralised tax configuration (D3, D10) — the one authority the tax engine reads. Singleton "singleton".
/// StoreSetting.taxEnabled/defaultTaxRate are legacy mirrors kept in sync by settings.service (dual-write) until the
/// contract phase; nothing prices from them.
model TaxSetting {
  id              String   @id @default("singleton")
  enabled         Boolean  @default(false)
  mode            TaxMode  @default(INCLUSIVE)
  /// Store VAT rate in percent.
  defaultRate     Decimal? @db.Decimal(5, 2)
  /// D10: shipping carries VAT (inclusive by default, at the store rate unless shippingRate is set).
  shippingTaxable Boolean  @default(true)
  shippingRate    Decimal? @db.Decimal(5, 2)
  updatedAt       DateTime @updatedAt
}

enum ShippingZoneMatchField {
  POSTCODE
  DISTRICT
  DIVISION
}

/// A delivery zone (Phase 2 — replaces the hard-coded "Dhaka district vs. elsewhere" rule). Resolution: the matching
/// active zone with the highest priority, then the most specific match rule; else the default zone.
model ShippingZone {
  id        String              @id @default(cuid())
  key       String              @unique
  name      String
  priority  Int                 @default(0)
  isDefault Boolean             @default(false)
  isActive  Boolean             @default(true)
  matches   ShippingZoneMatch[]
  rate      ShippingRate?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model ShippingZoneMatch {
  id     String                 @id @default(cuid())
  zoneId String
  zone   ShippingZone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  field  ShippingZoneMatchField
  value  String

  @@unique([zoneId, field, value])
  @@index([field, value])
}

/// The authoritative shipping fee of a zone. StoreSetting.shippingFeeDhaka/OutsideDhaka are legacy mirrors of the two
/// seeded zones, dual-written by settings.service until the contract phase.
model ShippingRate {
  id             String       @id @default(cuid())
  zoneId         String       @unique
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  fee            Decimal      @db.Decimal(10, 2)
  /// Free shipping when merchandise after discounts reaches this amount; null = never.
  freeOverAmount Decimal?     @db.Decimal(10, 2)
  updatedAt      DateTime     @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog configuration: product types, templates, attribute definitions, presets.
// Everything below is admin-editable data — adding a product type needs no code change.
// (`Attribute`/`AttributeValue` above are the *variant option* system — Color, Fabric — and are unrelated.)
// ─────────────────────────────────────────────────────────────────────────────

/// A kind of product ("Panjabi", "Watch"). Identity and grouping only — the fields, size guide and variant
/// dimensions come from its template, so several types can share one.
model ProductTypeDef {
  id          String           @id @default(cuid())
  /// Stable machine key. System types use their legacy enum value ("CLOTHING"); admin-created ones a slug.
  key         String           @unique
  name        String
  description String?
  /// Optional family ("Apparel" -> "Panjabi"); purely organisational.
  parentId    String?
  parent      ProductTypeDef?  @relation("ProductTypeFamily", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductTypeDef[] @relation("ProductTypeFamily")
  templateId  String
  template    ProductTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// Value mirrored into Product.productType (CUSTOM for admin-created types).
  legacyType  ProductType      @default(CUSTOM)
  /// Seeded from the original hard-coded list. Can be edited or archived, never deleted.
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  /// Short code used by the SKU generator's {TYPE} token ("PNJ"). Falls back to the first letters of the name.
  skuCode     String?
  products    Product[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([templateId])
  @@index([parentId])
}

/// The reusable bundle of configuration a type points at: which attributes it collects, how variants are
/// dimensioned, and which size guide it uses.
model ProductTemplate {
  id                String              @id @default(cuid())
  name              String              @unique
  description       String?
  /// At most two entries — [{ targetField: "size" | "color", label, options[] }]. They map onto the
  /// denormalised ProductVariant.size / .color columns that carts, orders and storefront filters read.
  variantDimensions Json                @default("[]")
  sizeGuideMode     SizeGuideMode       @default(NOT_APPLICABLE)
  sizeGuidePresetId String?
  sizeGuidePreset   SizeGuidePreset?    @relation(fields: [sizeGuidePresetId], references: [id], onDelete: SetNull)
  /// Default care steps for products of this template (a product can pick another preset or write its own).
  carePresetId      String?
  carePreset        CareGuidePreset?    @relation(fields: [carePresetId], references: [id], onDelete: SetNull)
  /// Completeness check keys that must pass before a product of this template can be READY/PUBLISHED, on top of
  /// the always-required basics (see COMPLETENESS_CHECKS in packages/shared).
  requiredChecks    String[]            @default([])
  isArchived        Boolean             @default(false)
  attributes        TemplateAttribute[]
  sections          TemplateSection[]
  types             ProductTypeDef[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([sizeGuidePresetId])
  @@index([carePresetId])
}

/// A reusable product field ("Embroidery Type", "Movement").
model AttributeDefinition {
  id          String                      @id @default(cuid())
  /// The key values are stored and served under (`attributes.embroideryType`). Immutable once created.
  key         String                      @unique
  label       String
  dataType    AttributeDataType
  /// Shown next to MEASUREMENT / NUMBER values ("cm", "ATM").
  unit        String?
  placeholder String?
  helpText    String?
  isArchived  Boolean                     @default(false)
  options     AttributeDefinitionOption[]
  templates   TemplateAttribute[]
  values      ProductAttributeValue[]
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
}

model AttributeDefinitionOption {
  id           String              @id @default(cuid())
  definitionId String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  value        String
  sortOrder    Int                 @default(0)

  @@unique([definitionId, value])
}

/// A named block of specification rows on the product page ("Watch Details"). Reusable across templates.
model SpecGroup {
  id        String              @id @default(cuid())
  name      String              @unique
  sortOrder Int                 @default(0)
  items     TemplateAttribute[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

/// Puts an attribute definition on a template, with its per-template settings.
model TemplateAttribute {
  id               String              @id @default(cuid())
  templateId       String
  template         ProductTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  definitionId     String
  definition       AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  required         Boolean             @default(false)
  sortOrder        Int                 @default(0)
  specGroupId      String?
  specGroup        SpecGroup?          @relation(fields: [specGroupId], references: [id], onDelete: SetNull)
  /// Overrides the definition's placeholder for this template only ("Genuine Leather" vs "100% Cotton").
  placeholder      String?
  showOnStorefront Boolean             @default(true)

  @@unique([templateId, definitionId])
  @@index([definitionId])
  @@index([specGroupId])
}

/// One product's value for one attribute. Typed columns (not a JSON blob) so values can be filtered,
/// faceted and validated against the definition.
model ProductAttributeValue {
  id           String              @id @default(cuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definitionId String
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  /// TEXT, TEXTAREA, RICH_TEXT, URL and the chosen SELECT option.
  valueText    String?
  /// NUMBER and MEASUREMENT (the unit comes from the definition).
  valueNumber  Decimal?            @db.Decimal(14, 4)
  valueBoolean Boolean?
  valueDate    DateTime?
  /// MULTI_SELECT: string[].
  valueJson    Json?
  updatedAt    DateTime            @updatedAt

  @@unique([productId, definitionId])
  @@index([definitionId, valueText])
}

/// A reusable size chart. Columns and rows are JSON because their shape genuinely differs per product
/// kind (cap: head circumference; shoe: EU/UK/US + foot length; apparel: chest/waist/length).
model SizeGuidePreset {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  /// e.g. "inch", "cm (foot length)".
  unit        String?
  /// string[] — column headings.
  columns     Json
  /// string[][] — every row has exactly columns.length cells (enforced on write).
  rows        Json
  notes       String?
  isArchived  Boolean           @default(false)
  templates   ProductTemplate[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// Reusable care instructions ("Cotton care"). `steps` is a string[] because a care guide is an ordered list of
/// lines and is only ever read and written whole.
model CareGuidePreset {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  steps       Json
  isArchived  Boolean           @default(false)
  templates   ProductTemplate[]
  products    Product[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// A named material ("Premium Cotton", "Genuine Leather"). Relational so products can be found by material.
model Material {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  isArchived  Boolean           @default(false)
  products    ProductMaterial[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// One line of a product's composition: a catalog material or a product-specific custom name, optionally
/// with a percentage ("80% Cotton"). A CHECK constraint (see the migration) requires one of the two names.
/// "Also show in" — a product listed in a category other than its home one (Product.categoryId). Storefront browsing,
/// facets and category stock counts match either; everything that needs one answer (breadcrumb, coupon/bundle scope,
/// order snapshots, reports) keeps using the home category.
model ProductCategoryListing {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductMaterial {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  customName String?
  percentage Decimal?  @db.Decimal(5, 2)
  sortOrder  Int       @default(0)

  @@index([productId])
  @@index([materialId])
}

/// Catalog-wide settings, one row ("singleton"), created on first read like StoreSetting.
model CatalogSetting {
  id         String   @id @default("singleton")
  /// The {PREFIX} token of the SKU pattern.
  skuPrefix  String   @default("SKU")
  /// Tokens: {PREFIX} {TYPE} {COLOR} {SIZE} {SEQ:n} (n = zero-padded digits). Validated on write.
  skuPattern String   @default("{PREFIX}-{TYPE}-{COLOR}-{SIZE}-{SEQ:3}")
  updatedAt  DateTime @updatedAt
}

/// PRODUCT: applies to products it is ticked on (directly or through their category). DISCOUNT: applies on its own to any
/// order with a line discounted at least `minDiscountPercent` off its "was" price.
enum CourierNoteTrigger {
  PRODUCT
  DISCOUNT
}

/// A store-defined instruction for the courier ("পারফিউম — প্যাকেট খোলা যাবে না"), managed from Catalog → Courier notes.
/// When an order is booked, the texts of every rule that applies to it are joined into the parcel note.
model CourierNoteRule {
  id                 String             @id @default(cuid())
  /// Staff-facing name shown next to the checkbox ("Perfume", "Fragile").
  name               String
  /// What the courier sees.
  text               String
  trigger            CourierNoteTrigger @default(PRODUCT)
  /// DISCOUNT rules only: the smallest line discount (percent) that triggers it.
  minDiscountPercent Int?
  isActive           Boolean            @default(true)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

/// Atomic per-scope counters behind the SKU generator's {SEQ} token (scope = the product type's SKU code).
model SkuCounter {
  scope String @id
  next  Int    @default(1)
}

// ─────────────────────────────────────────────────────────────────────────────
// Product-page sections. The set of sections is a code registry (each has a renderer); these tables only hold the
// admin's choices. Every field is nullable so a row can override just one thing (say, the title) and inherit the
// rest: resolution is product -> template -> global -> the registry default, field by field. Three tables rather than
// one polymorphic one so a deleted product/template takes its rows with it (real foreign keys).
// ─────────────────────────────────────────────────────────────────────────────

/// Store-wide defaults ("Shipping & Returns" text, which sections are on, their order).
model GlobalSection {
  sectionKey String   @id
  enabled    Boolean?
  sortOrder  Int?
  title      String?
  /// Text or HTML for text-type sections (shipping, returns, warranty), one-per-line for list-type ones, a URL for video.
  content    String?  @db.Text
  updatedAt  DateTime @updatedAt
}

/// Overrides for every product of a template.
model TemplateSection {
  id         String          @id @default(cuid())
  templateId String
  template   ProductTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  sectionKey String
  enabled    Boolean?
  sortOrder  Int?
  title      String?
  content    String?         @db.Text
  updatedAt  DateTime        @updatedAt

  @@unique([templateId, sectionKey])
}

/// Overrides for one product — and the home of that product's own text (highlights, what's included, video URL, warranty).
model ProductSection {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sectionKey String
  enabled    Boolean?
  sortOrder  Int?
  title      String?
  content    String?  @db.Text
  updatedAt  DateTime @updatedAt

  @@unique([productId, sectionKey])
}

model ProductFaq {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  question  String
  answer    String  @db.Text
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

/// A hand-picked product shown in one of a product's recommendation lists. When a list has none, the storefront
/// falls back to the existing algorithm for that list, so an untouched product looks exactly as before.
model ProductRelation {
  id        String              @id @default(cuid())
  productId String
  product   Product             @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedId String
  related   Product             @relation("RelatedToProducts", fields: [relatedId], references: [id], onDelete: Cascade)
  kind      ProductRelationKind
  sortOrder Int                 @default(0)

  @@unique([productId, relatedId, kind])
  @@index([productId, kind, sortOrder])
  @@index([relatedId])
}

/// Storefront read model (Phase 3, docs/STOREFRONT_READ_MODEL.md). A PROJECTION of the canonical pricing engine's
/// display price (`priceProductsForDisplay` → `resolveUnitPrice`, the same function every quote uses), kept only so
/// SQL can sort, filter and pick price-neighbours. Never authoritative: prices shown or charged are always computed
/// live; this row is only ever written by domain/storefront/read-model.service.ts and can be rebuilt from scratch at
/// any time. Staleness is detectable from the columns below (see the guard in read-model.service.ts).
model ProductReadModel {
  productId        String    @id
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Lowest current selling price over the product's active variants (= ProductPricing.from).
  minSellingPrice  Decimal   @db.Decimal(10, 2)
  /// Highest current selling price over the active variants (= ProductPricing.to).
  maxSellingPrice  Decimal   @db.Decimal(10, 2)
  /// List price of the variant that sets minSellingPrice (= ProductPricing.listFrom).
  listPriceOfMin   Decimal   @db.Decimal(10, 2)
  hasLiveFlashSale Boolean
  currency         String
  /// PRICING_VERSION the row was computed with — a mismatch marks it stale.
  pricingVersion   Int
  /// md5 fingerprint of every input that decides the selling price (base/compare-at price, each variant's price,
  /// compare-at and active flag, each flash-sale item's terms and its sale's switch and window), computed by the same
  /// SQL the freshness guard uses. Content-based on purpose: no clock (updatedAt is written in two timezones by
  /// different code paths), and a deleted variant or flash item changes it too.
  sourceHash       String
  /// Next instant the price can change on the clock alone (a flash sale starting or ending); null = none scheduled.
  validUntil       DateTime?
  /// A live flash offer with a stock limit prices this product: quota can change with any order, so the row is
  /// recomputed on every guarded read (D4).
  volatile         Boolean   @default(false)
  computedAt       DateTime

  @@index([minSellingPrice])
  @@index([validUntil])
  @@index([volatile])
}

/// Phase 8 (docs/PHASE_8_AUDIT.md) — delivery state of one outbox row.
enum OutboxStatus {
  PENDING
  ENQUEUED
  PROCESSING
  PROCESSED
  FAILED
}

/// Transactional outbox (Phase 8): the durable INTENT to perform one external side effect, written in the same
/// transaction as the business change it follows — never business truth itself. One row per (consumer, eventKey), so a
/// producer can't record the same intent twice. Written only by domain/outbox/outbox.ts; delivered by the dispatcher
/// (→ BullMQ) and the worker (domain/outbox/processor.ts), at least once, to idempotent consumers.
model OutboxEvent {
  id            String       @id @default(cuid())
  /// Versioned business event the intent follows, e.g. "order.placed.v1" (the version governs the payload shape).
  eventType     String
  /// The single consumer that performs the side effect, e.g. "customer-order-sms".
  consumer      String
  /// Business idempotency key, e.g. "order:<id>:placed" — unique per consumer.
  eventKey      String
  aggregateType String
  aggregateId   String
  /// Minimal, versioned, secret-free payload (ids + what the consumer can't re-read later).
  payload       Json
  status        OutboxStatus @default(PENDING)
  /// Processing attempts made (dispatch/enqueue attempts don't count).
  attempts      Int          @default(0)
  /// Not before this instant (retry backoff).
  availableAt   DateTime     @default(now())
  /// Lease of whoever holds the row right now (dispatcher claim, or worker while PROCESSING).
  claimedUntil  DateTime?
  enqueuedAt    DateTime?
  processedAt   DateTime?
  lastError     String?
  /// Phase 11: the correlation ID of the request that recorded this intent (observability only — never business data).
  correlationId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([consumer, eventKey])
  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// FINANCIAL CORE — Phase 1 (docs/FINANCE_PHASE_1.md). The ledger of the BUSINESS (one business, several brands). Every
// journal is written by apps/api/src/domain/finance/journal.service.ts only (architecture guard). Database triggers
// (migration 20261011100000_finance_phase1_foundation) enforce: posted journals are immutable and balanced, lines post only
// to active postable accounts of the same business, nothing posts into a CLOSED period or before the opening date, and
// every change to a finance record commits together with its FinanceAuditEntry. Actor columns are plain ids (history
// outlives an admin account). Money: Decimal(18,2) major units of the business currency.
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

enum LedgerNormalBalance {
  DEBIT
  CREDIT
}

/// How an amount that depends on product cost was valued. KNOWN = a recorded cost (order-line snapshot, supplier invoice);
/// ESTIMATED = an owner estimate or the current catalog cost; MISSING = no cost exists (valued at 0, flagged); OPENING_BALANCE =
/// carried in from the opening inventory count.
enum FinanceValuationStatus {
  KNOWN
  ESTIMATED
  MISSING
  OPENING_BALANCE
}

enum FinancialAccountKind {
  CASH
  BANK
  MOBILE_WALLET
  PAYMENT_GATEWAY
  COURIER
  OTHER
  /// Owner's books (docs/FINANCE_OWNER_BOOKS.md §5): an ad account (Meta, TikTok…) — money paid in, ad spend taken out.
  AD_PLATFORM
}

enum FinancialPeriodStatus {
  OPEN
  SOFT_CLOSED
  CLOSED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum JournalEntryKind {
  MANUAL
  OPENING_BALANCE
  EVENT
  REVERSAL
  CORRECTION
  TREASURY
  /// A system adjustment that is its own document (Phase 4C valuation cutover).
  ADJUSTMENT
}

enum FinancialEventStatus {
  RECEIVED
  POSTED
  FAILED
  IGNORED
}

enum FinanceActorType {
  ADMIN
  SYSTEM
}

enum OpeningBalanceStatus {
  DRAFT
  POSTED
}

enum OpeningBalanceCategory {
  CASH
  BANK
  MOBILE_WALLET
  PAYMENT_ACCOUNT
  INVENTORY
  RECEIVABLE
  PAYABLE
  LOAN
  FIXED_ASSET
  CAPITAL
  OTHER_ASSET
  OTHER_LIABILITY
  OTHER_EQUITY
}

enum OpeningInventoryConfidence {
  HIGH
  MEDIUM
  LOW
}

enum ReconciliationStatus {
  MATCHED
  DIFFERENCE
  NOT_APPLICABLE
  ERROR
}

/// The business whose books these are. Brands (and, later, other installations) report INTO a business.
model FinanceBusiness {
  id                          String                    @id @default(cuid())
  key                         String                    @unique
  name                        String
  /// ISO 4217 functional currency; every journal is in it (multi-currency is not supported in Phase 1).
  baseCurrency                String                    @db.VarChar(3)
  /// IANA timezone of the business day that journal dates and periods use.
  timezone                    String
  /// 1–12. Bangladesh's fiscal year starts in July.
  fiscalYearStartMonth        Int                       @default(7)
  /// The Financial Opening Date: the books start here. Nothing posts before it; opening balances are dated on it. Locked
  /// once the opening balances are posted.
  openingDate                 DateTime?                 @db.Date
  /// Phase 3: may an approved ESTIMATED cost be posted for a sale line with no recorded cost? Default: never (KNOWN only).
  costPolicy                  FinanceCostPolicy         @default(KNOWN_ONLY)
  /// Phase 4: when inventory costing became authoritative (set by the 4C valuation cutover). Null = costing is not active:
  /// order lines keep the catalog cost (labelled CATALOG) and no valuation entry is written.
  inventoryCostingActivatedAt DateTime?
  /// Phase 4D: a purchase order at or above this total (base currency) needs an approver other than its creator. Null = no
  /// separation (a single-approver business).
  purchaseApprovalThreshold   Decimal?                  @db.Decimal(18, 2)
  /// Phase 4D: received units may exceed ordered units by this share without purchasing.approve (0 = none).
  overReceiptTolerancePct     Decimal                   @default(0) @db.Decimal(5, 2)
  /// A supplier invoice's unit price may differ from the order's by this percentage before it needs purchasing.approve.
  invoicePriceTolerancePct    Decimal                   @default(0) @db.Decimal(5, 2)
  /// Finance Center: the BDT per USD used when a foreign-currency cost (ad spend, hosting) has no rate of its own. Null =
  /// none set (the amount is then asked for in BDT).
  defaultUsdRate              Decimal?                  @db.Decimal(18, 6)
  /// Finance Center: warn when the SMS balance falls to this (BDT). Null = no warning.
  smsWarnAt                   Decimal?                  @db.Decimal(18, 2)
  /// Finance Center: the cost of goods, as a percent of the cash collected, booked (ESTIMATED) for a parcel sold outside
  /// the website (a courier-panel parcel with no order). Null = not set (no cost is booked; the profit page says so).
  outsideSaleCostPct          Decimal?                  @db.Decimal(5, 2)
  /// Autopilot (docs/FINANCE_OWNER_BOOKS.md §15): the money account Steadfast pays into — set = new payouts are brought
  /// in every night (and posted when every parcel is accounted for); null = off.
  autoPayoutAccountId         String?
  /// The owner keeps every payout: each posted payout into that account becomes his drawing on its own day.
  autoPayoutsToOwner          Boolean                   @default(false)
  /// Partners' monthly profit shares are booked when each month ends.
  autoProfitShares            Boolean                   @default(false)
  /// What the last night's run did, for the settings page.
  autopilotLastRun            Json?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  brands                      FinanceBrand[]
  accounts                    LedgerAccount[]
  mappings                    AccountMapping[]
  financialAccounts           FinancialAccount[]
  periods                     FinancialPeriod[]
  journalEntries              JournalEntry[]
  events                      FinancialEvent[]
  openingBatch                OpeningBalanceBatch?
  reconciliationRuns          ReconciliationRun[]
  treasuryMovements           TreasuryMovement[]
  bankTransactions            BankTransaction[]
  bankMatches                 BankTransactionMatch[]
  statementImports            StatementImport[]
  bankReconciliations         BankReconciliation[]
  exceptions                  FinanceException[]
  clearingSettlements         ClearingSettlement[]
  cashCounts                  CashCount[]
  courierRateCards            CourierRateCard[]
  gatewayFeeRates             GatewayFeeRate[]
  adCampaigns                 AdCampaign[]
  prepaidCosts                PrepaidCost[]
  verifications               FinanceVerification[]
  smsBalanceSnapshots         SmsBalanceSnapshot[]
  stockCounts                 StockCount[]
  materialRolls               MaterialRoll[]
  landedCosts                 LandedCost[]
  courierClaims               CourierClaim[]
  syncState                   FinanceSyncState?
  suppliers                   Supplier[]
  taxCodes                    TaxCode[]
  valuationEntries            InventoryValuationEntry[]
  costStates                  InventoryCostState[]
  cutoverBatch                InventoryCutoverBatch?
  purchaseOrders              PurchaseOrder[]
  goodsReceipts               GoodsReceipt[]
  purchaseReturns             PurchaseReturn[]
  billsOfMaterials            BillOfMaterials[]
  productionOrders            ProductionOrder[]
  productionCostCategories    ProductionCostCategory[]
  supplierInvoices            SupplierInvoice[]
  supplierAllocations         SupplierAllocation[]
  expenses                    Expense[]
  recurringCommitments        RecurringCommitment[]
  fixedAssets                 FixedAsset[]
  depreciationRuns            DepreciationRun[]
  loans                       Loan[]
  loanAccrualRuns             LoanAccrualRun[]
  budgets                     Budget[]
  employees                   Employee[]
  payComponents               PayComponent[]
  payRuns                     PayRun[]
  payrollRemittances          PayrollRemittance[]
  partners                    Partner[]
  profitShares                ProfitShare[]
}

/// A brand of the business — a reporting identity at the financial boundary, NOT a tenant key on commerce tables. A brand
/// that runs as its own installation records that installation's INSTALL_ID; its events identify themselves by it.
model FinanceBrand {
  id               String                    @id @default(cuid())
  businessId       String
  business         FinanceBusiness           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  key              String
  name             String
  installId        String?
  isActive         Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  valuationEntries InventoryValuationEntry[]
  cutoverBatches   InventoryCutoverBatch[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  purchaseReturns  PurchaseReturn[]
  productionOrders ProductionOrder[]
  supplierInvoices SupplierInvoice[]

  @@unique([businessId, key])
  @@unique([businessId, installId])
}

/// Chart of accounts. Group accounts (isPostable = false) only sum their children. Type and normal balance never change
/// once the account carries a posted line (trigger).
model LedgerAccount {
  id                       String                @id @default(cuid())
  businessId               String
  business                 FinanceBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  code                     String
  name                     String
  description              String?
  type                     LedgerAccountType
  normalBalance            LedgerNormalBalance
  parentId                 String?
  parent                   LedgerAccount?        @relation("LedgerAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                 LedgerAccount[]       @relation("LedgerAccountTree")
  isPostable               Boolean               @default(true)
  /// Created from the template or by the system (financial-account children); can be renamed, not deleted.
  isSystem                 Boolean               @default(false)
  isActive                 Boolean               @default(true)
  /// Phase 3: ownership, partner and payroll accounts — balances visible only with finance.sensitive.
  isSensitive              Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  lines                    JournalLine[]
  mappings                 AccountMapping[]
  financialAccount         FinancialAccount?
  openingLines             OpeningBalanceLine[]
  treasuryCounterMovements TreasuryMovement[]    @relation("TreasuryCounterAccount")
  supplierDefaults         Supplier[]            @relation("SupplierDefaultExpense")
  purchaseOrderLines       PurchaseOrderLine[]
  supplierInvoiceLines     SupplierInvoiceLine[] @relation("SupplierInvoiceExpense")
  expenses                 Expense[]             @relation("ExpenseAccount")
  expenseAllocations       ExpenseAllocation[]   @relation("ExpenseAllocationAccount")
  recurringCommitments     RecurringCommitment[] @relation("CommitmentAccount")
  fixedAssets              FixedAsset[]          @relation("FixedAssetAccount")
  budgetLines              BudgetLine[]          @relation("BudgetAccount")
  payComponentExpenses     PayComponent[]        @relation("PayComponentExpense")
  payComponentLiabilities  PayComponent[]        @relation("PayComponentLiability")
  payrollRemittances       PayrollRemittance[]   @relation("PayrollRemittanceAccount")
  prepaidCosts             PrepaidCost[]         @relation("PrepaidExpenseAccount")
  partnerCapital           Partner?              @relation("PartnerCapital")
  partnerCurrent           Partner?              @relation("PartnerCurrent")

  @@unique([businessId, code])
  @@index([businessId, type])
  @@index([parentId])
}

/// The ONLY way code finds the account to post to: a stable key (packages/shared finance/accounts.ts) → an account.
model AccountMapping {
  id         String          @id @default(cuid())
  businessId String
  business   FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  key        String
  accountId  String
  account    LedgerAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([businessId, key])
}

/// A place money is held (cash box, bank account, bKash/Nagad wallet, gateway or courier clearing). Each has its own ledger
/// account; its balance IS that account's ledger balance — never a stored number.
model FinancialAccount {
  id                      String                @id @default(cuid())
  businessId              String
  business                FinanceBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId                 String?
  kind                    FinancialAccountKind
  name                    String
  /// "bKash", "Nagad", "Dutch-Bangla Bank", "SSLCommerz", "Steadfast", …
  provider                String?
  accountNumberLast4      String?               @db.VarChar(4)
  /// Phase 2: the account's title as the bank shows it (no credentials, ever).
  accountTitle            String?
  /// Bank branch, where it matters.
  branch                  String?
  /// A non-secret reference: masked account number, merchant / wallet id. Never a password, PIN or API key.
  accountReference        String?               @db.VarChar(64)
  /// Free-form, non-secret facts (keys that look like credentials are refused by the service).
  metadata                Json?
  /// Movements of at least this amount wait for a second person's approval (null = no approval step).
  approvalThreshold       Decimal?              @db.Decimal(18, 2)
  /// The first day covered by a completed bank reconciliation — ledger lines before it are covered by that run's opening
  /// statement balance.
  reconciliationStartDate DateTime?             @db.Date
  currency                String                @db.VarChar(3)
  ledgerAccountId         String                @unique
  ledgerAccount           LedgerAccount         @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  isActive                Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  openingLines            OpeningBalanceLine[]
  movementsOut            TreasuryMovement[]    @relation("TreasuryFrom")
  movementsIn             TreasuryMovement[]    @relation("TreasuryTo")
  bankTransactions        BankTransaction[]
  statementImports        StatementImport[]
  bankReconciliations     BankReconciliation[]
  settlementsCleared      ClearingSettlement[]  @relation("SettlementClearing")
  settlementsReceived     ClearingSettlement[]  @relation("SettlementDestination")
  recurringCommitments    RecurringCommitment[]
  fixedAssetDisposals     FixedAsset[]
  loans                   Loan[]
  /// Owner's books §2: the person who holds this cash (a cash box is somebody's). Null for banks, wallets, clearing.
  custodianAdminId        String?
  custodian               AdminUser?            @relation("FinancialAccountCustodian", fields: [custodianAdminId], references: [id], onDelete: SetNull)
  cashCounts              CashCount[]
  adCampaigns             AdCampaign[]

  @@unique([businessId, name])
}

/// Owner's books (docs/FINANCE_OWNER_BOOKS.md §3.1): what a courier charges per parcel from a date — a fee per zone (an
/// order's district or area), the COD charge (% of what was collected) and the charge on a returned parcel (% of the zone
/// fee). Read only to ESTIMATE a delivered or returned parcel's charge; the payout statement's actual charge replaces it.
/// A later card (later effectiveFrom) changes the estimate of parcels from that date on.
model CourierRateCard {
  id                  String          @id @default(cuid())
  businessId          String
  business            FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  courier             String          @default("STEADFAST")
  effectiveFrom       DateTime        @db.Date
  /// [{ name, districts: string[], areas: string[], charge }] — matched by area first, then district; charge in major units.
  zones               Json
  /// The fee where no zone matches (outside Dhaka, usually).
  defaultCharge       Decimal         @db.Decimal(18, 2)
  codPercent          Decimal         @db.Decimal(6, 3)
  returnChargePercent Decimal         @db.Decimal(6, 3)
  notes               String?
  createdByAdminId    String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([businessId, courier, effectiveFrom])
}

/// Owner's books §4: what a payment gateway keeps from each payment from a date (percent + fixed), to estimate the fee
/// until the gateway's settlement statement replaces it.
model GatewayFeeRate {
  id               String          @id @default(cuid())
  businessId       String
  business         FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// The payment provider (EPS_PG, SSLCOMMERZ).
  provider         String
  effectiveFrom    DateTime        @db.Date
  percent          Decimal         @db.Decimal(6, 3)
  fixed            Decimal         @default(0) @db.Decimal(18, 2)
  notes            String?
  createdByAdminId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([businessId, provider, effectiveFrom])
}

enum AdBudgetType {
  DAILY
  LIFETIME
}

/// Owner's books (docs/FINANCE_OWNER_BOOKS.md §5.1): one ad campaign, run from an ad account (a money account of kind
/// AD_PLATFORM). Its spend is booked day by day: the ACTUAL spend (Meta's API or entered by hand) where known, else the
/// budget spread over its days (a daily budget each day; a lifetime budget evenly over start → end) — labelled planned.
model AdCampaign {
  id                 String           @id @default(cuid())
  businessId         String
  business           FinanceBusiness  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialAccountId String
  adAccount          FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  platform           String           @default("META")
  /// The platform's own campaign id (Meta campaign_id) — how API spend finds its campaign.
  externalId         String?
  name               String
  objective          String?
  startDate          DateTime         @db.Date
  endDate            DateTime?        @db.Date
  budgetType         AdBudgetType?
  budget             Decimal?         @db.Decimal(18, 2)
  /// The page the ads send people to (a landing page /lp/<slug>, a product) — for profit after ads.
  landingPath        String?
  isActive           Boolean          @default(true)
  notes              String?
  createdByAdminId   String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  spendDays          AdSpendDay[]
  budgetChanges      AdBudgetChange[]

  @@unique([financialAccountId, externalId])
  @@index([businessId, startDate])
}

/// One day's ACTUAL spend of a campaign, in the books' currency (the platform's own figure and rate kept beside it).
model AdSpendDay {
  id               String     @id @default(cuid())
  campaignId       String
  campaign         AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  date             DateTime   @db.Date
  /// META_API, MANUAL, CSV, or PERIOD (a period total shared over its days without their own figure).
  source           String
  amount           Decimal    @db.Decimal(18, 2)
  originalAmount   Decimal?   @db.Decimal(18, 2)
  originalCurrency String?    @db.VarChar(3)
  fxRate           Decimal?   @db.Decimal(18, 6)
  impressions      Int?
  clicks           Int?
  purchases        Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([campaignId, date])
  @@index([date])
}

/// Owner's books §6.1: a cost paid now for a period (a year's hosting, rent in advance): the payment goes to prepaid
/// expenses and moves into its expense account month by month over the service period — so each month carries its share.
model PrepaidCost {
  id               String           @id @default(cuid())
  businessId       String
  business         FinanceBusiness  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  number           Int
  name             String
  expenseAccountId String
  expenseAccount   LedgerAccount    @relation("PrepaidExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  amount           Decimal          @db.Decimal(18, 2)
  serviceStart     DateTime         @db.Date
  serviceEnd       DateTime         @db.Date
  /// The payment (a Treasury withdrawal against prepaid expenses).
  movementId       String           @unique
  movement         TreasuryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  payee            String?
  reference        String?
  notes            String?
  /// Finance Center (subscriptions): remind this many days before serviceEnd, and what the renewal is expected to cost.
  remindDaysBefore Int              @default(30)
  renewalAmount    Decimal?         @db.Decimal(18, 2)
  createdByAdminId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([businessId, number])
}

/// Finance Center: how sure a record is. A record with no row here was entered normally (CONFIRMED by whoever entered it);
/// historical and reported figures carry ESTIMATED / NEEDS_CHECK until someone checks them. The record itself is never
/// changed by this — the status sits beside it, and every change is audited.
enum EntryVerification {
  CONFIRMED
  ESTIMATED
  NEEDS_CHECK
  DISPUTED
}

model FinanceVerification {
  id           String            @id @default(cuid())
  businessId   String
  business     FinanceBusiness   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Expense, PrepaidCost, FixedAsset, OpeningBalanceLine, OpeningInventoryItem, LandedCost, TreasuryMovement, …
  entityType   String
  entityId     String
  status       EntryVerification
  /// Where the figure came from: "Owner's list 2026-10-21", "supplier invoice", "physical count", …
  source       String?
  note         String?
  setByAdminId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([businessId, entityType, entityId])
  @@index([businessId, status])
}

/// Finance Center: one part of an expense that was paid into "Expenses awaiting allocation" (a van hired for several
/// errands): posting moves the part from 6990 to its account, optionally naming the product it served. The parts never
/// add up to more than the expense; what is not allocated stays visible as awaiting allocation.
model ExpenseAllocation {
  id               String        @id @default(cuid())
  expenseId        String
  expense          Expense       @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  lineNo           Int
  accountId        String
  account          LedgerAccount @relation("ExpenseAllocationAccount", fields: [accountId], references: [id], onDelete: Restrict)
  /// Plain id (reports only): the product this part of the cost served.
  productId        String?
  amount           Decimal       @db.Decimal(18, 2)
  note             String?
  createdByAdminId String?
  createdAt        DateTime      @default(now())

  @@unique([expenseId, lineNo])
}

/// Finance Center: a campaign's budget from a date on. Planned (not yet actual) spend of a day uses the budget in force
/// that day, so changing a budget never rewrites the days before the change.
model AdBudgetChange {
  id               String        @id @default(cuid())
  campaignId       String
  campaign         AdCampaign    @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  effectiveDate    DateTime      @db.Date
  budgetType       AdBudgetType?
  budget           Decimal?      @db.Decimal(18, 2)
  changedByAdminId String?
  createdAt        DateTime      @default(now())

  @@index([campaignId, effectiveDate])
}

/// Finance Center: the SMS account's balance at a moment — read from the provider or typed in. Usage between two
/// readings = the drop in balance plus any recharge in between.
model SmsBalanceSnapshot {
  id               String          @id @default(cuid())
  businessId       String
  business         FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  takenAt          DateTime
  balance          Decimal         @db.Decimal(18, 2)
  /// PROVIDER or MANUAL.
  source           String
  note             String?
  createdByAdminId String?
  createdAt        DateTime        @default(now())

  @@index([businessId, takenAt])
}

enum LandedCostMethod {
  QUANTITY
  VALUE
}

/// Owner's books §7.1: a cost of bringing goods in (transport, labour, customs) paid to anyone, added to the goods it
/// brought — spread over the lines of one or more posted goods receipts by quantity or by value. The units still held
/// carry it (their average rises); the share of units already sold goes to cost adjustments (5150). Paid through
/// Treasury (Dr landed costs to allocate / Cr the money account); the allocation clears that account into inventory.
model LandedCost {
  id               String           @id @default(cuid())
  businessId       String
  business         FinanceBusiness  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  number           Int
  costDate         DateTime         @db.Date
  description      String
  payee            String?
  method           LandedCostMethod
  amount           Decimal          @db.Decimal(18, 2)
  goodsReceiptIds  String[]
  /// [{ variantId, sku, qty, amount }] — what each variant received (major units).
  allocations      Json
  movementId       String           @unique
  movement         TreasuryMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  createdByAdminId String?
  createdAt        DateTime         @default(now())
  /// Cancelled: its payment reversed, the goods' value taken back off, its posting reversed — all in one step.
  reversedAt       DateTime?
  reversalReason   String?
  reversedByAdminId String?

  @@unique([businessId, number])
}

enum CourierClaimStatus {
  OPEN
  SETTLED
}

/// Owner's books §3.5: a parcel the courier lost (or damaged), claimed back. Opening it books what Steadfast should pay
/// (Dr 1540 courier claims / Cr 5200 — the recovery of the goods written off as lost). It is settled by money received
/// (a Treasury deposit against 1540), by a Steadfast payout that included it (the payout's extra moved from settlement
/// adjustments into the claim), and whatever is never paid is written off (back to 5200).
model CourierClaim {
  id               String             @id @default(cuid())
  businessId       String
  business         FinanceBusiness    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  number           Int
  orderId          String
  orderNumber      String
  consignmentId    String?
  claimDate        DateTime           @db.Date
  amount           Decimal            @db.Decimal(18, 2)
  reason           String
  status           CourierClaimStatus @default(OPEN)
  /// [{ kind: MONEY | PAYOUT | WRITE_OFF, amount, date, movementId?, eventId?, note }]
  settlements      Json               @default("[]")
  createdByAdminId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([businessId, number])
  @@index([orderId])
}

enum PackingRuleScope {
  EVERY_PARCEL
  CATEGORY
  PRODUCT
  VARIANT
}

enum PackingRulePer {
  PARCEL
  UNIT
}

/// Owner's books §6.2: packaging a parcel uses — a material (Product kind MATERIAL) and how many, for every parcel or for
/// a category / product / variant, per parcel or per unit sold. When a parcel leaves (courier booked, or shipped), the
/// material leaves stock (PACKAGING_USE, at its moving-average cost → 5300 packaging & fulfilment).
model PackingRule {
  id                String           @id @default(cuid())
  scope             PackingRuleScope
  /// The category, product or variant id (null for EVERY_PARCEL).
  scopeId           String?
  materialVariantId String
  materialVariant   ProductVariant   @relation("PackingRuleMaterial", fields: [materialVariantId], references: [id], onDelete: Restrict)
  quantity          Int
  per               PackingRulePer   @default(PARCEL)
  isActive          Boolean          @default(true)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([isActive])
}

/// Owner's books (docs/FINANCE_OWNER_BOOKS.md §2): one physical count of a cash account. `expected` is what the books
/// held at the count; a difference posts as an ADJUSTMENT against cash over/short (its movement), waiting for approval
/// when the person counting may not post. Never changed or deleted.
model CashCount {
  id                 String            @id @default(cuid())
  businessId         String
  business           FinanceBusiness   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialAccountId String
  financialAccount   FinancialAccount  @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  countDate          DateTime          @db.Date
  counted            Decimal           @db.Decimal(18, 2)
  expected           Decimal           @db.Decimal(18, 2)
  difference         Decimal           @db.Decimal(18, 2)
  movementId         String?           @unique
  movement           TreasuryMovement? @relation(fields: [movementId], references: [id], onDelete: Restrict)
  note               String?
  countedByAdminId   String?
  createdAt          DateTime          @default(now())

  @@index([financialAccountId, countDate])
}

/// One calendar month of business dates. OPEN: anyone allowed posts. SOFT_CLOSED: only finance.period_close holders post.
/// CLOSED: nothing posts (trigger); a late event is dated into the next open period.
model FinancialPeriod {
  id              String                @id @default(cuid())
  businessId      String
  business        FinanceBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  startDate       DateTime              @db.Date
  endDate         DateTime              @db.Date
  fiscalYear      Int
  status          FinancialPeriodStatus @default(OPEN)
  closedAt        DateTime?
  closedByAdminId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  journalEntries  JournalEntry[]

  @@unique([businessId, startDate])
}

/// Gapless counters (journal numbers), incremented under a row lock.
model FinanceSequence {
  businessId String
  name       String
  next       Int    @default(1)

  @@id([businessId, name])
}

model JournalEntry {
  id                 String                 @id @default(cuid())
  businessId         String
  business           FinanceBusiness        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId            String?
  /// Gapless per business, assigned when posted. Null while DRAFT.
  number             Int?
  /// Accounting date (business date).
  entryDate          DateTime               @db.Date
  periodId           String
  period             FinancialPeriod        @relation(fields: [periodId], references: [id], onDelete: Restrict)
  status             JournalEntryStatus     @default(DRAFT)
  kind               JournalEntryKind
  description        String
  reference          String?
  currency           String                 @db.VarChar(3)
  totalDebit         Decimal                @default(0) @db.Decimal(18, 2)
  totalCredit        Decimal                @default(0) @db.Decimal(18, 2)
  /// What produced it: "MANUAL", "OPENING_BALANCE", or the source entity of an event ("Order", …).
  sourceType         String?
  sourceId           String?
  financialEventId   String?                @unique
  financialEvent     FinancialEvent?        @relation(fields: [financialEventId], references: [id], onDelete: Restrict)
  /// Unique per business: a repeated request / event / reversal returns the entry it already made.
  idempotencyKey     String?
  /// Content fingerprint stored with the key, to refuse a DIFFERENT request reusing the same key.
  fingerprint        String?
  /// The entry this one reverses (at most one reversal per entry).
  reversesEntryId    String?                @unique
  reversesEntry      JournalEntry?          @relation("JournalReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy         JournalEntry?          @relation("JournalReversal")
  /// The entry this one corrects (posted together with that entry's reversal; at most one correction per entry).
  correctsEntryId    String?                @unique
  correctsEntry      JournalEntry?          @relation("JournalCorrection", fields: [correctsEntryId], references: [id], onDelete: Restrict)
  correctedBy        JournalEntry?          @relation("JournalCorrection")
  reason             String?
  createdByAdminId   String?
  postedByAdminId    String?
  postedAt           DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  lines              JournalLine[]
  openingBatch       OpeningBalanceBatch?
  cutoverBatch       InventoryCutoverBatch?
  treasuryMovement   TreasuryMovement?      @relation("TreasuryJournal")
  treasuryReversal   TreasuryMovement?      @relation("TreasuryReversalJournal")
  settlement         ClearingSettlement?    @relation("SettlementJournal")
  settlementReversal ClearingSettlement?    @relation("SettlementReversalJournal")
  depreciationRun    DepreciationRun?       @relation("DepreciationJournal")
  fixedAssetDisposal FixedAsset?            @relation("DisposalJournal")
  loanAccrualRun     LoanAccrualRun?        @relation("LoanAccrualJournal")
  payRun             PayRun?                @relation("PayRunJournal")

  @@unique([businessId, idempotencyKey])
  @@unique([businessId, number])
  @@index([businessId, entryDate])
  @@index([businessId, status])
  @@index([sourceType, sourceId])
  @@index([periodId])
}

model JournalLine {
  id              String                  @id @default(cuid())
  entryId         String
  entry           JournalEntry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  lineNo          Int
  accountId       String
  account         LedgerAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// Exactly one of debit / credit is positive (CHECK constraint).
  debit           Decimal                 @default(0) @db.Decimal(18, 2)
  credit          Decimal                 @default(0) @db.Decimal(18, 2)
  brandId         String?
  memo            String?
  /// Sub-ledger party (supplier, customer, employee, equity holder, lender) — typed in later phases.
  partyType       String?
  partyId         String?
  /// Set on lines whose amount depends on product cost (inventory, COGS).
  valuationStatus FinanceValuationStatus?
  createdAt       DateTime                @default(now())
  bankMatches     BankTransactionMatch[]

  @@unique([entryId, lineNo])
  @@index([accountId])
  @@index([brandId])
}

/// The accounting inbox: one row per financial event (packages/shared finance/events.ts envelope). (sourceInstallId,
/// eventKey) is the event's accounting identity — a repeat delivery finds the row instead of adding one.
model FinancialEvent {
  id               String               @id @default(cuid())
  businessId       String
  business         FinanceBusiness      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId          String
  sourceInstallId  String
  sourceSystem     String
  sourceEntityType String
  sourceEntityId   String
  eventType        String
  eventVersion     Int
  eventKey         String
  occurredAt       DateTime
  financialDate    DateTime             @db.Date
  currency         String               @db.VarChar(3)
  payload          Json
  status           FinancialEventStatus @default(RECEIVED)
  attempts         Int                  @default(0)
  lastError        String?
  receivedAt       DateTime             @default(now())
  processedAt      DateTime?
  updatedAt        DateTime             @updatedAt
  journalEntry     JournalEntry?

  @@unique([sourceInstallId, eventKey])
  @@index([status, receivedAt])
  @@index([sourceEntityType, sourceEntityId])
  @@index([businessId, eventType])
}

/// Financial audit trail — append-only (trigger), written INSIDE the transaction of the change it records. A deferred
/// trigger refuses to commit a change to a finance record without a row here from the same transaction (txId).
model FinanceAuditEntry {
  id            String           @id @default(cuid())
  businessId    String?
  actorType     FinanceActorType
  actorAdminId  String?
  /// Who/what, readable without joins (admin email, "system:bootstrap", "event:<installId>").
  actorLabel    String
  action        String
  entityType    String
  entityId      String
  before        Json?
  after         Json?
  reason        String?
  sourceType    String?
  sourceRef     String?
  correlationId String?
  txId          BigInt           @default(dbgenerated("txid_current()"))
  createdAt     DateTime         @default(now())

  @@index([entityType, entityId])
  @@index([businessId, createdAt])
  @@index([txId])
}

/// The opening balances of the business at its Financial Opening Date. One batch per business: editable while DRAFT,
/// posted once as a single OPENING_BALANCE journal (the difference goes to Opening balance equity), then immutable.
model OpeningBalanceBatch {
  id               String                 @id @default(cuid())
  businessId       String                 @unique
  business         FinanceBusiness        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  openingDate      DateTime               @db.Date
  status           OpeningBalanceStatus   @default(DRAFT)
  notes            String?
  journalEntryId   String?                @unique
  journalEntry     JournalEntry?          @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  createdByAdminId String?
  postedByAdminId  String?
  postedAt         DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  lines            OpeningBalanceLine[]
  inventoryItems   OpeningInventoryItem[]
}

model OpeningBalanceLine {
  id                 String                 @id @default(cuid())
  batchId            String
  batch              OpeningBalanceBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lineNo             Int
  category           OpeningBalanceCategory
  accountId          String
  account            LedgerAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  financialAccountId String?
  financialAccount   FinancialAccount?      @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  side               LedgerNormalBalance
  amount             Decimal                @db.Decimal(18, 2)
  brandId            String?
  partyType          String?
  partyId            String?
  description        String?

  @@unique([batchId, lineNo])
}

/// The opening inventory count, one row per SKU. Its valued total becomes the inventory line of the opening journal.
/// MISSING rows (no trustworthy cost) are valued at 0 and stay visible as unvalued inventory — never given an invented cost.
model OpeningInventoryItem {
  id              String                      @id @default(cuid())
  batchId         String
  batch           OpeningBalanceBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// Plain id (no FK): the count is history, it outlives the catalog.
  variantId       String?
  sku             String
  name            String
  quantity        Int
  unitCost        Decimal?                    @db.Decimal(18, 2)
  valuationAmount Decimal                     @default(0) @db.Decimal(18, 2)
  valuationStatus FinanceValuationStatus
  /// How the value was obtained: VARIANT_COST_PRICE, SUPPLIER_INVOICE, OWNER_ESTIMATE, NONE, …
  valuationMethod String
  valuationSource String?
  valuationDate   DateTime                    @db.Date
  confidence      OpeningInventoryConfidence?
  notes           String?
  brandId         String?

  @@unique([batchId, sku])
}

/// One run of one reconciliation check (diagnostic history — the checks themselves read the live data).
model ReconciliationRun {
  id           String               @id @default(cuid())
  businessId   String
  business     FinanceBusiness      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  checkKey     String
  fromDate     DateTime?            @db.Date
  toDate       DateTime?            @db.Date
  brandId      String?
  status       ReconciliationStatus
  expected     Decimal?             @db.Decimal(18, 2)
  actual       Decimal?             @db.Decimal(18, 2)
  difference   Decimal?             @db.Decimal(18, 2)
  details      Json
  ranByAdminId String?
  createdAt    DateTime             @default(now())

  @@index([businessId, checkKey, createdAt])
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// FINANCIAL CORE — Phase 2: cash, bank, wallets & bank reconciliation (docs/FINANCE_PHASE_2.md). Money movements post
// through the Phase 1 journal service; statement lines are evidence matched to ledger lines, never postings themselves.
// Balances are the ledger's — there is no balance column. Triggers (migration 20261012100000_finance_phase2_treasury)
// keep matched amounts and statuses derived, make history immutable, and require the financial audit entry.
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

enum TreasuryMovementKind {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  ADJUSTMENT
  OPENING_FUNDING
  /// Phase 4F: money paid to a supplier — Dr trade payables (the supplier) / Cr the money account.
  SUPPLIER_PAYMENT
  /// Money a supplier pays back from an advance or a credit note — Dr the money account / Cr trade payables (the supplier).
  SUPPLIER_REFUND
}

enum TreasuryMovementStatus {
  PENDING_APPROVAL
  POSTED
  REJECTED
  REVERSED
}

enum TreasuryDirection {
  IN
  OUT
}

enum BankTransactionSource {
  MANUAL
  CSV_IMPORT
}

enum BankTransactionStatus {
  UNMATCHED
  PARTIALLY_MATCHED
  MATCHED
  ADJUSTMENT_REQUIRED
  RECONCILED
}

enum BankMatchStatus {
  ACTIVE
  REMOVED
}

enum BankReconciliationStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// A money movement of the business: deposit into / withdrawal from a financial account against a counter account,
/// a transfer between two financial accounts, an explicit adjustment, or an account's opening funding. Its ledger effect
/// is its journal (kind TREASURY), posted by journal.service; a reversal is a second journal. Immutable except its status.
model TreasuryMovement {
  id                     String                 @id @default(cuid())
  businessId             String
  business               FinanceBusiness        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// The brand of the account(s) moved (transfers never cross brands).
  brandId                String?
  kind                   TreasuryMovementKind
  status                 TreasuryMovementStatus
  /// ADJUSTMENT only: money IN to or OUT of the account.
  direction              TreasuryDirection?
  movementDate           DateTime               @db.Date
  amount                 Decimal                @db.Decimal(18, 2)
  currency               String                 @db.VarChar(3)
  fromFinancialAccountId String?
  fromAccount            FinancialAccount?      @relation("TreasuryFrom", fields: [fromFinancialAccountId], references: [id], onDelete: Restrict)
  toFinancialAccountId   String?
  toAccount              FinancialAccount?      @relation("TreasuryTo", fields: [toFinancialAccountId], references: [id], onDelete: Restrict)
  /// Deposits, withdrawals, adjustments, opening funding: the other side of the journal (capital, drawings, a loan, …).
  counterAccountId       String?
  counterAccount         LedgerAccount?         @relation("TreasuryCounterAccount", fields: [counterAccountId], references: [id], onDelete: Restrict)
  /// SUPPLIER_PAYMENT / SUPPLIER_REFUND only: the supplier paid or refunding (the party of its payables line).
  supplierId             String?
  supplier               Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// SUPPLIER_REFUND only — exactly one: the advance payment, or the credit note, the money refunds.
  refundOfPaymentId      String?
  refundOfPayment        TreasuryMovement?      @relation("SupplierRefundOfPayment", fields: [refundOfPaymentId], references: [id], onDelete: Restrict)
  refunds                TreasuryMovement[]     @relation("SupplierRefundOfPayment")
  refundOfCreditNoteId   String?
  refundOfCreditNote     SupplierInvoice?       @relation("SupplierRefundOfCredit", fields: [refundOfCreditNoteId], references: [id], onDelete: Restrict)
  reference              String?
  description            String
  reason                 String?
  idempotencyKey         String
  fingerprint            String
  journalEntryId         String?                @unique
  journalEntry           JournalEntry?          @relation("TreasuryJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  reversalJournalEntryId String?                @unique
  reversalJournalEntry   JournalEntry?          @relation("TreasuryReversalJournal", fields: [reversalJournalEntryId], references: [id], onDelete: Restrict)
  /// An adjustment that resolves a statement line (reconciliation), and the run it was made in.
  bankTransactionId      String?
  bankTransaction        BankTransaction?       @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  reconciliationId       String?
  reconciliation         BankReconciliation?    @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  requestedByAdminId     String?
  approvedByAdminId      String?
  approvedAt             DateTime?
  rejectedByAdminId      String?
  rejectedAt             DateTime?
  rejectionReason        String?
  reversedByAdminId      String?
  reversedAt             DateTime?
  reversalReason         String?
  /// Owner's books §2: a handover into cash someone else holds waits for THAT person to confirm they received it.
  receiverAdminId        String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  cashCount              CashCount?
  prepaidCost            PrepaidCost?
  landedCost             LandedCost?
  matches                BankTransactionMatch[]
  supplierAllocations    SupplierAllocation[]
  expense                Expense?
  loanDrawdown           Loan?                  @relation("LoanDrawdown")
  loanRepaymentPrincipal LoanRepayment?         @relation("RepaymentPrincipal")
  loanRepaymentInterest  LoanRepayment?         @relation("RepaymentInterest")
  payslipPayments        PayslipPayment[]       @relation("PayslipPaymentMovement")
  payrollRemittance      PayrollRemittance?     @relation("PayrollRemittanceMovement")
  fixedAssetDisposal     FixedAsset?            @relation("FixedAssetDisposalProceeds")

  @@unique([businessId, idempotencyKey])
  @@index([fromFinancialAccountId, movementDate])
  @@index([toFinancialAccountId, movementDate])
  @@index([businessId, status])
  @@index([bankTransactionId])
  @@index([refundOfPaymentId])
  @@index([refundOfCreditNoteId])
}

/// One line of a bank / wallet / gateway statement (entered by hand or imported). Evidence of what the institution
/// recorded — it never posts to the ledger; it is MATCHED to ledger lines. Bank convention: debit = money out, credit =
/// money in; amount = credit − debit. Financial fields are immutable; status and matchedAmount are derived (triggers).
model BankTransaction {
  id                 String                 @id @default(cuid())
  businessId         String
  business           FinanceBusiness        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialAccountId String
  financialAccount   FinancialAccount       @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  transactionDate    DateTime               @db.Date
  valueDate          DateTime?              @db.Date
  reference          String?
  description        String
  debit              Decimal                @default(0) @db.Decimal(18, 2)
  credit             Decimal                @default(0) @db.Decimal(18, 2)
  amount             Decimal                @db.Decimal(18, 2)
  currency           String                 @db.VarChar(3)
  externalId         String?
  /// The running balance the statement printed on this line, when it has one.
  statementBalance   Decimal?               @db.Decimal(18, 2)
  source             BankTransactionSource
  importId           String?
  import             StatementImport?       @relation(fields: [importId], references: [id], onDelete: Restrict)
  importLine         Int?
  /// Unique per account: the external id, else a hash of the row's content and its occurrence in the file — a repeated
  /// import finds the row instead of adding it.
  dedupeKey          String
  status             BankTransactionStatus  @default(UNMATCHED)
  /// Σ of ACTIVE matches (maintained by the match trigger).
  matchedAmount      Decimal                @default(0) @db.Decimal(18, 2)
  adjustmentRequired Boolean                @default(false)
  note               String?
  /// Set when a completed reconciliation covered this line: RECONCILED, final.
  reconciliationId   String?
  reconciliation     BankReconciliation?    @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  createdByAdminId   String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  matches            BankTransactionMatch[]
  adjustments        TreasuryMovement[]

  @@unique([financialAccountId, dedupeKey])
  @@index([financialAccountId, transactionDate])
  @@index([businessId, status])
}

/// External statement line ↔ internal ledger line, for an amount (partial matching: one statement line can match several
/// ledger lines and vice versa). Never deleted: unmatching marks it REMOVED.
model BankTransactionMatch {
  id                   String              @id @default(cuid())
  businessId           String
  business             FinanceBusiness     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  bankTransactionId    String
  bankTransaction      BankTransaction     @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  journalLineId        String
  journalLine          JournalLine         @relation(fields: [journalLineId], references: [id], onDelete: Restrict)
  amount               Decimal             @db.Decimal(18, 2)
  status               BankMatchStatus     @default(ACTIVE)
  matchedAt            DateTime            @default(now())
  matchedByAdminId     String?
  reconciliationId     String?
  reconciliation       BankReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  reference            String?
  note                 String?
  /// The adjustment movement this match was created for (an explicit resolution of a difference).
  adjustmentMovementId String?
  adjustmentMovement   TreasuryMovement?   @relation(fields: [adjustmentMovementId], references: [id], onDelete: Restrict)
  removedAt            DateTime?
  removedByAdminId     String?
  removalReason        String?

  @@index([bankTransactionId])
  @@index([journalLineId])
}

/// One CSV statement import: the mapping used and what happened to each row. Append-only.
model StatementImport {
  id                 String            @id @default(cuid())
  businessId         String
  business           FinanceBusiness   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialAccountId String
  financialAccount   FinancialAccount  @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  fileName           String?
  /// sha256 of the file text: the same file imported again returns this import.
  fileHash           String
  columnMapping      Json
  options            Json
  rowCount           Int
  importedCount      Int
  duplicateCount     Int
  errorCount         Int
  errors             Json
  importedByAdminId  String?
  createdAt          DateTime          @default(now())
  transactions       BankTransaction[]

  @@unique([financialAccountId, fileHash])
}

/// A bank reconciliation of one account over one statement period. History: once COMPLETED or ABANDONED it never
/// changes; completed periods of an account never overlap and chain (each opens with the previous closing balance).
model BankReconciliation {
  id                      String                   @id @default(cuid())
  businessId              String
  business                FinanceBusiness          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  financialAccountId      String
  financialAccount        FinancialAccount         @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  periodStart             DateTime                 @db.Date
  periodEnd               DateTime                 @db.Date
  openingStatementBalance Decimal                  @db.Decimal(18, 2)
  closingStatementBalance Decimal                  @db.Decimal(18, 2)
  /// Snapshot at completion (refreshed while IN_PROGRESS).
  ledgerOpeningBalance    Decimal?                 @db.Decimal(18, 2)
  ledgerBalance           Decimal?                 @db.Decimal(18, 2)
  statementMovement       Decimal?                 @db.Decimal(18, 2)
  /// closing statement − ledger balance at periodEnd.
  difference              Decimal?                 @db.Decimal(18, 2)
  /// The part of the difference no outstanding item explains (must be 0 to complete).
  unexplainedDifference   Decimal?                 @db.Decimal(18, 2)
  /// opening + statement lines − closing (must be 0: the statement is complete).
  statementGap            Decimal?                 @db.Decimal(18, 2)
  matchedCount            Int                      @default(0)
  unmatchedCount          Int                      @default(0)
  outstandingLedgerCount  Int                      @default(0)
  adjustmentCount         Int                      @default(0)
  status                  BankReconciliationStatus @default(IN_PROGRESS)
  notes                   String?
  startedByAdminId        String?
  completedByAdminId      String?
  completedAt             DateTime?
  abandonedAt             DateTime?
  abandonReason           String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  bankTransactions        BankTransaction[]
  matches                 BankTransactionMatch[]
  adjustments             TreasuryMovement[]

  @@index([financialAccountId, periodStart])
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// FINANCIAL CORE — Phase 3: commerce accounting (docs/FINANCE_PHASE_3.md). Sales, payments, refunds, returns, store
// credit and COGS reach the ledger as financial events projected from the commerce facts the dashboard uses; clearing
// accounts are settled by recorded settlements. Unresolved problems are FinanceExceptions, never guesses.
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

enum FinanceCostPolicy {
  KNOWN_ONLY
  APPROVED_ESTIMATES
}

enum FinanceExceptionKind {
  MISSING_COST
  ORDER_TOTAL_MISMATCH
  UNVALUED_STOCK_RECEIPT
  UNVALUED_STOCK_WRITE_OFF
  UNSUPPORTED_CREDIT_ENTRY
  UNMATCHED_SETTLEMENT_LINE
  ENGINE_MISMATCH
}

enum FinanceExceptionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ClearingSettlementStatus {
  DRAFT
  POSTED
  REVERSED
}

enum ClearingSettlementSource {
  MANUAL
  CSV_IMPORT
  /// Owner's books §3.2: pulled from the courier's payout API.
  API_IMPORT
}

enum SettlementLineMatch {
  MATCHED
  UNMATCHED
}

/// An accounting problem the Finance Core will not guess about: a sale line with no recorded cost, stock that moved
/// without a value, a store-credit entry with no accounting meaning, a settlement line with no order. It names its source
/// record. Never deleted; OPEN → ACKNOWLEDGED (accepted as is) or RESOLVED (an approved resolution was posted).
model FinanceException {
  id                String                 @id @default(cuid())
  businessId        String
  business          FinanceBusiness        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId           String?
  kind              FinanceExceptionKind
  status            FinanceExceptionStatus @default(OPEN)
  /// Deterministic identity: a re-run of the projector finds the exception instead of adding one.
  key               String
  sourceType        String
  sourceId          String
  orderId           String?
  orderNumber       String?
  title             String
  details           Json
  /// Minor-unit relevance in major units (units × suggested cost, the unmatched amount, …) — informational.
  amount            Decimal?               @db.Decimal(18, 2)
  resolution        String?
  resolutionNote    String?
  /// An approved estimate (ESTIMATED cost per unit, major units) — only under the APPROVED_ESTIMATES policy.
  estimatedUnitCost Decimal?               @db.Decimal(18, 2)
  resolvedByAdminId String?
  resolvedAt        DateTime?
  /// The financial event the resolution recorded (an approved estimate).
  financialEventId  String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([businessId, key])
  @@index([businessId, status, kind])
  @@index([orderId])
}

/// A recorded payout from a clearing account (courier COD, payment gateway, manual receipts) into a money account: what
/// left clearing (gross), what arrived (net), and the ACTUAL fee and adjustment the statement shows — never an assumed
/// fee. Posted as one journal through journal.service; reversed, never edited.
model ClearingSettlement {
  id                            String                   @id @default(cuid())
  businessId                    String
  business                      FinanceBusiness          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId                       String?
  clearingFinancialAccountId    String
  clearingAccount               FinancialAccount         @relation("SettlementClearing", fields: [clearingFinancialAccountId], references: [id], onDelete: Restrict)
  destinationFinancialAccountId String
  destinationAccount            FinancialAccount         @relation("SettlementDestination", fields: [destinationFinancialAccountId], references: [id], onDelete: Restrict)
  settlementDate                DateTime                 @db.Date
  /// The courier / gateway payout reference — unique per clearing account.
  reference                     String
  grossAmount                   Decimal                  @db.Decimal(18, 2)
  netAmount                     Decimal                  @db.Decimal(18, 2)
  feeAmount                     Decimal                  @default(0) @db.Decimal(18, 2)
  /// Signed: positive = a further deduction by the courier / gateway, negative = more paid than the orders cleared.
  adjustmentAmount              Decimal                  @default(0) @db.Decimal(18, 2)
  adjustmentReason              String?
  /// Statement file name, payout id, a note — where the figures come from.
  evidence                      String?
  source                        ClearingSettlementSource
  fileHash                      String?
  status                        ClearingSettlementStatus @default(DRAFT)
  journalEntryId                String?                  @unique
  journalEntry                  JournalEntry?            @relation("SettlementJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  reversalJournalEntryId        String?                  @unique
  reversalJournalEntry          JournalEntry?            @relation("SettlementReversalJournal", fields: [reversalJournalEntryId], references: [id], onDelete: Restrict)
  idempotencyKey                String
  createdByAdminId              String?
  postedByAdminId               String?
  postedAt                      DateTime?
  reversedByAdminId             String?
  reversedAt                    DateTime?
  reversalReason                String?
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  lines                         ClearingSettlementLine[]

  @@unique([businessId, idempotencyKey])
  @@unique([clearingFinancialAccountId, reference])
  @@index([businessId, status])
}

/// One order (consignment / gateway transaction) in a settlement: what was cleared for it, and its own fee / adjustment.
model ClearingSettlementLine {
  id           String              @id @default(cuid())
  settlementId String
  settlement   ClearingSettlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  lineNo       Int
  orderId      String?
  orderNumber  String?
  /// Consignment id / tracking code / gateway transaction id as the statement shows it.
  externalRef  String?
  amount       Decimal             @db.Decimal(18, 2)
  fee          Decimal             @default(0) @db.Decimal(18, 2)
  adjustment   Decimal             @default(0) @db.Decimal(18, 2)
  matchStatus  SettlementLineMatch
  /// Owner's books: a parcel booked straight on the courier's panel, never an order on the site — counted as a sale outside
  /// the website (revenue.outside_sales) instead of money owed for an order.
  outsideSale  Boolean             @default(false)
  note         String?

  @@unique([settlementId, lineNo])
  @@index([orderId])
}

/// Where the commerce projector got to (operational state, not a financial record): the sweep cursor and last run.
model FinanceSyncState {
  businessId   String          @id
  business     FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  cursor       DateTime?
  lastRunAt    DateTime?
  lastRunStats Json?
  /// The running sweep's lease (Phase 3 §2): who holds it and until when; null when no sweep runs.
  leaseToken   String?
  leaseUntil   DateTime?
  updatedAt    DateTime        @updatedAt
}

// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
// FINANCIAL CORE — Phase 4: purchasing, suppliers / AP & inventory costing (docs/FINANCE_PHASE_4.md). 4A: the supplier
// master, purchase tax codes and the valuation ledger. Suppliers are installation-scoped (one FinanceBusiness per
// installation today); `code` is the stable key for a future cross-installation merge. A supplier's balance is never
// stored — it is the AP ledger filtered by party.
// ════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

enum SupplierStatus {
  ACTIVE
  /// No new purchase orders or payments without an override.
  ON_HOLD
  INACTIVE
}

model Supplier {
  id                      String                @id @default(cuid())
  businessId              String
  business                FinanceBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Stable, immutable code (SUP-0001 by default) — the merge key across installations.
  code                    String
  legalName               String
  displayName             String
  contactName             String?
  phone                   String?
  email                   String?
  /// {line, area, district, division, postalCode, country}
  address                 Json?
  taxId                   String?
  vatRegistrationNo       String?
  /// Default document currency (ISO 4217).
  currency                String                @db.VarChar(3)
  paymentTermsDays        Int                   @default(0)
  paymentTermsNote        String?
  /// A warning threshold, never a block.
  creditLimit             Decimal?              @db.Decimal(18, 2)
  defaultTaxCodeId        String?
  defaultTaxCode          TaxCode?              @relation(fields: [defaultTaxCodeId], references: [id], onDelete: Restrict)
  defaultExpenseAccountId String?
  defaultExpenseAccount   LedgerAccount?        @relation("SupplierDefaultExpense", fields: [defaultExpenseAccountId], references: [id], onDelete: Restrict)
  status                  SupplierStatus        @default(ACTIVE)
  statusReason            String?
  notes                   String?
  /// References to documents held elsewhere (trade licence, agreement) — evidence, not a file store.
  evidence                String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  purchaseReturns         PurchaseReturn[]
  productionOrders        ProductionOrder[]
  productionCosts         ProductionCostEntry[]
  supplierInvoices        SupplierInvoice[]
  payments                TreasuryMovement[]
  allocations             SupplierAllocation[]
  recurringCommitments    RecurringCommitment[]

  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, displayName])
}

/// A purchase tax rate. Rate, recoverable share and the mapping keys never change once created — a new rate is a new
/// code. No jurisdiction rules: recoverable tax goes to `recoverableMappingKey`, the rest into cost (stock) or expense.
model TaxCode {
  id                       String                @id @default(cuid())
  businessId               String
  business                 FinanceBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  code                     String
  name                     String
  description              String?
  /// Percent, e.g. 15.0000.
  rate                     Decimal               @db.Decimal(7, 4)
  /// Percent of the tax that is recoverable (0–100).
  recoverablePct           Decimal               @db.Decimal(7, 4)
  recoverableMappingKey    String                @default("asset.vat_input")
  /// Where the non-recoverable part of tax on an EXPENSE line goes (on a stock line it is part of the unit cost).
  nonRecoverableMappingKey String                @default("expense.non_recoverable_tax")
  isActive                 Boolean               @default(true)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  purchaseOrderLines       PurchaseOrderLine[]
  suppliers                Supplier[]
  supplierInvoiceLines     SupplierInvoiceLine[]

  @@unique([businessId, code])
}

enum InventoryValuationKind {
  /// The one-time valuation cutover.
  CUTOVER
  /// Units in: supplier receipt, customer return / cancellation, count gain.
  INFLOW
  /// Units out: sale, write-off, supplier return.
  OUTFLOW
  /// Value only (no units): a late price difference or landed cost on units still held.
  REVALUATION
}

/// The cost ledger: one append-only entry per valued stock movement (1:1, `stockMovementId` unique) or per revaluation.
/// Written only by costing.service.ts. `valueChange` is what the valuation moved; `bookValue` is what the ledger's
/// inventory account moves for the same fact (posted by its owner — Phase 3 for orders, Phase 4 documents otherwise);
/// `costAdjustment` = valueChange − bookValue is posted to inventory against 5150, so the ledger always equals the valuation.
model InventoryValuationEntry {
  id                String                 @id @default(cuid())
  /// Global processing order — costing follows processing order, never re-sorted by document date.
  sequence          BigInt                 @unique @default(autoincrement())
  businessId        String
  business          FinanceBusiness        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId           String
  brand             FinanceBrand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  variantId         String
  variant           ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  stockMovementId   String?                @unique
  stockMovement     StockMovement?         @relation(fields: [stockMovementId], references: [id], onDelete: Restrict)
  kind              InventoryValuationKind
  /// Physical units this entry covers (signed; 0 for a revaluation).
  qtyChange         Int
  valueChange       Decimal                @db.Decimal(18, 2)
  bookValue         Decimal                @db.Decimal(18, 2)
  costAdjustment    Decimal                @db.Decimal(18, 2)
  /// The unit cost the entry applied (major units, 6 dp); null when no cost was known.
  unitCost          Decimal?               @db.Decimal(18, 6)
  /// SNAPSHOT entries: the exact order-line unit cost in minor units (the same integer as OrderItem.unitCostSnapshot).
  unitCostMinor     Int?
  /// SNAPSHOT (an order line's cost), AVERAGE, DOCUMENT (receipt / invoice), MANUAL, CUTOVER, NONE.
  costBasis         String
  valuationStatus   FinanceValuationStatus
  /// Of the units: issued beyond valued stock (deficit), of an inflow covering a deficit, without any cost.
  deficitQtyChange  Int                    @default(0)
  coveredQty        Int                    @default(0)
  unvaluedQtyChange Int                    @default(0)
  qtyAfter          Int
  valueAfter        Decimal                @db.Decimal(18, 2)
  avgAfter          Decimal?               @db.Decimal(18, 6)
  unvaluedAfter     Int
  deficitAfter      Int
  sourceType        String
  sourceId          String
  financialDate     DateTime               @db.Date
  note              String?
  createdAt         DateTime               @default(now())
  costState         InventoryCostState?

  @@index([variantId, sequence])
  @@index([sourceType, sourceId])
  @@index([businessId, financialDate])
}

/// The running cost position of one variant — always equal to its latest valuation entry (trigger-checked). Physical
/// units = valuedQty + unvaluedQty − deficitQty. `deficitLayers` keeps the provisional cost of units issued short (FIFO).
model InventoryCostState {
  variantId     String                  @id
  variant       ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  businessId    String
  business      FinanceBusiness         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  valuedQty     Int
  value         Decimal                 @db.Decimal(18, 2)
  /// Average unit cost of valued units (major, 6 dp). Kept at its last value when valuedQty reaches 0; null until known.
  avgUnitCost   Decimal?                @db.Decimal(18, 6)
  unvaluedQty   Int
  deficitQty    Int
  deficitLayers Json
  lastEntryId   String                  @unique
  lastEntry     InventoryValuationEntry @relation(fields: [lastEntryId], references: [id], onDelete: Restrict)
  updatedAt     DateTime                @updatedAt
}

/// Phase 4C (docs/FINANCE_PHASE_4C.md): the one-time, owner-approved valuation cutover. It gives every stock-tracked
/// variant its first valuation (physical stock at post × the approved unit cost), trues the inventory account up to the
/// valuation through ONE journal, and activates costing — all in one transaction. One batch per business; POSTED is final.
enum InventoryCutoverStatus {
  DRAFT
  APPROVED
  POSTED
}

model InventoryCutoverBatch {
  id                  String                 @id @default(cuid())
  businessId          String                 @unique
  business            FinanceBusiness        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId             String
  brand               FinanceBrand           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  status              InventoryCutoverStatus @default(DRAFT)
  /// The financial date of the cutover entries and journal (business timezone).
  cutoverDate         DateTime               @db.Date
  notes               String?
  /// Of the ledger true-up, the part the owner attributes to a proven opening-balance error (→ 3900, signed: positive =
  /// inventory was understated at opening). The rest goes to 5150. A non-zero amount needs a reason.
  openingErrorAmount  Decimal                @default(0) @db.Decimal(18, 2)
  openingErrorReason  String?
  /// Fingerprint of the lines when approved; posting refuses lines changed since.
  approvedFingerprint String?
  createdByAdminId    String?
  approvedByAdminId   String?
  approvedAt          DateTime?
  postedByAdminId     String?
  postedAt            DateTime?
  journalEntryId      String?                @unique
  journalEntry        JournalEntry?          @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  /// Frozen at post: ledger balance before, valuation total, in-transit bridge, adjustment split, line counts.
  summary             Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  lines               InventoryCutoverLine[]
}

model InventoryCutoverLine {
  id               String                 @id @default(cuid())
  batchId          String
  batch            InventoryCutoverBatch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  variantId        String
  /// Cascade while the batch is a draft (a variant with no history may still be removed — re-approval is then needed);
  /// once POSTED the line guard refuses the delete, so a cut-over variant can never be hard-deleted.
  variant          ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sku              String
  name             String
  /// Approved unit cost (major units); null = no trustworthy cost (MISSING — the units are held unvalued, never at zero).
  unitCost         Decimal?               @db.Decimal(18, 2)
  valuationStatus  FinanceValuationStatus
  /// OPENING_COUNT, CATALOG_VARIANT, CATALOG_PRODUCT, OWNER, SUPPLIER_INVOICE, NONE, ADDED_AT_POST
  costSource       String
  evidence         String?
  /// Physical stock when the draft was built (information); the cutover uses the stock at post.
  draftQuantity    Int
  postedQuantity   Int?
  postedValue      Decimal?               @db.Decimal(18, 2)
  valuationEntryId String?                @unique
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([batchId, variantId])
  @@index([batchId, valuationStatus])
}

// ── Phase 4D: purchasing documents (docs/FINANCE_PHASE_4D.md) ─────────────────────────────────────────────────────────

/// A purchase order commits to buy; it posts nothing. Received quantities are derived from posted goods receipts.
enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// STOCK = a stock-tracked variant (received on a goods receipt); NON_STOCK = a service or expense with an account.
enum PurchaseLineType {
  STOCK
  NON_STOCK
}

enum GoodsReceiptStatus {
  DRAFT
  POSTED
  REVERSED
}

enum PurchaseReturnStatus {
  DRAFT
  APPROVED
  SHIPPED
  CANCELLED
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  businessId        String
  business          FinanceBusiness     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId           String
  brand             FinanceBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  supplierId        String
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// FinanceSequence "purchase_order" — shown as PO-000001.
  number            Int
  status            PurchaseOrderStatus @default(DRAFT)
  orderDate         DateTime            @db.Date
  expectedDate      DateTime?           @db.Date
  currency          String              @db.VarChar(3)
  deliveryTerms     String?
  notes             String?
  /// Incremented by an audited revision of an approved order.
  revision          Int                 @default(0)
  createdByAdminId  String?
  submittedAt       DateTime?
  approvedByAdminId String?
  approvedAt        DateTime?
  closedReason      String?
  closedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lines             PurchaseOrderLine[]
  receipts          GoodsReceipt[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([supplierId, status])
}

model PurchaseOrderLine {
  id               String                @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  lineNo           Int
  lineType         PurchaseLineType
  variantId        String?
  variant          ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  /// SKU / description as ordered (the catalog may change; the order is history).
  sku              String?
  description      String
  expenseAccountId String?
  expenseAccount   LedgerAccount?        @relation(fields: [expenseAccountId], references: [id], onDelete: Restrict)
  qtyOrdered       Int
  /// Net of discount, per unit, document currency.
  unitPrice        Decimal               @db.Decimal(18, 2)
  taxCodeId        String?
  taxCode          TaxCode?              @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  /// Derived (trigger) from posted, not-reversed goods-receipt lines.
  qtyReceived      Int                   @default(0)
  /// Derived (trigger) from shipped supplier-return lines that reference a receipt line of this order line.
  qtyReturned      Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  receiptLines     GoodsReceiptLine[]
  invoiceLines     SupplierInvoiceLine[]

  @@unique([purchaseOrderId, lineNo])
}

/// A goods receipt: DRAFT → POSTED (stock and value in, Dr inventory / Cr GRNI) → REVERSED (stock out again at the receipt
/// cost; the receipt's journal reversed). Posted lines are immutable.
model GoodsReceipt {
  id                      String             @id @default(cuid())
  businessId              String
  business                FinanceBusiness    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId                 String
  brand                   FinanceBrand       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  supplierId              String
  supplier                Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId         String?
  purchaseOrder           PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  /// FinanceSequence "goods_receipt" — GRN-000001.
  number                  Int
  status                  GoodsReceiptStatus @default(DRAFT)
  receiptDate             DateTime           @db.Date
  supplierRef             String?
  notes                   String?
  /// A receipt without a purchase order (locked decision 2): reason, approval and evidence are mandatory.
  directReason            String?
  directApprovedByAdminId String?
  evidence                String?
  /// Over-receipt beyond the tolerance needs purchasing.approve and a reason.
  overReceiptReason       String?
  createdByAdminId        String?
  postedByAdminId         String?
  postedAt                DateTime?
  reversedByAdminId       String?
  reversedAt              DateTime?
  reversalReason          String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  lines                   GoodsReceiptLine[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([purchaseOrderId])
}

model GoodsReceiptLine {
  id                  String                @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt          @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  lineNo              Int
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine?    @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  variantId           String
  variant             ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  /// The only quantity that becomes stock.
  qtyAccepted         Int
  /// Refused at the door — no stock, no value; visible on the order.
  qtyRejected         Int                   @default(0)
  /// Unit cost (base currency, minor-exact): the order's net price, or the entered cost of a direct receipt.
  unitCost            Decimal               @db.Decimal(18, 2)
  /// qtyAccepted × unitCost — the valuation and GRNI amount.
  value               Decimal               @db.Decimal(18, 2)
  stockMovementId     String?               @unique
  reversalMovementId  String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  returnLines         PurchaseReturnLine[]
  invoiceLines        SupplierInvoiceLine[]

  @@unique([goodsReceiptId, lineNo])
  @@index([variantId])
}

/// Goods sent back to a supplier: DRAFT → APPROVED → SHIPPED (stock out at the average, Dr 2115 / Cr inventory). How the
/// supplier settles it (credit note, replacement, refund) is Phase 4E/4F.
model PurchaseReturn {
  id                String               @id @default(cuid())
  businessId        String
  business          FinanceBusiness      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId           String
  brand             FinanceBrand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  supplierId        String
  supplier          Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// FinanceSequence "purchase_return" — RTN-000001.
  number            Int
  status            PurchaseReturnStatus @default(DRAFT)
  returnDate        DateTime             @db.Date
  reason            String
  notes             String?
  createdByAdminId  String?
  approvedByAdminId String?
  approvedAt        DateTime?
  shippedByAdminId  String?
  shippedAt         DateTime?
  cancelledReason   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  lines             PurchaseReturnLine[]

  @@unique([businessId, number])
  @@index([businessId, status])
}

model PurchaseReturnLine {
  id                 String                @id @default(cuid())
  purchaseReturnId   String
  purchaseReturn     PurchaseReturn        @relation(fields: [purchaseReturnId], references: [id], onDelete: Restrict)
  lineNo             Int
  goodsReceiptLineId String?
  goodsReceiptLine   GoodsReceiptLine?     @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)
  variantId          String
  variant            ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity           Int
  /// Set when shipped: the value the stock left at (the running average, from the valuation).
  value              Decimal?              @db.Decimal(18, 2)
  stockMovementId    String?               @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  invoiceLines       SupplierInvoiceLine[]

  @@unique([purchaseReturnId, lineNo])
}

// ── Manufacturing (docs/MANUFACTURING.md) ─────────────────────────────────────────────────────────────────────────────

enum BomStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

/// Who provides a material: the business (issued from its stock, valued) or the producer (part of the producer's price —
/// never the business's inventory).
enum MaterialSupplier {
  BUSINESS
  PRODUCER
}

/// A finished product's bill of materials, versioned: an APPROVED version is frozen (a change is a new version). Lines may
/// apply to every variant of the product or to one variant (a size that takes more fabric).
model BillOfMaterials {
  id                String                @id @default(cuid())
  businessId        String
  business          FinanceBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  productId         String
  product           Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  version           Int
  status            BomStatus             @default(DRAFT)
  name              String?
  notes             String?
  createdByAdminId  String?
  approvedByAdminId String?
  approvedAt        DateTime?
  archivedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  lines             BillOfMaterialsLine[]
  productionOrders  ProductionOrder[]

  @@unique([productId, version])
  @@index([businessId, status])
}

model BillOfMaterialsLine {
  id                String           @id @default(cuid())
  bomId             String
  bom               BillOfMaterials  @relation(fields: [bomId], references: [id], onDelete: Restrict)
  lineNo            Int
  materialVariantId String
  materialVariant   ProductVariant   @relation("BomMaterial", fields: [materialVariantId], references: [id], onDelete: Restrict)
  /// Null = every variant of the product; set = only that finished variant.
  finishedVariantId String?
  finishedVariant   ProductVariant?  @relation("BomFinishedVariant", fields: [finishedVariantId], references: [id], onDelete: Restrict)
  /// Material stock units per finished unit (6 dp — e.g. 37.5 cm of fabric per cap).
  qtyPerUnit        Decimal          @db.Decimal(18, 6)
  /// Expected wastage on top of the net requirement (percent).
  wastagePct        Decimal          @default(0) @db.Decimal(5, 2)
  suppliedBy        MaterialSupplier @default(BUSINESS)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([bomId, lineNo])
}

enum ProductionOrderStatus {
  DRAFT
  APPROVED
  IN_PRODUCTION
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// A production order: a finished product made by a producer (a Supplier) or in-house, planned per variant (size ×
/// colour), with its material requirements computed from the BOM. Totals are derived from the lines — never stored.
model ProductionOrder {
  id                 String                   @id @default(cuid())
  businessId         String
  business           FinanceBusiness          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId            String
  brand              FinanceBrand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  /// FinanceSequence "production_order" — shown as MO-000001.
  number             Int
  status             ProductionOrderStatus    @default(DRAFT)
  productId          String
  product            Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// The approved BOM version the requirements were planned from (null = materials planned by hand).
  bomId              String?
  bom                BillOfMaterials?         @relation(fields: [bomId], references: [id], onDelete: Restrict)
  /// The factory / contractor; null = made in-house.
  producerSupplierId String?
  producer           Supplier?                @relation(fields: [producerSupplierId], references: [id], onDelete: Restrict)
  orderDate          DateTime                 @db.Date
  expectedDate       DateTime?                @db.Date
  /// Agreed rate, delivery and payment terms as written with the producer.
  terms              String?
  notes              String?
  createdByAdminId   String?
  approvedByAdminId  String?
  approvedAt         DateTime?
  startedAt          DateTime?
  closedAt           DateTime?
  closedReason       String?
  closedByAdminId    String?
  cancelledReason    String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  lines              ProductionOrderLine[]
  materials          ProductionMaterialLine[]
  plannedCosts       ProductionPlannedCost[]
  materialMoves      ProductionMaterialMove[]
  costEntries        ProductionCostEntry[]
  receipts           ProductionReceipt[]
  settlements        ProductionSettlement[]

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([productId])
}

model ProductionOrderLine {
  id                String                  @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder         @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  lineNo            Int
  variantId         String
  variant           ProductVariant          @relation(fields: [variantId], references: [id], onDelete: Restrict)
  plannedQty        Int
  /// Derived (trigger) from posted, not-reversed production receipts.
  deliveredQty      Int                     @default(0)
  acceptedQty       Int                     @default(0)
  rejectedQty       Int                     @default(0)
  reworkQty         Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  receiptLines      ProductionReceiptLine[]

  @@unique([productionOrderId, lineNo])
  @@unique([productionOrderId, variantId])
}

/// A material the order needs. Planned from the BOM (or by hand); M2 adds custody: issued = consumed + returned + scrapped
/// + still at the producer (CHECK). Producer-supplied materials are planned for information and never issued.
model ProductionMaterialLine {
  id                String                   @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder          @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  lineNo            Int
  materialVariantId String
  materialVariant   ProductVariant           @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  suppliedBy        MaterialSupplier
  /// Planned from the BOM (true) or added by hand (false) — re-planning replaces only the BOM's.
  fromBom           Boolean                  @default(false)
  /// Snapshots of the single BOM line the requirement came from (null when planned by hand or combined from several lines).
  bomLineId         String?
  qtyPerUnit        Decimal?                 @db.Decimal(18, 6)
  wastagePct        Decimal?                 @db.Decimal(5, 2)
  /// Whole stock units: ⌈Σ planned finished units × qty per unit × (1 + wastage)⌉.
  plannedQty        Int
  /// The material's average unit cost when the order was approved (10⁻⁶ major units) — the planned cost basis; null when
  /// no cost was known.
  plannedUnitCost   Decimal?                 @db.Decimal(18, 6)
  issuedQty         Int                      @default(0)
  returnedQty       Int                      @default(0)
  consumedQty       Int                      @default(0)
  scrappedQty       Int                      @default(0)
  moves             ProductionMaterialMove[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([productionOrderId, lineNo])
}

enum ProductionCostGroup {
  MATERIAL
  LABOUR
  EXTERNAL_SERVICE
  OVERHEAD
  OTHER
}

/// Configurable production cost categories (cutting, sewing, embroidery, freight, samples, …). Seeded once per business;
/// the owner adds and deactivates — never deletes — categories.
model ProductionCostCategory {
  id           String                  @id @default(cuid())
  businessId   String
  business     FinanceBusiness         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  code         String
  name         String
  group        ProductionCostGroup
  isActive     Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  plannedCosts ProductionPlannedCost[]
  costEntries  ProductionCostEntry[]

  @@unique([businessId, code])
}

/// The planned (budgeted) non-material costs of an order, per category — compared with actual costs (M3/M5).
model ProductionPlannedCost {
  id                String                 @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  categoryId        String
  category          ProductionCostCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount            Decimal                @db.Decimal(18, 2)
  /// How it was estimated (e.g. "1,000 pcs × ৳45 sewing rate").
  basis             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([productionOrderId, categoryId])
}

enum ProductionMoveKind {
  ISSUE
  RETURN
}

/// One issue of material to a production order, or one return of unused material from it (docs/MANUFACTURING.md §6) —
/// append-only. Its stock movement and valuation come from inventory.service / costing.service; `value` is what the books
/// moved between inventory and work in progress for it.
model ProductionMaterialMove {
  id                String                 @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  materialLineId    String
  materialLine      ProductionMaterialLine @relation(fields: [materialLineId], references: [id], onDelete: Restrict)
  kind              ProductionMoveKind
  quantity          Int
  /// Book value moved (minor-exact, base currency) — issues at the running average, returns at the line's average issued cost.
  value             Decimal                @db.Decimal(18, 2)
  /// The valuation's status for the units (KNOWN / ESTIMATED / MISSING when issued with no known cost).
  valuationStatus   FinanceValuationStatus
  stockMovementId   String                 @unique
  /// Client Idempotency-Key of the request that made it (one request = one set of moves).
  requestKey        String?
  overIssueReason   String?
  note              String?
  createdByAdminId  String?
  createdAt         DateTime               @default(now())

  @@unique([productionOrderId, requestKey, materialLineId, kind])
  @@index([productionOrderId, createdAt])
  @@index([materialLineId])
}

enum ProductionCostStatus {
  DRAFT
  APPROVED
  VOID
}

/// One actual production cost of an order (docs/MANUFACTURING.md §7): CMT, sewing, embroidery, freight, samples… DRAFT →
/// APPROVED (by someone other than who entered it; accrues Dr 1630 WIP / Cr 2116 production costs accrued) → VOID (the
/// accrual reversed). The supplier's invoice clears 2116 later (Phase 4E), so a cost is never counted twice.
model ProductionCostEntry {
  id                String                 @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder        @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  categoryId        String
  category          ProductionCostCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// The payee (factory, embroiderer, transporter); null for an internal cost.
  supplierId        String?
  supplier          Supplier?              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// The supplier's bill / challan / reference — unique per supplier and category while not void (no double capture).
  reference         String?
  description       String
  costDate          DateTime               @db.Date
  /// Optional quantity × rate (e.g. 1,000 pcs × 45); the amount is then their product, half-even to minor units.
  quantity          Decimal?               @db.Decimal(18, 4)
  unitRate          Decimal?               @db.Decimal(18, 6)
  amount            Decimal                @db.Decimal(18, 2)
  evidence          String?
  status            ProductionCostStatus   @default(DRAFT)
  createdByAdminId  String?
  approvedByAdminId String?
  approvedAt        DateTime?
  voidedByAdminId   String?
  voidedAt          DateTime?
  voidReason        String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  settlements       ProductionSettlement[]
  invoiceLines      SupplierInvoiceLine[]

  @@index([productionOrderId, status])
  @@index([supplierId])
}

enum ProductionReceiptStatus {
  DRAFT
  POSTED
  REVERSED
}

/// A delivery from production, inspected (docs/MANUFACTURING.md §8): per finished variant, what was delivered, accepted,
/// rejected and sent back for rework. Posting puts the accepted units into stock at the order's provisional unit cost and
/// moves that value out of work in progress (Dr 1610 / Cr 1630). Idempotent; a posted receipt is immutable — reversed, never
/// edited. Rejected units never become stock.
model ProductionReceipt {
  id                  String                  @id @default(cuid())
  productionOrderId   String
  productionOrder     ProductionOrder         @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  /// FinanceSequence "production_receipt" — PR-000001.
  number              Int
  status              ProductionReceiptStatus @default(DRAFT)
  receiptDate         DateTime                @db.Date
  deliveryRef         String?
  inspectionNotes     String?
  evidence            String?
  overReceiptReason   String?
  /// The provisional unit cost the accepted units entered stock at (major units, 6 dp) — ESTIMATED until the order closes.
  provisionalUnitCost Decimal?                @db.Decimal(18, 6)
  createdByAdminId    String?
  postedByAdminId     String?
  postedAt            DateTime?
  reversedByAdminId   String?
  reversedAt          DateTime?
  reversalReason      String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  lines               ProductionReceiptLine[]

  @@index([productionOrderId, status])
}

model ProductionReceiptLine {
  id                 String              @id @default(cuid())
  receiptId          String
  receipt            ProductionReceipt   @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  orderLineId        String
  orderLine          ProductionOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  variantId          String
  variant            ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  delivered          Int
  accepted           Int
  rejected           Int                 @default(0)
  rework             Int                 @default(0)
  rejectReason       String?
  /// Set at post: accepted × the provisional unit cost (minor-exact).
  unitCost           Decimal?            @db.Decimal(18, 2)
  value              Decimal?            @db.Decimal(18, 2)
  stockMovementId    String?             @unique
  reversalMovementId String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([receiptId, orderLineId])
}

enum ProductionSettlementKind {
  CLOSE
  LATE_COST
}

/// A production order's work in progress swept out (docs/MANUFACTURING.md §9): at CLOSE the remaining WIP (final cost −
/// value transferred provisionally) goes to the finished goods — revalued through costing (REVALUE: the units still held,
/// 5150 for the share already sold) — less an approved abnormal loss to 5220; a LATE_COST after close takes the same path.
/// Append-only; transfer + abnormal loss = the residual swept, and WIP for the order returns to zero.
model ProductionSettlement {
  id                 String                     @id @default(cuid())
  productionOrderId  String
  productionOrder    ProductionOrder            @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  kind               ProductionSettlementKind
  /// The late cost (or its void) that caused a LATE_COST settlement.
  costEntryId        String?
  costEntry          ProductionCostEntry?       @relation(fields: [costEntryId], references: [id], onDelete: Restrict)
  /// The order's WIP swept (signed) = transfer + abnormalLoss.
  residual           Decimal                    @db.Decimal(18, 2)
  /// To finished goods (signed: a negative transfer lowers their cost).
  transfer           Decimal                    @db.Decimal(18, 2)
  /// Approved write-off to production losses (5220), never negative.
  abnormalLoss       Decimal                    @db.Decimal(18, 2)
  abnormalLossReason String?
  financialDate      DateTime                   @db.Date
  createdByAdminId   String?
  createdAt          DateTime                   @default(now())
  lines              ProductionSettlementLine[]

  @@index([productionOrderId])
  @@index([costEntryId])
}

/// The transfer per finished variant, by accepted share: delta = heldShare (revalued stock) + soldShare (5150).
model ProductionSettlementLine {
  id               String               @id @default(cuid())
  settlementId     String
  settlement       ProductionSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  variantId        String
  variant          ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  /// The accepted units of the order the delta is spread over.
  qty              Int
  delta            Decimal              @db.Decimal(18, 2)
  heldShare        Decimal              @db.Decimal(18, 2)
  soldShare        Decimal              @db.Decimal(18, 2)
  valuationEntryId String?

  @@unique([settlementId, variantId])
  @@index([variantId])
}

// ── Accounts payable (docs/FINANCE_PHASE_4E.md) ─────────────────────────────────

enum SupplierInvoiceKind {
  INVOICE
  CREDIT_NOTE
}

enum SupplierInvoiceStatus {
  DRAFT
  POSTED
  VOID
}

/// What a supplier invoice line bills: received goods (3-way: order, receipt, invoice), goods returned to the supplier
/// (on a credit note), an expense or service (2-way, optionally against an order line), or an approved production cost
/// (clears its accrual).
enum SupplierInvoiceLineType {
  STOCK
  RETURN
  EXPENSE
  PRODUCTION_COST
}

/// A supplier's invoice or credit note: DRAFT → POSTED (Dr GRNI / returns / accrual / expense + recoverable tax, Cr AP;
/// a price difference on received goods revalues them — held share — or goes to 5150) → VOID (its journal reversed).
/// The supplier's own reference is unique per supplier and kind while live, so a bill is never entered twice.
model SupplierInvoice {
  id                String                @id @default(cuid())
  businessId        String
  business          FinanceBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  brandId           String
  brand             FinanceBrand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  supplierId        String
  supplier          Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  kind              SupplierInvoiceKind
  /// FinanceSequence "supplier_invoice" — BILL-000001 / CN-000001.
  number            Int
  status            SupplierInvoiceStatus @default(DRAFT)
  /// The supplier's invoice / credit-note number.
  supplierRef       String
  invoiceDate       DateTime              @db.Date
  dueDate           DateTime              @db.Date
  currency          String                @db.VarChar(3)
  notes             String?
  evidence          String?
  /// Price beyond the business's tolerance against the order: approved (purchasing.approve) with this reason.
  varianceReason    String?
  /// Set when posted: Σ net, Σ tax, total payable (minor-exact).
  netTotal          Decimal?              @db.Decimal(18, 2)
  taxTotal          Decimal?              @db.Decimal(18, 2)
  total             Decimal?              @db.Decimal(18, 2)
  createdByAdminId  String?
  postedByAdminId   String?
  postedAt          DateTime?
  voidedByAdminId   String?
  voidedAt          DateTime?
  voidReason        String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  lines             SupplierInvoiceLine[]
  allocations       SupplierAllocation[]  @relation("AllocationBill")
  creditAllocations SupplierAllocation[]  @relation("AllocationCredit")
  refunds           TreasuryMovement[]    @relation("SupplierRefundOfCredit")

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([supplierId, status])
}

model SupplierInvoiceLine {
  id                    String                  @id @default(cuid())
  invoiceId             String
  invoice               SupplierInvoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lineNo                Int
  lineType              SupplierInvoiceLineType
  description           String
  goodsReceiptLineId    String?
  goodsReceiptLine      GoodsReceiptLine?       @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)
  purchaseReturnLineId  String?
  purchaseReturnLine    PurchaseReturnLine?     @relation(fields: [purchaseReturnLineId], references: [id], onDelete: Restrict)
  purchaseOrderLineId   String?
  purchaseOrderLine     PurchaseOrderLine?      @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  productionCostEntryId String?
  productionCostEntry   ProductionCostEntry?    @relation(fields: [productionCostEntryId], references: [id], onDelete: Restrict)
  expenseAccountId      String?
  expenseAccount        LedgerAccount?          @relation("SupplierInvoiceExpense", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  variantId             String?
  variant               ProductVariant?         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity              Int
  /// Net of discount, per unit.
  unitPrice             Decimal                 @db.Decimal(18, 2)
  taxCodeId             String?
  taxCode               TaxCode?                @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  /// quantity × unitPrice; its tax (half-even) and the recoverable share of it.
  netAmount             Decimal                 @db.Decimal(18, 2)
  taxAmount             Decimal                 @db.Decimal(18, 2)
  recoverableTax        Decimal                 @db.Decimal(18, 2)
  /// Set when posted: the GRNI / returns / accrual value this line clears, and the difference to the billed cost.
  clearedAmount         Decimal?                @db.Decimal(18, 2)
  priceDifference       Decimal?                @db.Decimal(18, 2)
  createdAt             DateTime                @default(now())

  @@unique([invoiceId, lineNo])
  @@index([goodsReceiptLineId])
  @@index([purchaseReturnLineId])
  @@index([productionCostEntryId])
}

enum SupplierAllocationStatus {
  ACTIVE
  RELEASED
}

/// Settles part of a supplier bill (Phase 4F, docs/FINANCE_PHASE_4F.md) from a supplier payment or a credit note. No
/// journal: payment and bill already sit on the same payables account for the same supplier — an allocation only says which
/// bill the money or credit went to. A bill's outstanding amount = its total − its ACTIVE allocations. Released (with a
/// reason), never changed or deleted.
model SupplierAllocation {
  id                String                   @id @default(cuid())
  businessId        String
  business          FinanceBusiness          @relation(fields: [businessId], references: [id], onDelete: Restrict)
  supplierId        String
  supplier          Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceId         String
  invoice           SupplierInvoice          @relation("AllocationBill", fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentMovementId String?
  paymentMovement   TreasuryMovement?        @relation(fields: [paymentMovementId], references: [id], onDelete: Restrict)
  creditNoteId      String?
  creditNote        SupplierInvoice?         @relation("AllocationCredit", fields: [creditNoteId], references: [id], onDelete: Restrict)
  amount            Decimal                  @db.Decimal(18, 2)
  status            SupplierAllocationStatus @default(ACTIVE)
  createdByAdminId  String?
  createdAt         DateTime                 @default(now())
  releasedByAdminId String?
  releasedAt        DateTime?
  releaseReason     String?

  @@index([invoiceId, status])
  @@index([paymentMovementId])
  @@index([creditNoteId])
  @@index([supplierId])
}

// ── Expenses & recurring commitments (docs/FINANCE_EXPENSES.md) ─────────────────

/// How a cost moves with sales: FIXED (rent, salaries — the break-even base) or VARIABLE (packaging, delivery).
enum CostBehaviour {
  FIXED
  VARIABLE
}

enum CommitmentFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A cost the business owes every period (rent, salaries, a subscription): its account, amount and schedule. It posts
/// nothing itself — paying a period records an Expense linked to it; the schedule shows what is due and what is paid.
model RecurringCommitment {
  id                 String              @id @default(cuid())
  businessId         String
  business           FinanceBusiness     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name               String
  expenseAccountId   String
  expenseAccount     LedgerAccount       @relation("CommitmentAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  amount             Decimal             @db.Decimal(18, 2)
  frequency          CommitmentFrequency
  /// Day of the month it falls due (1–28, so every month has it).
  dayOfMonth         Int
  startDate          DateTime            @db.Date
  endDate            DateTime?           @db.Date
  costBehaviour      CostBehaviour       @default(FIXED)
  payee              String?
  supplierId         String?
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  /// The money account it is usually paid from (a default, never enforced).
  financialAccountId String?
  financialAccount   FinancialAccount?   @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  isActive           Boolean             @default(true)
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  expenses           Expense[]

  @@index([businessId, isActive])
}

/// An operating expense paid from a money account: a Treasury WITHDRAWAL (Dr the expense account / Cr the money
/// account — approval thresholds, overdraft rules and reversal as for any money movement) plus what the movement doesn't
/// say: cost behaviour, payee, evidence and the commitment period it pays. Its state is its movement's state. Immutable.
model Expense {
  id               String               @id @default(cuid())
  businessId       String
  business         FinanceBusiness      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// FinanceSequence "expense" — EXP-000001.
  number           Int
  expenseDate      DateTime             @db.Date
  expenseAccountId String
  expenseAccount   LedgerAccount        @relation("ExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  amount           Decimal              @db.Decimal(18, 2)
  costBehaviour    CostBehaviour
  payee            String?
  description      String
  reference        String?
  evidence         String?
  movementId       String               @unique
  movement         TreasuryMovement     @relation(fields: [movementId], references: [id], onDelete: Restrict)
  commitmentId     String?
  commitment       RecurringCommitment? @relation(fields: [commitmentId], references: [id], onDelete: Restrict)
  /// The commitment period it pays (YYYY-MM of the due date).
  periodKey        String?
  createdByAdminId String?
  createdAt        DateTime             @default(now())
  /// Finance Center: an expense paid into "Expenses awaiting allocation" is split later into where it belongs.
  allocations      ExpenseAllocation[]

  @@unique([businessId, number])
  @@index([businessId, expenseDate])
  @@index([commitmentId, periodKey])
}

// ── Fixed assets (docs/FINANCE_FIXED_ASSETS.md) ─────────────────────────────────

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

enum FixedAssetStatus {
  IN_USE
  DISPOSED
}

/// An asset the business keeps and uses for more than a year: its cost (already on its asset account — from a supplier
/// bill line, a money movement or the opening balances), how it depreciates, and its disposal. Depreciation runs post
/// monthly; the register equals the fixed-asset accounts (check fixed_assets.register).
model FixedAsset {
  id                             String             @id @default(cuid())
  businessId                     String
  business                       FinanceBusiness    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// FinanceSequence "fixed_asset" — FA-0001.
  number                         Int
  name                           String
  category                       String?
  assetAccountId                 String
  assetAccount                   LedgerAccount      @relation("FixedAssetAccount", fields: [assetAccountId], references: [id], onDelete: Restrict)
  acquisitionDate                DateTime           @db.Date
  cost                           Decimal            @db.Decimal(18, 2)
  residualValue                  Decimal            @default(0) @db.Decimal(18, 2)
  usefulLifeMonths               Int
  method                         DepreciationMethod @default(STRAIGHT_LINE)
  /// DECLINING_BALANCE only: the yearly rate (percent of the book value).
  decliningRatePct               Decimal?           @db.Decimal(7, 4)
  /// The first month depreciated (YYYY-MM).
  depreciationStart              String
  /// Depreciation it carried in from before the books (already in accumulated depreciation's opening balance).
  openingAccumulatedDepreciation Decimal            @default(0) @db.Decimal(18, 2)
  location                       String?
  custodian                      String?
  serialNumber                   String?
  notes                          String?
  /// Where its cost came from: "SUPPLIER_INVOICE", "MONEY_MOVEMENT", "OPENING_BALANCE" or "OTHER" (with a reference).
  sourceType                     String
  sourceRef                      String?
  status                         FixedAssetStatus   @default(IN_USE)
  disposedAt                     DateTime?          @db.Date
  disposalProceeds               Decimal?           @db.Decimal(18, 2)
  disposalFinancialAccountId     String?
  disposalFinancialAccount       FinancialAccount?  @relation(fields: [disposalFinancialAccountId], references: [id], onDelete: Restrict)
  disposalGainLoss               Decimal?           @db.Decimal(18, 2)
  disposalReason                 String?
  disposalJournalId              String?            @unique
  /// The Treasury deposit that brought the sale proceeds in (against asset.disposal_receivable).
  disposalMovementId             String?            @unique
  disposalMovement               TreasuryMovement?  @relation("FixedAssetDisposalProceeds", fields: [disposalMovementId], references: [id], onDelete: Restrict)
  disposalJournal                JournalEntry?      @relation("DisposalJournal", fields: [disposalJournalId], references: [id], onDelete: Restrict)
  createdByAdminId               String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt
  depreciationLines              DepreciationLine[]

  @@unique([businessId, number])
  @@index([businessId, status])
}

enum DepreciationRunStatus {
  POSTED
  REVERSED
}

/// One month's depreciation of every asset in use: one journal (Dr depreciation / Cr accumulated depreciation, each asset
/// as party), posted once per month (runs go in order; only the latest is reversed).
model DepreciationRun {
  id               String                @id @default(cuid())
  businessId       String
  business         FinanceBusiness       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// YYYY-MM
  periodKey        String
  status           DepreciationRunStatus @default(POSTED)
  total            Decimal               @db.Decimal(18, 2)
  journalEntryId   String?               @unique
  journalEntry     JournalEntry?         @relation("DepreciationJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  createdByAdminId String?
  createdAt        DateTime              @default(now())
  reversedAt       DateTime?
  reversalReason   String?
  lines            DepreciationLine[]

  @@index([businessId, periodKey])
}

model DepreciationLine {
  id      String          @id @default(cuid())
  runId   String
  run     DepreciationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  assetId String
  asset   FixedAsset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  amount  Decimal         @db.Decimal(18, 2)

  @@unique([runId, assetId])
  @@index([assetId])
}

// ── Loans (docs/FINANCE_LOANS.md) ───────────────────────────────────────────────

enum LoanRepaymentType {
  /// Equal instalments (annuity): interest falls and principal rises over the term.
  ANNUITY
  /// Equal principal each month, interest on what is left.
  EQUAL_PRINCIPAL
}

/// Money borrowed (from a bank or other lender — partner loans wait for B-2): drawn into a money account as a Treasury
/// DEPOSIT against the loan liability; interest accrues monthly (LoanAccrualRun); repayments pay accrued interest first,
/// then principal (two Treasury WITHDRAWALs). What is owed is derived from posted documents, never stored.
model Loan {
  id                 String            @id @default(cuid())
  businessId         String
  business           FinanceBusiness   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// FinanceSequence "loan" — LN-001.
  number             Int
  lender             String
  reference          String?
  principal          Decimal           @db.Decimal(18, 2)
  /// Percent a year.
  annualRatePct      Decimal           @db.Decimal(7, 4)
  termMonths         Int
  repaymentType      LoanRepaymentType @default(ANNUITY)
  drawdownDate       DateTime          @db.Date
  firstDueDate       DateTime          @db.Date
  financialAccountId String
  financialAccount   FinancialAccount  @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  drawdownMovementId String            @unique
  drawdownMovement   TreasuryMovement  @relation("LoanDrawdown", fields: [drawdownMovementId], references: [id], onDelete: Restrict)
  notes              String?
  createdByAdminId   String?
  createdAt          DateTime          @default(now())
  repayments         LoanRepayment[]
  accrualLines       LoanAccrualLine[]

  @@unique([businessId, number])
}

/// A repayment: its interest part (clearing accrued interest) and principal part, each a Treasury WITHDRAWAL from the same
/// money account. It counts while its movements are posted.
model LoanRepayment {
  id                  String            @id @default(cuid())
  loanId              String
  loan                Loan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  paymentDate         DateTime          @db.Date
  interestPart        Decimal           @db.Decimal(18, 2)
  principalPart       Decimal           @db.Decimal(18, 2)
  interestMovementId  String?           @unique
  interestMovement    TreasuryMovement? @relation("RepaymentInterest", fields: [interestMovementId], references: [id], onDelete: Restrict)
  principalMovementId String?           @unique
  principalMovement   TreasuryMovement? @relation("RepaymentPrincipal", fields: [principalMovementId], references: [id], onDelete: Restrict)
  reference           String?
  createdByAdminId    String?
  createdAt           DateTime          @default(now())

  @@index([loanId])
}

enum LoanAccrualStatus {
  POSTED
  REVERSED
}

/// One month's interest on every active loan: one journal (Dr expense.interest / Cr liability.accrued_interest, each loan
/// as party), posted once per month; months in order; only the latest reversed.
model LoanAccrualRun {
  id               String            @id @default(cuid())
  businessId       String
  business         FinanceBusiness   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  periodKey        String
  status           LoanAccrualStatus @default(POSTED)
  total            Decimal           @db.Decimal(18, 2)
  journalEntryId   String?           @unique
  journalEntry     JournalEntry?     @relation("LoanAccrualJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  createdByAdminId String?
  createdAt        DateTime          @default(now())
  reversedAt       DateTime?
  reversalReason   String?
  lines            LoanAccrualLine[]

  @@index([businessId, periodKey])
}

model LoanAccrualLine {
  id     String         @id @default(cuid())
  runId  String
  run    LoanAccrualRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  loanId String
  loan   Loan           @relation(fields: [loanId], references: [id], onDelete: Restrict)
  amount Decimal        @db.Decimal(18, 2)

  @@unique([runId, loanId])
  @@index([loanId])
}

// ── Budgets (docs/FINANCE_BUDGETS.md) ───────────────────────────────────────────

/// A plan for income-statement accounts, month by month, compared with the books (budget vs actual). A plan, not a
/// financial record: editable, audited, never posted.
model Budget {
  id               String          @id @default(cuid())
  businessId       String
  business         FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name             String
  /// The first month it covers (YYYY-MM) and how many months.
  startMonth       String
  months           Int             @default(12)
  notes            String?
  createdByAdminId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lines            BudgetLine[]

  @@unique([businessId, name])
}

model BudgetLine {
  id        String        @id @default(cuid())
  budgetId  String
  budget    Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId String
  account   LedgerAccount @relation("BudgetAccount", fields: [accountId], references: [id], onDelete: Restrict)
  periodKey String
  /// In the account's natural direction: revenue earned, costs spent (never negative).
  amount    Decimal       @db.Decimal(18, 2)

  @@unique([budgetId, accountId, periodKey])
  @@index([accountId])
}

// ── ERP E8 — payroll (docs/FINANCE_PAYROLL.md) ─────────────────────────────────────────────────────────────────────────
// A configurable structure: the owner defines the components (B-3 — no statutory rule is built in).

enum PayComponentKind {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

enum PayCalculation {
  FIXED
  PERCENT_OF_BASIC
}

enum PayRunStatus {
  DRAFT
  POSTED
  REVERSED
}

/// Someone the business pays a salary to. Never deleted: a leaver gets a leaving date.
model Employee {
  id               String            @id @default(cuid())
  businessId       String
  business         FinanceBusiness   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// FinanceSequence "employee" — shown as EMP-001.
  number           Int
  name             String
  designation      String?
  department       String?
  phone            String?
  /// Where the salary goes (bank account, bKash number) — free text.
  payoutDetails    String?
  joinDate         DateTime          @db.Date
  leaveDate        DateTime?         @db.Date
  notes            String?
  createdByAdminId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payItems         EmployeePayItem[]
  payslips         Payslip[]

  @@unique([businessId, number])
}

/// A line of pay the owner defines: an earning (basic, allowances, bonus), a deduction withheld from pay (tax, provident
/// fund, advance recovery) or an employer contribution (cost on top of pay). Fixed, or a percentage of basic.
model PayComponent {
  id                 String            @id @default(cuid())
  businessId         String
  business           FinanceBusiness   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name               String
  kind               PayComponentKind
  calculation        PayCalculation    @default(FIXED)
  /// The basic salary — what PERCENT_OF_BASIC components are a percentage of (one per business).
  isBasic            Boolean           @default(false)
  ratePct            Decimal?          @db.Decimal(7, 4)
  /// Earnings and employer contributions: the expense they post to.
  expenseAccountId   String?
  expenseAccount     LedgerAccount?    @relation("PayComponentExpense", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  /// Deductions and employer contributions: the liability they are owed on until remitted.
  liabilityAccountId String?
  liabilityAccount   LedgerAccount?    @relation("PayComponentLiability", fields: [liabilityAccountId], references: [id], onDelete: Restrict)
  isActive           Boolean           @default(true)
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  payItems           EmployeePayItem[]
  payslipLines       PayslipLine[]

  @@unique([businessId, name])
}

/// A component an employee is paid: a fixed amount, or (percentage components) an optional own rate.
model EmployeePayItem {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  componentId String
  component   PayComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  amount      Decimal?     @db.Decimal(18, 2)
  ratePct     Decimal?     @db.Decimal(7, 4)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([employeeId, componentId])
}

/// One month's payroll: drafted from the pay structure, edited, then posted as ONE journal (Dr expense / Cr salaries
/// payable, deductions and contributions payable). One live run per month; reversed only while nothing is paid.
model PayRun {
  id               String          @id @default(cuid())
  businessId       String
  business         FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// FinanceSequence "pay_run" — shown as PR-001.
  number           Int
  periodKey        String
  payDate          DateTime        @db.Date
  status           PayRunStatus    @default(DRAFT)
  gross            Decimal         @default(0) @db.Decimal(18, 2)
  deductions       Decimal         @default(0) @db.Decimal(18, 2)
  net              Decimal         @default(0) @db.Decimal(18, 2)
  employerCost     Decimal         @default(0) @db.Decimal(18, 2)
  journalEntryId   String?         @unique
  journalEntry     JournalEntry?   @relation("PayRunJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  notes            String?
  createdByAdminId String?
  postedByAdminId  String?
  postedAt         DateTime?
  reversedAt       DateTime?
  reversalReason   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  payslips         Payslip[]

  @@unique([businessId, number])
  @@index([businessId, periodKey])
}

model Payslip {
  id           String           @id @default(cuid())
  runId        String
  run          PayRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// Days paid of the days in the month (joiners and leavers are prorated by default; editable in the draft).
  daysPayable  Int
  daysInPeriod Int
  gross        Decimal          @default(0) @db.Decimal(18, 2)
  deductions   Decimal          @default(0) @db.Decimal(18, 2)
  net          Decimal          @default(0) @db.Decimal(18, 2)
  employerCost Decimal          @default(0) @db.Decimal(18, 2)
  lines        PayslipLine[]
  payments     PayslipPayment[]

  @@unique([runId, employeeId])
  @@index([employeeId])
}

model PayslipLine {
  id          String           @id @default(cuid())
  payslipId   String
  payslip     Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentId String
  component   PayComponent     @relation(fields: [componentId], references: [id], onDelete: Restrict)
  kind        PayComponentKind
  amount      Decimal          @db.Decimal(18, 2)

  @@unique([payslipId, componentId])
}

/// A payslip paid (in full) by a money movement — one movement can pay many payslips. Counts while the movement is live.
model PayslipPayment {
  id         String           @id @default(cuid())
  payslipId  String
  payslip    Payslip          @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  movementId String
  movement   TreasuryMovement @relation("PayslipPaymentMovement", fields: [movementId], references: [id], onDelete: Restrict)
  amount     Decimal          @db.Decimal(18, 2)
  createdAt  DateTime         @default(now())

  @@unique([payslipId, movementId])
  @@index([movementId])
}

/// Deductions or contributions withheld and paid over (tax to the revenue authority, provident fund to the trustees).
model PayrollRemittance {
  id                 String           @id @default(cuid())
  businessId         String
  business           FinanceBusiness  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  liabilityAccountId String
  liabilityAccount   LedgerAccount    @relation("PayrollRemittanceAccount", fields: [liabilityAccountId], references: [id], onDelete: Restrict)
  movementId         String           @unique
  movement           TreasuryMovement @relation("PayrollRemittanceMovement", fields: [movementId], references: [id], onDelete: Restrict)
  amount             Decimal          @db.Decimal(18, 2)
  periodKey          String?
  reference          String?
  createdByAdminId   String?
  createdAt          DateTime         @default(now())

  @@index([businessId, liabilityAccountId])
}

// ── ERP E11 — partners & equity, foundation (docs/FINANCE_EQUITY.md) ────────────────────────────────────────────────────
// B-2 (signed partner agreements) blocks profit distribution and capital rules; the register and accounts do not wait.

/// A partner of the business, with their own capital and current accounts (sensitive equity sub-accounts).
model Partner {
  id                 String          @id @default(cuid())
  businessId         String
  business           FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// FinanceSequence "partner" — shown as PT-01.
  number             Int
  name               String
  phone              String?
  email              String?
  joinedOn           DateTime        @db.Date
  leftOn             DateTime?       @db.Date
  /// The share the partners have discussed — UNCONFIRMED until the signed agreement (B-2); nothing is computed from it.
  agreedSharePct     Decimal?        @db.Decimal(7, 4)
  agreementReference String?
  /// OWNER: the business's owner — capital is 3100 Owner capital, the current account is 3300 Drawings (one per business).
  /// WORKING: shares profit for their work and puts in no capital. INVESTOR: a partner with capital.
  role               PartnerRole     @default(INVESTOR)
  /// The CONFIRMED share of each month's net profit (docs/FINANCE_EQUITY.md §8) — profit shares are computed from it.
  profitSharePct     Decimal?        @db.Decimal(7, 4)
  shareFrom          DateTime?       @db.Date
  lossRule           ProfitShareLossRule @default(ZERO_IN_LOSS_MONTHS)
  shareConfirmedAt   DateTime?
  shareConfirmedNote String?
  profitShares       ProfitShare[]
  capitalAccountId   String          @unique
  capitalAccount     LedgerAccount   @relation("PartnerCapital", fields: [capitalAccountId], references: [id], onDelete: Restrict)
  currentAccountId   String          @unique
  currentAccount     LedgerAccount   @relation("PartnerCurrent", fields: [currentAccountId], references: [id], onDelete: Restrict)
  notes              String?
  createdByAdminId   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([businessId, number])
}

/// Integration credentials and ids an OWNER manages from Settings › Integrations (catalog: packages/shared integrations.ts).
/// `key` is the environment variable name the value overrides; `value` is always sealed (lib/secret-box.ts
/// sealIntegrationValue) — read and written only by modules/settings/integrations.service.ts. No row = the environment
/// variable (if any) applies.
model IntegrationSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// One kind of production failure (Site health, docs/superpowers/plans/2026-10-16-site-health.md). Rows are written only
/// by lib/observability/error-store-reporter.ts — grouped by `fingerprint` (lib/observability/error-fingerprint.ts) so
/// a failure that repeats a thousand times is one row with count 1000. Text is masked (maskText) before it is stored.
/// Never business truth: deleting every row loses nothing but history.
model ErrorGroup {
  id                String    @id @default(cuid())
  fingerprint       String    @unique
  /// "api" | "web"
  source            String
  errorClass        String
  /// "<ErrorName>: <masked message>", at most 200 characters.
  title             String
  /// Masked, first 8 stack lines of the latest occurrence.
  sampleStack       String?
  /// API route ("POST /api/orders/") or the website path of the latest occurrence.
  lastPath          String?
  lastCorrelationId String?
  count             Int       @default(0)
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime
  /// Set by "Mark fixed"; a new occurrence clears it again.
  resolvedAt        DateTime?

  @@index([resolvedAt, lastSeenAt])
}

/// One Core Web Vitals reading from a real storefront visit (Site health › Site speed). Anonymous by design: no visitor,
/// session, IP or user agent — only which kind of page, which kind of device and the number. Written by POST /api/v1/vitals,
/// summarised as 75th percentiles by modules/ops/web-vitals.service.ts, deleted after 30 days (jobs/site-health-retention-cron.ts).
model WebVitalSample {
  id        String   @id @default(cuid())
  /// "LCP" | "INP" | "CLS" | "FCP" | "TTFB" (packages/shared web-vitals.ts)
  metric    String
  value     Float
  /// PageKind: "home" | "category" | "product" | …
  pageKind  String
  /// "mobile" | "desktop"
  device    String
  createdAt DateTime @default(now())

  @@index([createdAt, metric])
}

/// A physical count of one variant (docs/FINANCE_CENTER.md §7). Recorded BESIDE the site's stock, never written into it:
/// the stock check shows the difference, and any correction stays an ordinary, reasoned stock adjustment.
model StockCount {
  id               String          @id @default(cuid())
  businessId       String
  business         FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  variantId        String
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  countDate        DateTime        @db.Date
  counted          Int
  /// The site's stock when the count was recorded.
  siteStock        Int
  note             String?
  countedByAdminId String?
  createdAt        DateTime        @default(now())

  @@index([variantId, countDate])
}

/// A roll of a material used up over many parcels (bubble poly). Opened and finished on dates; the parcels booked with
/// the courier in between are its yield, so a cost per parcel exists only once a real roll has been finished.
model MaterialRoll {
  id                String          @id @default(cuid())
  businessId        String
  business          FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  materialVariantId String
  materialVariant   ProductVariant  @relation(fields: [materialVariantId], references: [id], onDelete: Restrict)
  openedOn          DateTime        @db.Date
  finishedOn        DateTime?       @db.Date
  /// Typed when the parcels were counted; otherwise the courier bookings between the dates are used.
  parcelsCounted    Int?
  note              String?
  createdByAdminId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([materialVariantId, openedOn])
}

enum PartnerRole {
  OWNER
  WORKING
  INVESTOR
}

enum ProfitShareLossRule {
  /// A loss month shares nothing; the next month shares its whole profit (losses are not carried).
  ZERO_IN_LOSS_MONTHS
  /// Losses are made good from later profit before anything is shared.
  CARRY_LOSSES
}

/// One partner's share of one finished month's net profit (docs/FINANCE_EQUITY.md §8). Posted once (Dr 3350 profit shared,
/// Cr the partner's current account) and never recomputed: a later change to that month's profit is settled in the next
/// month's share as a correction line.
model ProfitShare {
  id               String          @id @default(cuid())
  businessId       String
  business         FinanceBusiness @relation(fields: [businessId], references: [id], onDelete: Restrict)
  partnerId        String
  partner          Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  /// YYYY-MM
  period           String
  periodStart      DateTime        @db.Date
  periodEnd        DateTime        @db.Date
  /// The month's net profit when it was shared (negative = a loss).
  netProfit        Decimal         @db.Decimal(18, 2)
  sharePct         Decimal         @db.Decimal(7, 4)
  /// pct × the month's profit under the loss rule.
  monthShare       Decimal         @db.Decimal(18, 2)
  /// [{ period, amount, note }] — differences from earlier months whose profit changed, and any amount carried.
  corrections      Json            @default("[]")
  /// What was credited to the partner: monthShare + corrections, never below 0 (a negative rest is carried).
  amount           Decimal         @db.Decimal(18, 2)
  carried          Decimal         @default(0) @db.Decimal(18, 2)
  eventId          String?
  createdByAdminId String?
  createdAt        DateTime        @default(now())

  @@unique([partnerId, period])
  @@index([businessId, period])
}
