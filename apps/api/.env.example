NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clothing_brand?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_CUSTOMER_ACCESS_SECRET=change-me-customer-access-secret
JWT_CUSTOMER_REFRESH_SECRET=change-me-customer-refresh-secret
WEB_ORIGIN=http://localhost:3000
# The API's own public origin — embedded directly into category/banner/logo/editor image URLs
# (see uploads/upload.service.ts's processSiteImage). In production this MUST be the real public
# domain (e.g. https://yourdomain.com), never left unset — see docker/.env.example.
API_ORIGIN=http://localhost:4000
UPLOADS_DIR=uploads

# used only by prisma/seed.ts to create the first admin login
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# optional — enables the AI Admin Assistant (product copy, SEO, marketing/email generation,
# image alt text) in the admin console; the feature stays off with a clear setup hint until set
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# optional — without a key, sendMail() falls back to writing emails to apps/api/.devmail/
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# optional — without credentials, sendSms() logs instead of sending
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# optional — without keys, sendPush() logs instead of sending. Generate a pair with
# `npx web-push generate-vapid-keys`
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=support@example.com

# optional — without a client ID, the Google sign-in button never renders. Create one at
# https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application").
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in apps/web/.env
GOOGLE_CLIENT_ID=
