NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clothing_brand?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret
JWT_CUSTOMER_ACCESS_SECRET=change-me-customer-access-secret
JWT_CUSTOMER_REFRESH_SECRET=change-me-customer-refresh-secret
WEB_ORIGIN=http://localhost:3000
# The API's own public origin — embedded directly into category/banner/logo/editor image URLs
# (see uploads/upload.service.ts's processSiteImage). In production this MUST be the real public
# domain (e.g. https://yourdomain.com), never left unset — see docker/.env.example.
API_ORIGIN=http://localhost:4000
UPLOADS_DIR=uploads

# used only by prisma/seed.ts to create the first admin login
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# optional — enables the AI Admin Assistant (product copy, SEO, marketing/email generation,
# image alt text) in the admin console; the feature stays off with a clear setup hint until set
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# optional — without a key, sendMail() falls back to writing emails to apps/api/.devmail/
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# optional — without an api key, sendSms() logs instead of sending. Sender ID is the approved
# masking/name on the BulkSMSBD account (Settings > Sender ID there), not the API key.
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# optional — without keys, sendPush() logs instead of sending. Generate a pair with
# `npx web-push generate-vapid-keys`
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=support@example.com

# optional — without a client ID, the Google sign-in button never renders. Create one at
# https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application").
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in apps/web/.env
GOOGLE_CLIENT_ID=

# optional — without these, SSLCommerz checkout fails with "could not start the payment session"
# (see apps/api/src/modules/payments/sslcommerz.service.ts). Get store_id/store_passwd from your
# SSLCommerz merchant panel (sandbox or live).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# optional — without these, EPS-PG checkout fails with "could not start the payment session" (see
# apps/api/src/modules/payments/eps.service.ts). Get username/password/hashKey/merchantId/storeId
# from EPS support (info@eps.com.bd, www.eps.com.bd) for sandbox or live credentials. Also flip
# StoreSetting.epsPaymentEnabled on in the admin settings page once these are set, since the
# checkout option stays hidden until then.
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
EPS_MERCHANT_ID=
EPS_STORE_ID=
EPS_SANDBOX=true

# optional — without an api key, "Book with Steadfast" on an order returns a clear "not configured"
# error instead of faking a booking. Get the Api Key/Secret Key from the Steadfast merchant panel
# (steadfast.com.bd -> Settings -> API Support). STEADFAST_WEBHOOK_TOKEN is a secret of your own
# choosing (not issued by Steadfast) — paste it into the Notify URL you set in their panel as
# https://<your-api-domain>/api/courier/steadfast/webhook?token=<the-same-value>
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_WEBHOOK_TOKEN=
