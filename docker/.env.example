JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_CUSTOMER_ACCESS_SECRET=replace-with-a-long-random-string
JWT_CUSTOMER_REFRESH_SECRET=replace-with-a-different-long-random-string
WEB_ORIGIN=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Same public domain as above — used server-side to build absolute URLs for uploaded
# category/banner/logo/editor images. Must NOT be left unset in production: it silently defaults
# to http://localhost:4000, which only resolves on the server itself, not in visitors' browsers.
API_ORIGIN=https://yourdomain.com

# required — Postgres/Redis are not published to the host or internet, but the containers
# still authenticate to each other with these. Use long random values, never the defaults.
POSTGRES_PASSWORD=replace-with-a-long-random-string
REDIS_PASSWORD=replace-with-a-different-long-random-string

# optional — AI Admin Assistant (product copy, SEO, marketing/email generation, image alt text)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# optional — Microsoft Clarity heatmaps/session recordings
NEXT_PUBLIC_CLARITY_ID=

# optional — Tawk.to live chat widget (property id / widget id from your Tawk.to dashboard)
NEXT_PUBLIC_TAWKTO_PROPERTY_ID=
NEXT_PUBLIC_TAWKTO_WIDGET_ID=

# optional — without it, the Google sign-in button never renders. Create a client ID at
# https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application").
# Both must be the SAME value — GOOGLE_CLIENT_ID is a public client ID, not a secret.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
