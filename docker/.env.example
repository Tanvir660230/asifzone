# Phase 12: this file is the per-store configuration template. One docker/.env per store; the same Git commit serves
# every store (docs/STORE_DEPLOYMENT.md). Store identity (name, logo, legal name, address…) is NOT here — it is entered
# in the admin (Settings) and stored in that store's own database.

# required — this installation's id: lowercase letters, digits and dashes (e.g. "acme-store"). Namespaces its Redis keys,
# locks, queues and cache tags, so installations may share one Redis server. Never change it on a running store.
INSTALL_ID=yourstore

# required — per store: public host, its aliases (space-separated, e.g. "www.yourdomain.com"), and the Let's Encrypt
# certificate name (the directory under /etc/letsencrypt/live/, normally the host).
SERVER_NAME=yourdomain.com
SERVER_ALIASES=www.yourdomain.com
CERT_NAME=yourdomain.com
# required — this store's own off-server backup destination (rclone remote:folder).
GDRIVE_REMOTE=gdrive:yourstore-backups
# optional — defaults keep the original single-store names; give a second store on the same host its own.
COMPOSE_PROJECT_NAME=docker
POSTGRES_DB=clothing_brand
# optional — a second installation on the same VPS publishes its own host ports and sits behind one front proxy.
#API_HOST_PORT=4000
#WEB_HOST_PORT=3000
#HTTP_PORT=80
#HTTPS_PORT=443
# optional — share one Redis server between installations (INSTALL_ID keeps their keys apart). Default: this stack's own.
#REDIS_URL=redis://:password@shared-redis:6379
# optional — media base (Phase 1B). Default /uploads: same origin, this installation's uploads volume.
#MEDIA_BASE_URL=/uploads

# optional — provider selection (blank = every integration wired, as before; "none" disables one explicitly).
# An explicitly selected provider must have its credentials below, or the API refuses to start in production.
PAYMENT_GATEWAYS=
SMS_PROVIDER=
EMAIL_PROVIDER=
COURIER_PROVIDER=
PUSH_PROVIDER=

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_CUSTOMER_ACCESS_SECRET=replace-with-a-long-random-string
JWT_CUSTOMER_REFRESH_SECRET=replace-with-a-different-long-random-string
WEB_ORIGIN=https://yourdomain.com
# Phase 1A: read by the web service at RUNTIME — the image is built once for every store, never per store.
# (The pre-Phase-1 names NEXT_PUBLIC_SITE_URL / NEXT_PUBLIC_API_URL are still accepted.)
SITE_URL=https://yourdomain.com
PUBLIC_API_URL=https://yourdomain.com
# The API's public origin — payment-gateway callback URLs. Must be the public domain in production.
API_ORIGIN=https://yourdomain.com

# required — Postgres/Redis are not published to the host or internet, but the containers
# still authenticate to each other with these. Use long random values, never the defaults.
POSTGRES_PASSWORD=replace-with-a-long-random-string
REDIS_PASSWORD=replace-with-a-different-long-random-string

# optional — AI Admin Assistant (product copy, SEO, marketing/email generation, image alt text)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# optional — Microsoft Clarity heatmaps/session recordings (runtime; was NEXT_PUBLIC_CLARITY_ID)
CLARITY_ID=

# optional — Meta (Facebook) Pixel id, from Meta Events Manager. Drives the storefront's browser
# events, and the api's server-side Conversions API — one value for both (runtime; was NEXT_PUBLIC_META_PIXEL_ID).
META_PIXEL_ID=
# optional — Conversions API access token (Events Manager -> your pixel -> Settings -> Conversions
# API -> Generate access token). SERVER-ONLY secret: never commit it, never prefix it NEXT_PUBLIC_.
META_ACCESS_TOKEN=
# optional — Graph API version; blank uses the api's built-in default.
META_API_VERSION=
# optional — Events Manager -> Test Events code (e.g. TEST12345). While set, every server event goes
# to the Test Events tab only, not real reporting. Remove it once testing is done.
META_TEST_EVENT_CODE=

# optional — TikTok Pixel id (TikTok Ads Manager -> Tools -> Events -> Web Events), e.g. DB1ATB3C77U04C8M0SK0. Drives the
# storefront's browser events (apps/web/lib/pixels/tiktok.ts); blank keeps TikTok fully inert. Public, not a secret.
# Read at runtime (was NEXT_PUBLIC_TIKTOK_PIXEL_ID) — change it, then restart; no rebuild.
TIKTOK_PIXEL_ID=

# (Tawk.to live chat is configured per store in Admin → Settings, not here.)

# optional — without it, the Google sign-in button never renders. Create a client ID at
# https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web application").
# One value for the api and the web service — a public client ID, not a secret.
GOOGLE_CLIENT_ID=

# optional — without these, the web push opt-in toggle stays hidden. Generate a pair with
# `npx web-push generate-vapid-keys`. The web service reads the public key at runtime (see docker-compose.yml) — one
# value, not two, so they can't drift. The private key stays in the api service.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=support@yourdomain.com

# optional — without these, SSLCommerz checkout fails with "could not start the payment session".
# Get store_id/store_passwd from your SSLCommerz merchant panel (sandbox or live).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# optional — without these, EPS-PG checkout fails with "could not start the payment session". Get
# username/password/hashKey/merchantId/storeId from EPS support (info@eps.com.bd, www.eps.com.bd)
# for sandbox or live credentials. Also flip "Online Payment (EPS-PG)" on in the admin settings
# page once these are set, since the checkout option stays hidden until then.
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
EPS_MERCHANT_ID=
EPS_STORE_ID=
EPS_SANDBOX=true

# optional — without an api key, "Book with Steadfast" on an order returns a clear "not configured"
# error instead of faking a booking. STEADFAST_WEBHOOK_TOKEN is a secret of your own choosing, pasted
# into the Notify URL configured in the Steadfast merchant panel (see apps/api/.env.example).
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_WEBHOOK_TOKEN=
