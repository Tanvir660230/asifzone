# Another installation on this VPS (README.md). __HOST__ = its domain, __ID__ = its INSTALL_ID.
# Mirrors this store's own server blocks in nginx.conf.template, with the upstreams pointed at that installation's
# api/web aliases. The rate-limit zones and the HTML micro-cache are shared (the cache key includes the host).

server {
    listen 80;
    listen [::]:80;
    server_name __HOST__ www.__HOST__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://__HOST__$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.__HOST__;

    ssl_certificate /etc/letsencrypt/live/__HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://__HOST__$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __HOST__;
    client_max_body_size 10m;

    ssl_certificate /etc/letsencrypt/live/__HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    resolver 127.0.0.11 valid=10s;

    location ^~ /uploads/.trash/ {
        return 404;
    }

    # That installation's uploads volume is not mounted here; its api serves /uploads itself.
    location /uploads/ {
        set $api_upstream http://__ID__-api:4000;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=2592000, immutable";
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location ~ ^/api/(auth/login|customers/login|customers/register|customers/otp/) {
        limit_req zone=auth_limit burst=10 nodelay;
        set $api_upstream http://__ID__-api:4000;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=general_limit burst=30 nodelay;
        set $api_upstream http://__ID__-api:4000;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        set $api_upstream http://__ID__-api:4000;
        proxy_pass $api_upstream/health;
    }

    location /_next/static/ {
        set $web_upstream http://__ID__-web:3000;
        proxy_pass $web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /_next/image {
        limit_req zone=image_limit burst=200 nodelay;
        set $web_upstream http://__ID__-web:3000;
        proxy_pass $web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=page_limit burst=150 nodelay;
        set $web_upstream http://__ID__-web:3000;
        proxy_pass $web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        set $skip_cache 0;
        if ($request_method !~ ^(GET|HEAD)$) { set $skip_cache 1; }
        if ($http_cookie ~* "(customer_access_token|access_token)") { set $skip_cache 1; }
        if ($uri ~* "^/(account|admin|cart|checkout)") { set $skip_cache 1; }

        proxy_cache web_cache;
        proxy_cache_key "$scheme$host$request_uri";
        proxy_cache_bypass $skip_cache;
        proxy_no_cache $skip_cache;
        proxy_cache_valid 200 30s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Cache-Status $upstream_cache_status always;

        proxy_hide_header Cache-Control;
        add_header Cache-Control $edge_cache_control always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
