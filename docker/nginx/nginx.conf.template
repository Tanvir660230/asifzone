# Phase 12 (W10): rendered at container start by the nginx image's envsubst step
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) into /etc/nginx/conf.d/default.conf.
# Only ${SERVER_NAME}, ${SERVER_ALIASES} and ${CERT_NAME} are substituted (NGINX_ENVSUBST_FILTER in
# docker-compose.yml) — nginx's own $variables are left alone. Per-store values live in docker/.env.
# Micro-cache for anonymous storefront HTML: every storefront page renders identical markup for
# all visitors (cart/auth state is hydrated client-side from localStorage/cookies, never embedded
# server-side — see apps/web/components/storefront/cart-icon.tsx). A short TTL here means most
# traffic to a hot product/category page is served from nginx instead of hitting Next.js + the API
# on every request, without risking stale or user-specific content.
# Behind Cloudflare's proxy every request arrives from a Cloudflare edge IP, so without this the
# per-IP limit_req zones below would lump unrelated shoppers together (and 429 them), and the api
# would log/rate-limit/fraud-check by Cloudflare's address instead of the customer's. Only requests
# that actually come from Cloudflare's published ranges (https://www.cloudflare.com/ips/) are
# trusted to set CF-Connecting-IP; direct hits keep their real socket address. Harmless while the
# DNS record is still "DNS only".
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

proxy_cache_path /var/cache/nginx/web levels=1:2 keys_zone=web_cache:10m max_size=200m inactive=60m use_temp_path=off;

map $skip_cache $edge_cache_control {
    0 "public, max-age=0, s-maxage=30, stale-while-revalidate=300";
    1 "private, no-store";
}

# Defense in depth alongside the app-level rate limiters (apps/api/src/middlewares/rate-limit.ts):
# these blunt pure volumetric floods (e.g. thousands of conns/sec) before they even reach
# Next.js/Express, and stay generous enough not to false-positive genuine shared-IP traffic
# (office/mobile-carrier NAT).
#
# Pages and images get their own, much larger zones: a single storefront page view is not one
# request. Next.js prefetches every product/category link in view (one `?_rsc=` request each) and
# the browser pulls every product thumbnail through /_next/image — a homepage visit alone is 30-60
# requests within a second. Sharing the API's 15r/s + burst 30 bucket with that rejected real
# shoppers' prefetches and thumbnails (seen in production as broken images and slow navigation).
#
# The web container's server-side renders call the API through this same public origin
# (NEXT_PUBLIC_API_URL), so every SSR fetch arrives from the Docker bridge gateway — one "client"
# for all shoppers combined. A burst of page renders (a crawler, a traffic spike) then 429'd the
# product rails (seen in production). Private Docker-range sources are therefore exempt from the
# volumetric zones (an empty key is not counted); internet clients never arrive from 172.16.0.0/12
# — they keep their real address (or Cloudflare's CF-Connecting-IP, whose 172.64.0.0/13 lies
# outside it). The auth zone stays keyed on every address.
geo $internal_source {
    default        0;
    127.0.0.0/8    1;
    172.16.0.0/12  1;
}
map $internal_source $volumetric_limit_key {
    0 $binary_remote_addr;
    1 "";
}
limit_req_zone $volumetric_limit_key zone=general_limit:10m rate=15r/s;
limit_req_zone $volumetric_limit_key zone=page_limit:10m rate=40r/s;
limit_req_zone $volumetric_limit_key zone=image_limit:10m rate=60r/s;
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=3r/s;
# 429 instead of nginx's default 503, so a rate-limited request is distinguishable from a real
# outage in browser devtools and logs.
limit_req_status 429;

# Plain HTTP: only the ACME renewal challenge is served here; everything else redirects to https.
server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME} ${SERVER_ALIASES};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${SERVER_NAME}$request_uri;
    }
}

# www -> bare domain, both over https.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${SERVER_ALIASES};

    ssl_certificate /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://${SERVER_NAME}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${SERVER_NAME};
    client_max_body_size 10m;

    ssl_certificate /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # Docker's embedded DNS. A bare `proxy_pass http://api:4000` resolves "api" ONCE, when nginx
    # starts, and caches that IP forever — so the next `docker compose up -d --build` (every
    # deploy) recreates the api/web containers with new internal IPs and nginx keeps proxying to
    # the now-dead old ones (502s) until something restarts it. Routing proxy_pass through a `set`
    # variable forces nginx to re-resolve via this resolver on every request instead.
    resolver 127.0.0.11 valid=10s;

    # Unused uploads waiting out their restore window (apps/api/src/modules/storage) — never public.
    location ^~ /uploads/.trash/ {
        return 404;
    }

    location /uploads/ {
        alias /uploads/;
        add_header Cache-Control "public, max-age=2592000, immutable";
        # add_header in a location block replaces (not merges with) the server-level ones above,
        # so the security headers must be repeated here to still apply.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Stricter limit on the endpoints most worth slowing down for a flooding/credential-stuffing
    # client — checked before the general /api/ location below since nginx prefers a matching
    # regex location over a plain prefix location.
    location ~ ^/api/(auth/login|customers/login|customers/register|customers/otp/) {
        limit_req zone=auth_limit burst=10 nodelay;
        set $api_upstream http://api:4000;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=general_limit burst=30 nodelay;
        set $api_upstream http://api:4000;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health {
        set $api_upstream http://api:4000;
        proxy_pass $api_upstream/health;
    }

    # Next's hashed build assets already carry a far-future immutable Cache-Control from the
    # `web` upstream — pass it straight through rather than letting the micro-cache logic in
    # location / below override it with our much shorter HTML TTL.
    location /_next/static/ {
        set $web_upstream http://web:3000;
        proxy_pass $web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Next's image optimizer — its own zone (see the limit_req_zone comment above), and outside
    # location / so its own long Cache-Control reaches the browser instead of being replaced by the
    # HTML micro-cache's max-age=0, which made every thumbnail re-download on every page view.
    location /_next/image {
        limit_req zone=image_limit burst=200 nodelay;
        set $web_upstream http://web:3000;
        proxy_pass $web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=page_limit burst=150 nodelay;
        set $web_upstream http://web:3000;
        proxy_pass $web_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Never cache/mark-cacheable a request carrying a session cookie, a non-GET method, or a
        # session-aware section (account/admin/cart/checkout) — see comment above the cache zone.
        set $skip_cache 0;
        if ($request_method !~ ^(GET|HEAD)$) { set $skip_cache 1; }
        if ($http_cookie ~* "(customer_access_token|access_token)") { set $skip_cache 1; }
        if ($uri ~* "^/(account|admin|cart|checkout)") { set $skip_cache 1; }

        proxy_cache web_cache;
        proxy_cache_key "$scheme$host$request_uri";
        proxy_cache_bypass $skip_cache;
        proxy_no_cache $skip_cache;
        proxy_cache_valid 200 30s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header X-Cache-Status $upstream_cache_status always;

        proxy_hide_header Cache-Control;
        add_header Cache-Control $edge_cache_control always;
        # add_header in a location block replaces (not merges with) the server-level ones above,
        # so the security headers must be repeated here to still apply.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
